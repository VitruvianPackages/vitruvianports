Description: Qt 6.9 and later declare QPlatformFontDatabase::fallbacksForFamily() with QFontDatabasePrivate::ExtendedScript instead of QChar::Script; match it under a version check so Qt 6.8 still compiles.
Author: Numerio <b.vitruvio@gmail.com>
Origin: vendor
Forwarded: not-needed
---
--- a/src/platform/qhaikuplatformfontdatabase.h
+++ b/src/platform/qhaikuplatformfontdatabase.h
@@ -64,7 +64,12 @@
+#if QT_VERSION >= QT_VERSION_CHECK(6, 9, 0)
+	using ScriptArg = QFontDatabasePrivate::ExtendedScript;
+#else
+	using ScriptArg = QChar::Script;
+#endif
 	QStringList fallbacksForFamily(const QString &family,
 									QFont::Style style,
 									QFont::StyleHint styleHint,
-									QChar::Script script) const override;
+									ScriptArg script) const override;
 	QFontEngine *fontEngine(const QFontDef &fontDef, void *handle) override;
 	void releaseHandle(void *handle) override;
 private:
--- a/src/platform/qhaikuplatformfontdatabase.cpp
+++ b/src/platform/qhaikuplatformfontdatabase.cpp
@@ -133,7 +133,7 @@
 QStringList	QHaikuPlatformFontDatabase::fallbacksForFamily(const QString &family,
 															QFont::Style style,
 															QFont::StyleHint styleHint,
-															QChar::Script script) const
+															ScriptArg script) const
 {
 	QStringList result;
 	if (styleHint == QFont::Monospace || styleHint	== QFont::Courier) {
