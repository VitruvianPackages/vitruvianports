Description: V\OS video backend for SDL3 on BSurface, with an EGL pbuffer OpenGL path.
Author: Numerio <b.vitruvio@gmail.com>
Forwarded: not-needed
---
diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -3000,6 +3000,37 @@
 
 # Platform-independent options
 
+# V\OS video backend, built when the V\OS headers are installed.
+option(SDL_VOS "Build the V\\OS video backend when its headers are found" ON)
+if(SDL_VIDEO AND SDL_VOS AND UNIX AND NOT APPLE AND NOT ANDROID)
+  find_path(VOS_SURFACE_DIR Surface.h
+            PATHS /system/develop/headers/private/interface
+            NO_DEFAULT_PATH)
+  find_package(PkgConfig QUIET)
+  if(VOS_SURFACE_DIR AND PKG_CONFIG_FOUND)
+    pkg_check_modules(VOS_PC vos)
+  endif()
+  if(VOS_SURFACE_DIR AND VOS_PC_FOUND)
+    enable_language(CXX)
+    set(SDL_VIDEO_DRIVER_VOS 1)
+    sdl_glob_sources("${SDL3_SOURCE_DIR}/src/video/vos/*.cc")
+    get_filename_component(VOS_PRIVATE_DIR "${VOS_SURFACE_DIR}" DIRECTORY)
+    set(VOS_CXX_FLAGS)
+    foreach(dir "${VOS_PRIVATE_DIR}" "${VOS_PRIVATE_DIR}/app" "${VOS_PRIVATE_DIR}/interface"
+                "${VOS_PRIVATE_DIR}/shared" "${VOS_PRIVATE_DIR}/system" ${VOS_PC_INCLUDE_DIRS})
+      list(APPEND VOS_CXX_FLAGS "-isystem" "${dir}")
+    endforeach()
+    list(APPEND VOS_CXX_FLAGS "-include" "LinuxBuildCompatibility.h")
+    string(JOIN " " VOS_CXX_FLAGS ${VOS_CXX_FLAGS})
+    sdl_compile_options(PRIVATE NO_EXPORT "$<$<COMPILE_LANGUAGE:CXX>:SHELL:${VOS_CXX_FLAGS}>")
+    sdl_link_dependency(vos LIBS be root)
+    set(HAVE_SDL_VIDEO TRUE)
+    message(STATUS "V\\OS video backend: enabled (${VOS_SURFACE_DIR})")
+  else()
+    message(STATUS "V\\OS video backend: V\\OS headers not found, disabled")
+  endif()
+endif()
+
 if(SDL_VIDEO)
   if(SDL_OFFSCREEN)
     set(SDL_VIDEO_DRIVER_OFFSCREEN 1)
