Description: Build against vos-dev and run on V\OS: include paths from vos.specs, OpenGL behind an opt-in, font directory probing, evdev key codes and PC-style modifiers.
Author: Vladislav Janeček <38503981+schotek@users.noreply.github.com>
Origin: vendor
Forwarded: no
---
diff --git a/platforms/qhaikuplatform/haiku/haiku.pro b/platforms/qhaikuplatform/haiku/haiku.pro
index cff53bf..aaf5e45 100644
--- a/platforms/qhaikuplatform/haiku/haiku.pro
+++ b/platforms/qhaikuplatform/haiku/haiku.pro
@@ -10,6 +10,19 @@ QT += \
 
 LIBS += -lbe -lroot -ltracker -lgame -lGL -lGLU
 
+exists(/etc/vos.specs) {
+	# Kit headers come from vos.specs and need the Linux build shim.
+	VOS_INCLUDES = $$system(cat /etc/vos.specs)
+	# vos.specs misses a few kit subdirs the plugin needs directly
+	VOS_INCLUDES += -I/system/develop/headers/os/opengl \
+		-I/system/develop/headers/os/game \
+		-I/system/develop/headers/os/locale
+	QMAKE_CFLAGS += $$VOS_INCLUDES -include LinuxBuildCompatibility.h
+	QMAKE_CXXFLAGS += $$VOS_INCLUDES -include LinuxBuildCompatibility.h
+	# BGLView lives in libopengl.so here (libGL is Mesa's)
+	LIBS += -lopengl
+}
+
 CONFIG += link_pkgconfig
 
 PKGCONFIG += freetype2
