Description: adapt entry_ref/node_ref field access to the V\OS accessors
 and make use of statx
 V\OS encapsulates entry_ref and node_ref: the legacy public fields
 device/directory/node became accessor methods (device(), directory(),
 node()) with set_to() to bind values, so poking fields - and taking their
 addresses for BMessage::FindInt32/FindInt64 - no longer compiles. Read the
 message values into locals and bind them with set_to(); message keys and
 semantics are unchanged. The ref name member stays public, so name
 handling is untouched.
Author: VitruvianOS Packagers <packages@vitruvianos.org>
Forwarded: not-needed
Origin: vendor, V\OS packaging

diff --git a/src/FSUtils.cpp b/src/FSUtils.cpp
index 93e62b1..cf8e84e 100644
--- a/src/FSUtils.cpp
+++ b/src/FSUtils.cpp
@@ -54,14 +54,18 @@ bool FSUtils::CopyFileContents(BFile *srcfile, BFile *dstfile, size_t blksize, B
 
 
 ////////////////////////////////////////////////////////////////////////
-void FSUtils::CopyStats(struct stat *srcstat, BNode *dst)
+void FSUtils::CopyStats(struct statx *srcstat, BNode *dst)
 ////////////////////////////////////////////////////////////////////////
 {
-	dst->SetPermissions(srcstat->st_mode);
-	dst->SetOwner(srcstat->st_uid);
-	dst->SetGroup(srcstat->st_gid);
-	dst->SetModificationTime(srcstat->st_mtime);
-	dst->SetCreationTime(srcstat->st_crtime);
+	dst->SetPermissions(srcstat->stx_mode);
+	dst->SetOwner(srcstat->stx_uid);
+	dst->SetGroup(srcstat->stx_gid);
+	dst->SetModificationTime(srcstat->stx_mtime.tv_sec);
+
+	time_t crtime = (srcstat->stx_mask & STATX_BTIME)
+						? srcstat->stx_btime.tv_sec
+						: srcstat->stx_mtime.tv_sec;
+	dst->SetCreationTime(crtime);
 }
 
