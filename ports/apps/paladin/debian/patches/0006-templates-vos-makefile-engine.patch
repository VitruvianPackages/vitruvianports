--- a/Paladin/Templates/Sample ButtonPress/compile	2026-10-21 00:00:00.000000000 +0000
+++ b/Paladin/Templates/Sample ButtonPress/compile	2026-10-21 00:00:00.000000000 +0000
@@ -1 +1,17 @@
-gcc -o Run *.cpp -lbe
\ No newline at end of file
+#!/bin/sh
+# Build this template with the V\OS makefile-engine.  The engine is the
+# compiler driver on V\OS: it picks up the system flag set from
+# /etc/vos.specs and links libroot, which the old raw gcc line did not.
+set -e
+cat > Makefile <<'MAKE'
+## V\OS makefile-engine project (generated by this compile script)
+NAME = ButtonPress
+TARGET_DIR = .
+TYPE = APP
+SRCS = App.cpp MainWindow.cpp
+LIBS = be root
+
+DEVEL_DIRECTORY := /
+include $(DEVEL_DIRECTORY)/etc/makefile-engine
+MAKE
+make MIMESET=true
