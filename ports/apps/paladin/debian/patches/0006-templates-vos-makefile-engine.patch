+#!/bin/sh
+# Build this template with the V\OS makefile-engine.  The engine is the
+# compiler driver on V\OS: it picks up the system flag set from
+# /etc/vos.specs.  Screen saver add-ons are shared objects; the engine's
+# SHARED type supplies -shared and the soname the old command line set by
+# hand, and the legacy screensaver link library does not exist here (the
+# saver API resolves when the add-on is loaded).
+set -e
+cat > Makefile <<'MAKE'
+## V\OS makefile-engine project (generated by this compile script)
+NAME = AwesomeSaver
+TARGET_DIR = .
+TYPE = SHARED
+SRCS = AwesomeSaver.cpp
+LIBS = be root
+
+DEVEL_DIRECTORY := /
+include $(DEVEL_DIRECTORY)/etc/makefile-engine
+MAKE
+make MIMESET=true
