+#!/bin/sh
+# Build this template with the V\OS makefile-engine.  The engine is the
+# compiler driver on V\OS: it picks up the system flag set from
+# /etc/vos.specs, links libroot and embeds the prebuilt resources, which
+# the old raw gcc + xres line did not do for us.
+set -e
+cat > Makefile <<'MAKE'
+## V\OS makefile-engine project (generated by this compile script)
+NAME = HaikuFortune
+TARGET_DIR = .
+TYPE = APP
+SRCS = App.cpp FortuneFunctions.cpp MainWindow.cpp
+RSRCS = HaikuFortune.rsrc
+LIBS = be root translation
+
+DEVEL_DIRECTORY := /
+include $(DEVEL_DIRECTORY)/etc/makefile-engine
+MAKE
+make MIMESET=true
