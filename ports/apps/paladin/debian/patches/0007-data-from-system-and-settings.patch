+// Editable templates live in the user's settings, seeded from the system data.
+DPath
+UserTemplatesPath(void)
+{
+	DPath path(B_USER_SETTINGS_DIRECTORY);
+	path << "Paladin/Templates";
+
+	BDirectory dir(path.GetFullPath());
+	if (dir.InitCheck() != B_OK || dir.CountEntries() == 0) {
+		create_directory(path.GetFullPath(), 0755);
+		BDirectory system("/system/data/Paladin/Templates");
+		if (system.InitCheck() == B_OK) {
+			ShellHelper shell("cp -r --no-preserve=mode,ownership ");
+			shell << "'/system/data/Paladin/Templates'/.";
+			shell.AddQuotedArg(path.GetFullPath());
+			shell.Run();
+		}
+	}
+	return path;
+}
+
