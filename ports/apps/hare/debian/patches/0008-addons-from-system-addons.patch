Description: look for the encoder add-ons in the system add-ons folder
 Use /system/add-ons/Hare when present, otherwise the add-ons folder
 next to the application.
Author: Numerio <b.vitruvio@gmail.com>
Forwarded: not-needed

diff --git a/src/Hare/Settings.cpp b/src/Hare/Settings.cpp
index 0b62521..e1e78b3 100644
--- a/src/Hare/Settings.cpp
+++ b/src/Hare/Settings.cpp
@@ -9,6 +9,7 @@
 #include <Application.h>
 #include <Debug.h>
 #include <Directory.h>
+#include <Entry.h>
 #include <File.h>
 #include <FindDirectory.h>
 #include <Message.h>
@@ -26,6 +27,27 @@ Settings* settings = 0;
 #define DEFAULT_ENCODER "BeEncoder"
 #define DEFAULT_PATHPATTERN "/boot/home/Encoded/%t.mp3"
 
+// System add-ons first, then the one next to the application.
+static void
+FindAddonDirectory(char* out)
+{
+	BPath path;
+	if (find_directory(B_SYSTEM_ADDONS_DIRECTORY, &path) == B_OK
+		&& path.Append("Hare") == B_OK && BEntry(path.Path()).Exists()) {
+		strcpy(out, path.Path());
+		return;
+	}
+
+	app_info info;
+	be_app->GetAppInfo(&info);
+
+	path.SetTo(&(info.ref));
+	path.GetParent(&path);
+	path.Append(ADD_ON_DIR);
+	strcpy(out, path.Path());
+}
+
+
 Settings::Settings()
 	:
 	BArchivable()
@@ -37,14 +59,7 @@ Settings::Settings()
 	encoder = NULL;
 	strcpy(encoderName, DEFAULT_ENCODER);
 
-	app_info info;
-	be_app->GetAppInfo(&info);
-
-	BPath path(&(info.ref));
-	path.GetParent(&path);
-	path.Append(ADD_ON_DIR);
-
-	strcpy(addonDirectory, path.Path());
+	FindAddonDirectory(addonDirectory);
 
 	settings = this;
 }
@@ -96,14 +111,7 @@ Settings::Settings(BMessage* archive)
 		strcpy(pathPattern, tmp.String());
 	}
 
-	app_info info;
-	be_app->GetAppInfo(&info);
-
-	BPath path(&(info.ref));
-	path.GetParent(&path);
-	path.Append(ADD_ON_DIR);
-
-	strcpy(addonDirectory, path.Path());
+	FindAddonDirectory(addonDirectory);
 
 	settings = this;
 }
