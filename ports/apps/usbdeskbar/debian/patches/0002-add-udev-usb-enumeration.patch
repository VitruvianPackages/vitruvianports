+/*
+ * Copyright 2026, Dario Casalinuovo. All rights reserved.
+ */
+#include "USBKit.h"
+
+#include <Errors.h>
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <libudev.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/select.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+
+static bool
+read_sysfs_file(const char* path, BString& output)
+{
+	int fd = open(path, O_RDONLY);
+	if (fd < 0)
+		return false;
+
+	char buffer[256];
+	ssize_t bytes = read(fd, buffer, sizeof(buffer) - 1);
+	close(fd);
+	if (bytes <= 0)
+		return false;
+
+	buffer[bytes] = '\0';
+	output.SetTo(buffer);
+	output.Trim();
+	return true;
+}
+
+
+static uint16
+read_sysfs_hex(const char* path)
+{
+	BString value;
+	if (!read_sysfs_file(path, value))
+		return 0;
+
+	return (uint16)strtoul(value.String(), NULL, 16);
+}
+
+
+static uint16
+read_sysfs_dec(const char* path)
+{
+	BString value;
+	if (!read_sysfs_file(path, value))
+		return 0;
+
+	return (uint16)strtoul(value.String(), NULL, 10);
+}
+
+
+BUSBEndpoint::BUSBEndpoint(const char* devicePath, const char* interfaceName,
+	const char* name)
+	:
+	fMaxPacketSize(0),
+	fInterval(0),
+	fType(0),
+	fInput(false)
+{
+	BString path(devicePath);
+	path << "/" << interfaceName << "/" << name << "/";
+
+	BString attribute(path);
+	attribute << "type";
+	BString value;
+	if (read_sysfs_file(attribute.String(), value)) {
+		if (strncmp(value.String(), "Iso", 3) == 0)
+			fType = 1;
+		else if (strncmp(value.String(), "Bul", 3) == 0)
+			fType = 2;
+		else if (strncmp(value.String(), "Int", 3) == 0)
+			fType = 3;
+	}
+
+	attribute = path;
+	attribute << "wMaxPacketSize";
+	fMaxPacketSize = read_sysfs_hex(attribute.String());
+
+	attribute = path;
+	attribute << "bInterval";
+	fInterval = (uint8)read_sysfs_dec(attribute.String());
+
+	attribute = path;
+	attribute << "direction";
+	if (read_sysfs_file(attribute.String(), value))
+		fInput = value == "in";
+}
+
+
+BUSBEndpoint::~BUSBEndpoint()
+{
+}
+
+
+BUSBInterface::BUSBInterface(const char* devicePath, const char* name)
+	:
+	fClass(0),
+	fSubclass(0),
+	fProtocol(0)
+{
+	BString path(devicePath);
+	path << "/" << name;
+
+	BString attribute(path);
+	attribute << "/bInterfaceClass";
+	fClass = (uint8)read_sysfs_dec(attribute.String());
+
+	attribute = path;
+	attribute << "/bInterfaceSubClass";
+	fSubclass = (uint8)read_sysfs_dec(attribute.String());
+
+	attribute = path;
+	attribute << "/bInterfaceProtocol";
+	fProtocol = (uint8)read_sysfs_dec(attribute.String());
+
+	DIR* directory = opendir(path.String());
+	if (directory == NULL)
+		return;
+
+	struct dirent* entry;
+	while ((entry = readdir(directory)) != NULL) {
+		if (strncmp(entry->d_name, "ep_", 3) != 0)
+			continue;
+
+		fEndpoints.AddItem(new BUSBEndpoint(devicePath, name, entry->d_name));
+	}
+	closedir(directory);
+}
+
+
+BUSBInterface::~BUSBInterface()
+{
+	for (int32 i = 0; i < fEndpoints.CountItems(); i++)
+		delete (BUSBEndpoint*)fEndpoints.ItemAt(i);
+	fEndpoints.MakeEmpty();
+}
+
+
+const BUSBEndpoint*
+BUSBInterface::EndpointAt(uint32 index) const
+{
+	return (const BUSBEndpoint*)fEndpoints.ItemAt((int32)index);
+}
+
+
+status_t
+BUSBInterface::OtherDescriptorAt(uint32 /*index*/,
+	usb_descriptor* /*descriptor*/, uint32 /*size*/) const
+{
+	// Class-specific descriptors are not exported by the device filesystem;
+	// the info window simply lists none.
+	return B_ERROR;
+}
+
+
+BUSBConfiguration::BUSBConfiguration(const char* devicePath)
+{
+	DIR* directory = opendir(devicePath);
+	if (directory == NULL)
+		return;
+
+	// Interface entries are named "<device>:<config>.<interface>".
+	struct dirent* entry;
+	while ((entry = readdir(directory)) != NULL) {
+		if (strchr(entry->d_name, ':') == NULL)
+			continue;
+
+		fInterfaces.AddItem(new BUSBInterface(devicePath, entry->d_name));
+	}
+	closedir(directory);
+}
+
+
+BUSBConfiguration::~BUSBConfiguration()
+{
+	for (int32 i = 0; i < fInterfaces.CountItems(); i++)
+		delete (BUSBInterface*)fInterfaces.ItemAt(i);
+	fInterfaces.MakeEmpty();
+}
+
+
+const BUSBInterface*
+BUSBConfiguration::InterfaceAt(uint32 index) const
+{
+	return (const BUSBInterface*)fInterfaces.ItemAt((int32)index);
+}
+
+
+BUSBDevice::BUSBDevice(const char* syspath)
+	:
+	fClass(0),
+	fSubclass(0),
+	fProtocol(0),
+	fVendorID(0),
+	fProductID(0),
+	fVersion(0),
+	fNumConfigurations(0),
+	fActiveConfiguration(0),
+	fConfiguration(NULL)
+{
+	fPath = syspath;
+
+	const char* base = strrchr(syspath, '/');
+	fName = base != NULL ? base + 1 : syspath;
+
+	BString attribute(fPath);
+	attribute << "/idVendor";
+	fVendorID = read_sysfs_hex(attribute.String());
+
+	attribute = fPath;
+	attribute << "/idProduct";
+	fProductID = read_sysfs_hex(attribute.String());
+
+	attribute = fPath;
+	attribute << "/bcdDevice";
+	fVersion = read_sysfs_hex(attribute.String());
+
+	attribute = fPath;
+	attribute << "/bDeviceClass";
+	fClass = (uint8)read_sysfs_dec(attribute.String());
+
+	attribute = fPath;
+	attribute << "/bDeviceSubClass";
+	fSubclass = (uint8)read_sysfs_dec(attribute.String());
+
+	attribute = fPath;
+	attribute << "/bDeviceProtocol";
+	fProtocol = (uint8)read_sysfs_dec(attribute.String());
+
+	attribute = fPath;
+	attribute << "/bNumConfigurations";
+	fNumConfigurations = read_sysfs_dec(attribute.String());
+
+	attribute = fPath;
+	attribute << "/bConfigurationValue";
+	fActiveConfiguration = read_sysfs_dec(attribute.String());
+
+	attribute = fPath;
+	attribute << "/manufacturer";
+	read_sysfs_file(attribute.String(), fManufacturer);
+
+	attribute = fPath;
+	attribute << "/product";
+	read_sysfs_file(attribute.String(), fProduct);
+
+	attribute = fPath;
+	attribute << "/serial";
+	read_sysfs_file(attribute.String(), fSerial);
+}
+
+
+BUSBDevice::~BUSBDevice()
+{
+	delete fConfiguration;
+}
+
+
+const BUSBConfiguration*
+BUSBDevice::ConfigurationAt(uint32 index)
+{
+	if (fNumConfigurations == 0)
+		return NULL;
+	if (index + 1 != fActiveConfiguration)
+		return NULL;
+
+	if (fConfiguration == NULL)
+		fConfiguration = new BUSBConfiguration(fPath.String());
+
+	return fConfiguration;
+}
+
+
+BUSBRoster::BUSBRoster()
+	:
+	fRunning(false),
+	fThread(-1),
+	fUdev(NULL),
+	fMonitor(NULL),
+	fMonitorFd(-1)
+{
+	fWakePipe[0] = -1;
+	fWakePipe[1] = -1;
+}
+
+
+BUSBRoster::~BUSBRoster()
+{
+	Stop();
+
+	for (int32 i = 0; i < fDevices.CountItems(); i++)
+		delete (BUSBDevice*)fDevices.ItemAt(i);
+	fDevices.MakeEmpty();
+
+	for (int32 i = 0; i < fNames.CountItems(); i++)
+		free(fNames.ItemAt(i));
+	fNames.MakeEmpty();
+}
+
+
+status_t
+BUSBRoster::Start()
+{
+	if (fRunning)
+		return B_OK;
+
+	fUdev = udev_new();
+	if (fUdev == NULL)
+		return B_NO_MEMORY;
+
+	fMonitor = udev_monitor_new_from_netlink(fUdev, "udev");
+	if (fMonitor == NULL)
+		fMonitor = udev_monitor_new_from_netlink(fUdev, "kernel");
+
+	if (fMonitor != NULL) {
+		udev_monitor_filter_add_match_subsystem_devtype(fMonitor, "usb", NULL);
+		udev_monitor_enable_receiving(fMonitor);
+		fMonitorFd = udev_monitor_get_fd(fMonitor);
+	}
+
+	fWakePipe[0] = -1;
+	fWakePipe[1] = -1;
+	if (pipe(fWakePipe) != 0) {
+		int32 error = errno;
+		Stop();
+		return error;
+	}
+
+	fRunning = true;
+	fThread = spawn_thread(&BUSBRoster::_MonitorThread, "usb roster",
+		B_NORMAL_PRIORITY, this);
+	if (fThread < 0) {
+		int32 error = fThread;
+		fRunning = false;
+		Stop();
+		return error;
+	}
+
+	resume_thread(fThread);
+	return B_OK;
+}
+
+
+void
+BUSBRoster::Stop()
+{
+	if (!fRunning) {
+		if (fUdev != NULL) {
+			if (fMonitor != NULL)
+				udev_monitor_unref(fMonitor);
+			fMonitor = NULL;
+			fMonitorFd = -1;
+			udev_unref(fUdev);
+			fUdev = NULL;
+		}
+		return;
+	}
+
+	fRunning = false;
+
+	if (fWakePipe[1] >= 0) {
+		char byte = 0;
+		ssize_t written = write(fWakePipe[1], &byte, 1);
+		(void)written;
+	}
+
+	if (fThread >= 0) {
+		int32 result;
+		wait_for_thread(fThread, &result);
+		fThread = -1;
+	}
+
+	for (int32 i = 0; i < 2; i++) {
+		if (fWakePipe[i] >= 0) {
+			close(fWakePipe[i]);
+			fWakePipe[i] = -1;
+		}
+	}
+
+	if (fMonitor != NULL)
+		udev_monitor_unref(fMonitor);
+	fMonitor = NULL;
+	fMonitorFd = -1;
+
+	if (fUdev != NULL)
+		udev_unref(fUdev);
+	fUdev = NULL;
+}
+
+
+status_t
+BUSBRoster::DeviceAdded(BUSBDevice* /*device*/)
+{
+	return B_OK;
+}
+
+
+void
+BUSBRoster::DeviceRemoved(BUSBDevice* /*device*/)
+{
+}
+
+
+int32
+BUSBRoster::_MonitorThread(void* data)
+{
+	BUSBRoster* roster = (BUSBRoster*)data;
+	roster->_ScanDevices();
+
+	while (roster->fRunning) {
+		fd_set set;
+		FD_ZERO(&set);
+		FD_SET(roster->fWakePipe[0], &set);
+		int maxFd = roster->fWakePipe[0];
+
+		if (roster->fMonitorFd >= 0) {
+			FD_SET(roster->fMonitorFd, &set);
+			if (roster->fMonitorFd > maxFd)
+				maxFd = roster->fMonitorFd;
+		}
+
+		struct timeval timeout;
+		timeout.tv_sec = 1;
+		timeout.tv_usec = 0;
+
+		int ready = select(maxFd + 1, &set, NULL, NULL, &timeout);
+		if (ready < 0) {
+			if (errno == EINTR)
+				continue;
+			break;
+		}
+		if (ready == 0)
+			continue;
+
+		if (FD_ISSET(roster->fWakePipe[0], &set))
+			break;
+
+		if (roster->fMonitorFd >= 0
+			&& FD_ISSET(roster->fMonitorFd, &set)) {
+			struct udev_device* device
+				= udev_monitor_receive_device(roster->fMonitor);
+			if (device != NULL) {
+				const char* action = udev_device_get_action(device);
+				roster->_HandleEvent(device, action != NULL ? action : "");
+				udev_device_unref(device);
+			}
+		}
+	}
+
+	return 0;
+}
+
+
+void
+BUSBRoster::_ScanDevices()
+{
+	struct udev_enumerate* enumerate = udev_enumerate_new(fUdev);
+	if (enumerate == NULL)
+		return;
+
+	udev_enumerate_add_match_subsystem(enumerate, "usb");
+	udev_enumerate_scan_devices(enumerate);
+
+	struct udev_list_entry* entry;
+	udev_list_entry_foreach(entry, udev_enumerate_get_list_entry(enumerate)) {
+		struct udev_device* device
+			= udev_device_new_from_syspath(fUdev,
+				udev_list_entry_get_name(entry));
+		if (device != NULL) {
+			_HandleEvent(device, "add");
+			udev_device_unref(device);
+		}
+	}
+
+	udev_enumerate_unref(enumerate);
+}
+
+
+void
+BUSBRoster::_HandleEvent(struct udev_device* device, const char* action)
+{
+	const char* devtype = udev_device_get_devtype(device);
+	if (devtype == NULL || strcmp(devtype, "usb_device") != 0)
+		return;
+
+	const char* name = udev_device_get_sysname(device);
+	if (name == NULL)
+		return;
+
+	if (strcmp(action, "remove") == 0) {
+		// Only devices this roster reported can be removed; fNames is the
+		// list of live names.
+		if (!_RemoveName(name))
+			return;
+
+		// The newest entry wins: a re-plug leaves the older, retired
+		// object in fDevices as well.
+		BUSBDevice* found = NULL;
+		for (int32 i = fDevices.CountItems() - 1; i >= 0; i--) {
+			BUSBDevice* candidate = (BUSBDevice*)fDevices.ItemAt(i);
+			if (strcmp(candidate->Name(), name) == 0) {
+				found = candidate;
+				break;
+			}
+		}
+
+		if (found != NULL)
+			DeviceRemoved(found);
+		return;
+	}
+
+	if (strcmp(action, "add") != 0)
+		return;
+	if (_IsKnown(name))
+		return;
+
+	const char* syspath = udev_device_get_syspath(device);
+	if (syspath == NULL)
+		return;
+
+	BUSBDevice* added = new BUSBDevice(syspath);
+	fNames.AddItem(strdup(name));
+	fDevices.AddItem(added);
+	DeviceAdded(added);
+}
+
+
+bool
+BUSBRoster::_IsKnown(const char* name) const
+{
+	for (int32 i = 0; i < fNames.CountItems(); i++) {
+		if (strcmp((const char*)fNames.ItemAt(i), name) == 0)
+			return true;
+	}
+
+	return false;
+}
+
+
+bool
+BUSBRoster::_RemoveName(const char* name)
+{
+	for (int32 i = 0; i < fNames.CountItems(); i++) {
+		char* known = (char*)fNames.ItemAt(i);
+		if (strcmp(known, name) != 0)
+			continue;
+
+		free(known);
+		fNames.RemoveItem(i);
+		return true;
+	}
+
+	return false;
+}
