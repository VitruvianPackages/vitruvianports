+ */
+#ifndef _USB_KIT_H_
+#define _USB_KIT_H_
+
+
+#include <List.h>
+#include <OS.h>
+#include <String.h>
+#include <SupportDefs.h>
+
+
+struct udev;
+struct udev_monitor;
+
+
+// Raw descriptor as the info window expects it: a length byte followed by
+// the descriptor bytes. The device filesystem does not expose class-specific
+// descriptors, so this is only ever filled by OtherDescriptorAt(), which
+// reports them as unavailable.
+struct usb_descriptor {
+	struct {
+		uint8	length;
+		uint8	data[255];
+	} generic;
+};
+
+
+class BUSBEndpoint {
+public:
+						BUSBEndpoint(const char* devicePath,
+							const char* interfaceName, const char* name);
+						~BUSBEndpoint();
+
+			uint16		MaxPacketSize() const { return fMaxPacketSize; }
+			uint8		Interval() const { return fInterval; }
+
+			bool		IsBulk() const { return fType == 2; }
+			bool		IsIsochronous() const { return fType == 1; }
+			bool		IsInterrupt() const { return fType == 3; }
+			bool		IsInput() const { return fInput; }
+
+private:
+			uint16		fMaxPacketSize;
+			uint8		fInterval;
+			uint8		fType;	// 0 control, 1 isochronous, 2 bulk, 3 interrupt
+			bool		fInput;
+};
+
+
+class BUSBInterface {
+public:
+						BUSBInterface(const char* devicePath, const char* name);
+						~BUSBInterface();
+
+			uint8		Class() const { return fClass; }
+			uint8		Subclass() const { return fSubclass; }
+			uint8		Protocol() const { return fProtocol; }
+
+			uint32		CountEndpoints() const { return fEndpoints.CountItems(); }
+			const BUSBEndpoint* EndpointAt(uint32 index) const;
+
+			status_t	OtherDescriptorAt(uint32 index, usb_descriptor* descriptor,
+								uint32 size) const;
+
+private:
+			uint8		fClass;
+			uint8		fSubclass;
+			uint8		fProtocol;
+			BList		fEndpoints;	// BUSBEndpoint*, owned
+};
+
+
+class BUSBConfiguration {
+public:
+						BUSBConfiguration(const char* devicePath);
+						~BUSBConfiguration();
+
+			uint32		CountInterfaces() const { return fInterfaces.CountItems(); }
+			const BUSBInterface* InterfaceAt(uint32 index) const;
+
+private:
+			BList		fInterfaces;	// BUSBInterface*, owned
+};
+
+
+class BUSBDevice {
+public:
+	explicit			BUSBDevice(const char* syspath);
+						~BUSBDevice();
+
+			const char*	ProductString() const { return fProduct.String(); }
+			const char*	ManufacturerString() const { return fManufacturer.String(); }
+			const char*	SerialNumberString() const { return fSerial.String(); }
+
+			uint8		Class() const { return fClass; }
+			uint8		Subclass() const { return fSubclass; }
+			uint8		Protocol() const { return fProtocol; }
+			uint16		VendorID() const { return fVendorID; }
+			uint16		ProductID() const { return fProductID; }
+			uint16		Version() const { return fVersion; }
+
+			bool		IsHub() const { return fClass == 9; }
+
+			// sysfs name of the device entry, used for roster bookkeeping
+			const char*	Name() const { return fName.String(); }
+
+			uint32		CountConfigurations() const { return fNumConfigurations; }
+			// Reduced: only the active configuration is exposed, the device
+			// filesystem keeps descriptors for that one alone.
+			const BUSBConfiguration* ConfigurationAt(uint32 index);
+
+private:
+			BString		fName;			// sysfs entry name, e.g. "1-9"
+			BString		fPath;			// absolute sysfs path
+			BString		fProduct;
+			BString		fManufacturer;
+			BString		fSerial;
+			uint8		fClass;
+			uint8		fSubclass;
+			uint8		fProtocol;
+			uint16		fVendorID;
+			uint16		fProductID;
+			uint16		fVersion;
+			uint16		fNumConfigurations;
+			uint16		fActiveConfiguration;
+			BUSBConfiguration*	fConfiguration;	// lazily built, owned
+};
+
+
+// udev-backed stand-in for the legacy USB roster: enumerates usb_device
+// objects, reports additions and removals, owns every BUSBDevice it hands
+// out and keeps removed devices alive until Stop() so messages already in
+// flight stay valid.
+class BUSBRoster {
+public:
+								BUSBRoster();
+	virtual	~BUSBRoster();
+
+			status_t			Start();
+			void				Stop();
+
+	virtual	status_t			DeviceAdded(BUSBDevice* device);
+	virtual	void				DeviceRemoved(BUSBDevice* device);
+
+private:
+	static	int32				_MonitorThread(void* data);
+			void				_ScanDevices();
+			void				_HandleEvent(struct udev_device* device,
+									const char* action);
+			bool				_IsKnown(const char* name) const;
+			bool				_RemoveName(const char* name);
+
+	volatile bool				fRunning;
+			thread_id			fThread;
+			struct udev*		fUdev;
+			struct udev_monitor*	fMonitor;
+			int					fMonitorFd;
+			int					fWakePipe[2];
+			BList				fDevices;	// BUSBDevice*, owned
+			BList				fNames;		// char*, live device names
+};
+
+
+#endif	// _USB_KIT_H_
