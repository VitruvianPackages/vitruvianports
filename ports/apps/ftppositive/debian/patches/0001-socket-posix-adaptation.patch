 #include <sys/socket.h>
 #include <sys/select.h>
 #include <sys/types.h>
@@ -72,7 +80,6 @@
 	
 	struct sockaddr_in addr;
 	memset(&addr, 0, sizeof(struct sockaddr_in));
-	addr.sin_len = sizeof(struct sockaddr_in);
 	addr.sin_family = AF_INET;
 	addr.sin_port = htons(port);
 	
@@ -137,21 +144,24 @@
 
 status_t TFTPClient::SetBlockingMode(bool wouldBlock)
 {
-	int err, block;
-	if (wouldBlock) {
-		block = 0;
-		if (setsockopt(fControlEndpoint, SOL_SOCKET, SO_NONBLOCK, &block, sizeof(block)) < 0) {
-			err = errno;
-			fStrError.SetTo(strerror(err));
-			return err;
-		}
-	} else {
-		block = 1;
-		if (setsockopt(fControlEndpoint, SOL_SOCKET, SO_NONBLOCK, &block, sizeof(block)) < 0) {
-			err = errno;
-			fStrError.SetTo(strerror(err));
-			return err;
-		}
+	int err;
+	// VOS/POSIX has no SO_NONBLOCK setsockopt option; the portable way to
+	// flip a socket between blocking and non-blocking is fcntl(O_NONBLOCK).
+	// wouldBlock = true selects the blocking mode, as before.
+	int fl = fcntl(fControlEndpoint, F_GETFL, 0);
+	if (fl < 0) {
+		err = errno;
+		fStrError.SetTo(strerror(err));
+		return err;
+	}
+	if (wouldBlock)
+		fl &= ~O_NONBLOCK;
+	else
+		fl |= O_NONBLOCK;
+	if (fcntl(fControlEndpoint, F_SETFL, fl) < 0) {
+		err = errno;
+		fStrError.SetTo(strerror(err));
+		return err;
 	}
 	return B_OK;
 }
