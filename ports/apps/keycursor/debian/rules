#!/usr/bin/make -f

# Two subprojects with the same output name; stage each after it builds.

SIG := $(shell sed -n 's/^APP_MIME_SIG *= *//p' preflet/makefile)
LOCALES := $(shell sed -n 's/^LOCALES *= *//p' preflet/makefile)
COMPILER_FLAGS := -Wall -Wno-multichar -Wundef -Wmissing-declarations -Wredundant-decls -Wno-unused -fPIC

include /usr/share/dh-vos/runnable-addon.mk

%:
	dh $@ --with vos

override_dh_auto_configure: runnable-addon-interp

override_dh_auto_clean: runnable-addon-clean
	dh_auto_clean

override_dh_auto_build:
	LINK_LIBS=-lroot $(MAKE) -C preflet -f makefile default \
		DEVEL_DIRECTORY=/ MIMESET=true OBJ_DIR=obj \
		TYPE=SHARED LINKER_FLAGS="$(RUNNABLE_LDFLAGS)" \
		COMPILER_FLAGS="$(COMPILER_FLAGS)" -j$(shell nproc 2>/dev/null || echo 2)
	cp preflet/obj/KeyCursor preflet-app
	LINK_LIBS=-lroot $(MAKE) -C src -f makefile default \
		DEVEL_DIRECTORY=/ MIMESET=true OBJ_DIR=obj \
		COMPILER_FLAGS="$(COMPILER_FLAGS)" -j$(shell nproc 2>/dev/null || echo 2)
	cp src/obj/KeyCursor input-addon

override_dh_auto_test:
	# the tree has no test suite

override_dh_auto_install:
	# settings preflet app
	install -m 0755 -D preflet-app \
		$(CURDIR)/debian/keycursor/system/apps/KeyCursor
	# One image installed as the device, with the filter symlinked to it.
	install -m 0755 -D input-addon \
		$(CURDIR)/debian/keycursor/system/add-ons/input_server/devices/KeyCursorDevice
	install -d $(CURDIR)/debian/keycursor/system/add-ons/input_server/filters
	ln -s ../devices/KeyCursorDevice \
		$(CURDIR)/debian/keycursor/system/add-ons/input_server/filters/KeyCursorFilter
	# one .catalog per LOCALES entry
	install -d $(CURDIR)/debian/keycursor/system/data/locale/catalogs/$(SIG)
	for ck in preflet/locales/*.catkeys; do \
		lang=$${ck##*/}; lang=$${lang%.catkeys}; \
		case " $(LOCALES) " in *" $$lang "*) ;; *) continue ;; esac; \
		linkcatkeys -o $(CURDIR)/debian/keycursor/system/data/locale/catalogs/$(SIG)/$$lang.catalog \
			-s $(SIG) -l $$lang $$ck || exit 1; \
	done
	@echo "keycursor: catkeys files: $$(find . -name '*.catkeys' | wc -l) (preflet: $$(ls preflet/locales/*.catkeys | wc -l), src: $$(ls src/locales/*.catkeys | wc -l)), catalogs built: $$(find $(CURDIR)/debian/keycursor -name '*.catalog' | wc -l)"
