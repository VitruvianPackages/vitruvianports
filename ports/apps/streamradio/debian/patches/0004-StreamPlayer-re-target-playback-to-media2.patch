+status_t
+StreamPlayer::_OpenDecoder()
+{
+	// media2 exposes no decoder for a byte stream: BMediaFile opens an
+	// entry_ref or a BUrl only, and BMediaDecoder is video-only. Without
+	// one there is no PCM format to configure the sound player with.
+	return B_UNSUPPORTED;
+}
