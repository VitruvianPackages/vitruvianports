+ssize_t
+StreamIO::_Append(const char* data, size_t size)
+{
+	size_t done = 0;
+	while (done < size) {
+		fRingLock.Lock();
+		if (fClosed) {
+			fRingLock.Unlock();
+			return done > 0 ? (ssize_t)done : (ssize_t)B_INTERRUPTED;
+		}
+
+		size_t space = kRingSize - fUsed;
+		if (space == 0) {
+			// Backpressure: the consumer is behind, let it catch up.
+			fRingLock.Unlock();
+			acquire_sem(fSpaceSem);
+			continue;
+		}
+
+		size_t bytes = size - done;
+		if (bytes > space)
+			bytes = space;
+
+		size_t first = kRingSize - fWriteOffset;
+		if (first > bytes)
+			first = bytes;
+		memcpy(fRing + fWriteOffset, data + done, first);
+		if (bytes > first)
+			memcpy(fRing, data + done + first, bytes - first);
+
+		fWriteOffset = (fWriteOffset + bytes) % kRingSize;
+		fUsed += bytes;
+		fRingLock.Unlock();
+
+		done += bytes;
+		release_sem(fDataSem);
+	}
+
+	return (ssize_t)done;
+}
+
+
+void
+StreamIO::_SetClosed()
+{
+	fRingLock.Lock();
+	fClosed = true;
+	fRingLock.Unlock();
+
+	if (fDataSem >= 0)
+		release_sem(fDataSem);
+	if (fSpaceSem >= 0)
+		release_sem(fSpaceSem);
+}
