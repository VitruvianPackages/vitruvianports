+++ b/Makefile
@@ -0,0 +1,205 @@
+# Copyright 2026, Dario Casalinuovo. All rights reserved.
+#
+# Top-level generic makefile for the V\OS packaging build: drives the
+# viewer sources and the bundled xpdf-derived engine sources through a
+# single Makefile-Engine invocation (one object dir, one link).
+
+# The name of the binary.
+NAME = BePDF
+
+# The type of binary.
+TYPE = APP
+
+# The MIME signature; the catalogs are keyed on it.
+APP_MIME_SIG = application/x-vnd.mp-xpdf
+
+# Viewer + bundled xpdf-derived sources, merged into one link so no
+# intermediate static archive is needed.
+SRCS = \
+	bepdf/beos/AnnotAppearance.cpp \
+	bepdf/beos/AnnotWriter.cpp \
+	bepdf/beos/Annotation.cpp \
+	bepdf/beos/AnnotationRenderer.cpp \
+	bepdf/beos/AnnotationWindow.cpp \
+	bepdf/beos/AttachmentView.cpp \
+	bepdf/beos/BeFontEncoding.cpp \
+	bepdf/beos/BePDF.cpp \
+	bepdf/beos/BepdfApplication.cpp \
+	bepdf/beos/BitmapPool.cpp \
+	bepdf/beos/CachedPage.cpp \
+	bepdf/beos/DisplayCIDFonts.cpp \
+	bepdf/beos/EntryChangedMonitor.cpp \
+	bepdf/beos/FileInfoWindow.cpp \
+	bepdf/beos/FileSpec.cpp \
+	bepdf/beos/FindTextWindow.cpp \
+	bepdf/beos/History.cpp \
+	bepdf/beos/LayoutUtils.cpp \
+	bepdf/beos/OutlinesWindow.cpp \
+	bepdf/beos/PDFPrint.cpp \
+	bepdf/beos/PDFSearch.cpp \
+	bepdf/beos/PDFView.cpp \
+	bepdf/beos/PDFWindow.cpp \
+	bepdf/beos/PageCache.cpp \
+	bepdf/beos/PageLabels.cpp \
+	bepdf/beos/PageRenderer.cpp \
+	bepdf/beos/PasswordWindow.cpp \
+	bepdf/beos/PreferencesWindow.cpp \
+	bepdf/beos/PrintSettingsWindow.cpp \
+	bepdf/beos/PrintingProgressWindow.cpp \
+	bepdf/beos/SaveThread.cpp \
+	bepdf/beos/Settings.cpp \
+	bepdf/beos/StatusWindow.cpp \
+	bepdf/beos/TextConversion.cpp \
+	bepdf/beos/TraceWindow.cpp \
+	bepdf/beos/TreeParser.cpp \
+	bepdf/beos/utils/EntryMenuItem.cpp \
+	bepdf/beos/utils/ResourceLoader.cpp \
+	bepdf/beos/utils/Thread.cpp \
+	xpdf/beos/BeSplashOutputDev.cc \
+	xpdf/beos/EncodingReader.cc \
+	xpdf/beos/Init.cc \
+	xpdf/beos/GDir.cc \
+	xpdf/fofi/FoFiBase.cc \
+	xpdf/fofi/FoFiEncodings.cc \
+	xpdf/fofi/FoFiIdentifier.cc \
+	xpdf/fofi/FoFiTrueType.cc \
+	xpdf/fofi/FoFiType1.cc \
+	xpdf/fofi/FoFiType1C.cc \
+	xpdf/goo/parseargs.c \
+	xpdf/goo/FixedPoint.cc \
+	xpdf/goo/GHash.cc \
+	xpdf/goo/GList.cc \
+	xpdf/goo/GString.cc \
+	xpdf/goo/gfile.cc \
+	xpdf/goo/gmem.cc \
+	xpdf/goo/gmempp.cc \
+	xpdf/splash/Splash.cc \
+	xpdf/splash/SplashBitmap.cc \
+	xpdf/splash/SplashClip.cc \
+	xpdf/splash/SplashFTFont.cc \
+	xpdf/splash/SplashFTFontEngine.cc \
+	xpdf/splash/SplashFTFontFile.cc \
+	xpdf/splash/SplashFont.cc \
+	xpdf/splash/SplashFontEngine.cc \
+	xpdf/splash/SplashFontFile.cc \
+	xpdf/splash/SplashFontFileID.cc \
+	xpdf/splash/SplashPath.cc \
+	xpdf/splash/SplashPattern.cc \
+	xpdf/splash/SplashScreen.cc \
+	xpdf/splash/SplashState.cc \
+	xpdf/splash/SplashXPath.cc \
+	xpdf/splash/SplashXPathScanner.cc \
+	xpdf/xpdf/AcroForm.cc \
+	xpdf/xpdf/Annot.cc \
+	xpdf/xpdf/Array.cc \
+	xpdf/xpdf/BuiltinFont.cc \
+	xpdf/xpdf/BuiltinFontTables.cc \
+	xpdf/xpdf/CMap.cc \
+	xpdf/xpdf/Catalog.cc \
+	xpdf/xpdf/CharCodeToUnicode.cc \
+	xpdf/xpdf/Decrypt.cc \
+	xpdf/xpdf/Dict.cc \
+	xpdf/xpdf/DisplayState.cc \
+	xpdf/xpdf/Error.cc \
+	xpdf/xpdf/FontEncodingTables.cc \
+	xpdf/xpdf/Form.cc \
+	xpdf/xpdf/Function.cc \
+	xpdf/xpdf/Gfx.cc \
+	xpdf/xpdf/GfxFont.cc \
+	xpdf/xpdf/GfxState.cc \
+	xpdf/xpdf/GlobalParams.cc \
+	xpdf/xpdf/ImageOutputDev.cc \
+	xpdf/xpdf/JArithmeticDecoder.cc \
+	xpdf/xpdf/JBIG2Stream.cc \
+	xpdf/xpdf/JPXStream.cc \
+	xpdf/xpdf/Lexer.cc \
+	xpdf/xpdf/Link.cc \
+	xpdf/xpdf/NameToCharCode.cc \
+	xpdf/xpdf/Object.cc \
+	xpdf/xpdf/OptionalContent.cc \
+	xpdf/xpdf/Outline.cc \
+	xpdf/xpdf/OutputDev.cc \
+	xpdf/xpdf/PDFCore.cc \
+	xpdf/xpdf/PDFDoc.cc \
+	xpdf/xpdf/PDFDocEncoding.cc \
+	xpdf/xpdf/PSOutputDev.cc \
+	xpdf/xpdf/PSTokenizer.cc \
+	xpdf/xpdf/Page.cc \
+	xpdf/xpdf/Parser.cc \
+	xpdf/xpdf/PreScanOutputDev.cc \
+	xpdf/xpdf/SecurityHandler.cc \
+	xpdf/xpdf/SplashOutputDev.cc \
+	xpdf/xpdf/Stream.cc \
+	xpdf/xpdf/TextOutputDev.cc \
+	xpdf/xpdf/TextString.cc \
+	xpdf/xpdf/TileCache.cc \
+	xpdf/xpdf/TileCompositor.cc \
+	xpdf/xpdf/TileMap.cc \
+	xpdf/xpdf/UnicodeMap.cc \
+	xpdf/xpdf/UnicodeTypeTable.cc \
+	xpdf/xpdf/UTF8.cc \
+	xpdf/xpdf/XFAForm.cc \
+	xpdf/xpdf/XRef.cc \
+	xpdf/xpdf/Zoox.cc
+
+# The resource definition files to use.
+RDEFS = bepdf/beos/BePDF.rdef
+
+RSRCS =
+
+# Libraries: the legacy separate columnlistview library is part of
+# libbe here, so it is not listed.
+LIBS = shared be textencoding tracker translation localestub $(STDCPPLIBS)
+
+# Additional library search paths.
+LIBPATHS =
+
+# System include paths, as upstream lists them (the legacy be/
+# prefix and the bundled-name redirects ride on CFLAGS instead).
+SYSTEM_INCLUDE_PATHS = \
+	xpdf \
+	xpdf/beos \
+	xpdf/fofi \
+	xpdf/goo \
+	xpdf/splash \
+	xpdf/xpdf \
+	/system/develop/headers/private/interface 
+
+# Additional local include paths.
+LOCAL_INCLUDE_PATHS =
+
+OPTIMIZE := SOME
+
+LOCALES = ca cs de el en_AU en_GB en es fi fr fur hi id ja pl pt pt_BR ro ru sv th tr uk
+
+DEFINES =
+
+WARNINGS = ALL
+
+SYMBOLS :=
+
+DEBUGGER :=
+
+# voscompat first: the legacy be/ include prefix plus the redirects
+# for bundled header names that the packaged headers also ship. Then
+# the packaged real header root ahead of the redirect wrappers that
+# the spec file's -I ordering would otherwise pick for <os/...> and
+# <private/...> includes.
+CFLAGS = -Ivoscompat -I/system/develop/headers
+
+# The bundled xpdf-derived code uses dynamic exception specifications,
+# so use the C/C++ standard of the V\OS tree default.
+COMPILER_FLAGS = -std=gnu++11 -Wno-write-strings $(shell pkg-config --cflags freetype2)
+
+LINKER_FLAGS = $(shell pkg-config --libs freetype2) -lm
+
+APP_VERSION :=
+
+DRIVER_PATH =
+
+# The packaging build passes DEVEL_DIRECTORY on the command line; only
+# probe for it when that override is absent.
+ifeq ($(DEVEL_DIRECTORY),)
+DEVEL_DIRECTORY := $(shell findpaths -r "makefile_engine" B_FIND_PATH_DEVELOP_DIRECTORY)
+endif
+include $(DEVEL_DIRECTORY)/etc/makefile-engine
