+	{ "bd_double_arrow", B_CURSOR_ID_RESIZE_NORTH_WEST_SOUTH_EAST },
+	{ "none", B_CURSOR_ID_NO_CURSOR },
+	{ "blank", B_CURSOR_ID_NO_CURSOR },
+	{ NULL, B_CURSOR_ID_SYSTEM_DEFAULT }
+};
+
+struct VGlyphCursor {
+	int			glyph;
+	BCursorID	id;
+};
+
+// Core cursor font shapes with a system equivalent; the others are drawn
+// from their bitmaps.
+static const VGlyphCursor kGlyphCursors[] = {
+	{ XC_X_cursor, B_CURSOR_ID_SYSTEM_DEFAULT },	// the root cursor
+	{ XC_arrow, B_CURSOR_ID_SYSTEM_DEFAULT },
+	{ XC_top_left_arrow, B_CURSOR_ID_SYSTEM_DEFAULT },
+	{ XC_left_ptr, B_CURSOR_ID_SYSTEM_DEFAULT },
+	{ XC_right_ptr, B_CURSOR_ID_SYSTEM_DEFAULT },
+	{ XC_center_ptr, B_CURSOR_ID_SYSTEM_DEFAULT },
+	{ XC_xterm, B_CURSOR_ID_I_BEAM },
+	{ XC_hand1, B_CURSOR_ID_FOLLOW_LINK },
+	{ XC_hand2, B_CURSOR_ID_FOLLOW_LINK },
+	{ XC_fleur, B_CURSOR_ID_MOVE },
+	{ XC_crosshair, B_CURSOR_ID_CROSS_HAIR },
+	{ XC_cross, B_CURSOR_ID_CROSS_HAIR },
+	{ XC_cross_reverse, B_CURSOR_ID_CROSS_HAIR },
+	{ XC_tcross, B_CURSOR_ID_CROSS_HAIR },
+	{ XC_watch, B_CURSOR_ID_PROGRESS },
+	{ XC_question_arrow, B_CURSOR_ID_HELP },
+	{ XC_pirate, B_CURSOR_ID_NOT_ALLOWED },
+	{ XC_circle, B_CURSOR_ID_NOT_ALLOWED },
+	{ XC_top_side, B_CURSOR_ID_RESIZE_NORTH },
+	{ XC_bottom_side, B_CURSOR_ID_RESIZE_SOUTH },
+	{ XC_right_side, B_CURSOR_ID_RESIZE_EAST },
+	{ XC_left_side, B_CURSOR_ID_RESIZE_WEST },
+	{ XC_top_right_corner, B_CURSOR_ID_RESIZE_NORTH_EAST },
+	{ XC_top_left_corner, B_CURSOR_ID_RESIZE_NORTH_WEST },
+	{ XC_bottom_right_corner, B_CURSOR_ID_RESIZE_SOUTH_EAST },
+	{ XC_bottom_left_corner, B_CURSOR_ID_RESIZE_SOUTH_WEST },
+	{ XC_sb_v_double_arrow, B_CURSOR_ID_RESIZE_NORTH_SOUTH },
+	{ XC_sb_h_double_arrow, B_CURSOR_ID_RESIZE_EAST_WEST },
+	{ -1, B_CURSOR_ID_SYSTEM_DEFAULT }
+};
+
+
+static uint32
+vHashBytes(uint32 hash, const void* data, size_t length)
+{
+	const uint8* bytes = (const uint8*)data;
+	for (size_t i = 0; i < length; i++)
+		hash = (hash ^ bytes[i]) * 16777619u;
+	return hash;
+}
+
+
+static uint32
+vBitsHash(CursorBitsPtr bits)
+{
+	uint16 metrics[4] = { bits->width, bits->height, bits->xhot, bits->yhot };
+	size_t size = (size_t)BitmapBytePad(bits->width) * bits->height;
+	uint32 hash = 2166136261u;
+	hash = vHashBytes(hash, metrics, sizeof(metrics));
+	if (bits->source != NULL)
+		hash = vHashBytes(hash, bits->source, size);
+	if (bits->mask != NULL)
+		hash = vHashBytes(hash, bits->mask, size);
+	return hash;
+}
+
+
+// Core glyph cursors keep no glyph id; recognise them by the bits the
+// server builds for each shape of its own cursor font.
+static void
+vBuildGlyphTable()
+{
+	sGlyphsBuilt = true;
+
+	XID font = FakeClientID(0);
+	const char* name = "cursor";
+	if (OpenFont(serverClient, font, FontLoadAll | FontOpenSync,
+			(unsigned)strlen(name), name) != Success) {
+		return;
+	}
+
+	for (int i = 0; kGlyphCursors[i].glyph >= 0; i++) {
+		CursorPtr cursor = NULL;
+		int glyph = kGlyphCursors[i].glyph;
+		if (AllocGlyphCursor(font, glyph, font, glyph + 1, 0, 0, 0, ~0, ~0,
+				~0, &cursor, serverClient, (XID)0) != Success
+			|| cursor == NULL) {
+			continue;
+		}
+
+		VGlyphEntry entry = { vBitsHash(cursor->bits), glyph };
+		sGlyphs.push_back(entry);
+		FreeCursor(cursor, (XID)0);
+	}
+}
+
+
+static bool
+vMapGlyph(CursorPtr cursor, BCursorID* id)
+{
+	if (cursor->bits->argb != NULL || cursor->bits->source == NULL)
+		return false;
+
+	if (!sGlyphsBuilt)
+		vBuildGlyphTable();
+
+	uint32 hash = vBitsHash(cursor->bits);
+	for (size_t i = 0; i < sGlyphs.size(); i++) {
+		if (sGlyphs[i].hash != hash)
+			continue;
+		for (int j = 0; kGlyphCursors[j].glyph >= 0; j++) {
+			if (kGlyphCursors[j].glyph == sGlyphs[i].glyph) {
+				*id = kGlyphCursors[j].id;
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+
+// Clients such as Chromium load cursors from the Xcursor theme and send
+// the ARGB image without naming it. Index the theme's images by content
+// so the native cursor can stand in for them.
+struct VThemeImage {
+	uint32		hash;
+	BCursorID	id;
+};
+
+static std::vector<VThemeImage> sThemeImages;
+static bool sThemeBuilt = false;
+
+
+static uint32
+vRead32(const uint8* data)
+{
+	return data[0] | (data[1] << 8) | (data[2] << 16) | ((uint32)data[3] << 24);
+}
+
+
+static uint32
+vArgbHash(const uint8* pixels, uint32 width, uint32 height)
+{
+	uint32 sizes[2] = { width, height };
+	uint32 hash = vHashBytes(2166136261u, sizes, sizeof(sizes));
+	return vHashBytes(hash, pixels, (size_t)width * height * 4);
+}
+
+
+static void
+vIndexThemeFile(const char* path, BCursorID id)
+{
+	FILE* file = fopen(path, "rb");
+	if (file == NULL)
+		return;
+
+	fseek(file, 0, SEEK_END);
+	long size = ftell(file);
+	fseek(file, 0, SEEK_SET);
+	if (size < 16 || size > 8 * 1024 * 1024) {
+		fclose(file);
+		return;
+	}
+	std::vector<uint8> data((size_t)size);
+	bool ok = fread(data.data(), 1, data.size(), file) == data.size();
+	fclose(file);
+	if (!ok || memcmp(data.data(), "Xcur", 4) != 0)
+		return;
+
+	uint32 count = vRead32(&data[12]);
+	for (uint32 i = 0; i < count && 16 + (i + 1) * 12 <= data.size(); i++) {
+		const uint8* entry = &data[16 + i * 12];
+		if (vRead32(entry) != 0xfffd0002)
+			continue;
+		size_t position = vRead32(entry + 8);
+		if (position + 36 > data.size())
+			continue;
+		uint32 width = vRead32(&data[position + 16]);
+		uint32 height = vRead32(&data[position + 20]);
+		if (width == 0 || height == 0 || width > 512 || height > 512
+			|| position + 36 + (size_t)width * height * 4 > data.size())
+			continue;
+		VThemeImage image = { vArgbHash(&data[position + 36], width, height),
+			id };
+		sThemeImages.push_back(image);
+	}
+}
+
+
+static void
+vBuildThemeTable()
+{
+	sThemeBuilt = true;
+	static const char* const kDirs[] = {
+		"/usr/share/icons/Adwaita/cursors", "/usr/share/icons/default/cursors",
+		NULL
+	};
+	for (int d = 0; kDirs[d] != NULL; d++) {
+		for (int i = 0; kNamedCursors[i].name != NULL; i++) {
+			char path[256];
+			snprintf(path, sizeof(path), "%s/%s", kDirs[d],
+				kNamedCursors[i].name);
+			vIndexThemeFile(path, kNamedCursors[i].id);
+		}
+	}
+}
+
+
+static bool
+vMapThemeImage(CursorPtr cursor, BCursorID* id)
+{
+	CursorBitsPtr bits = cursor->bits;
+	if (bits->argb == NULL)
+		return false;
+	if (!sThemeBuilt)
+		vBuildThemeTable();
+
+	uint32 hash = vArgbHash((const uint8*)bits->argb, bits->width,
+		bits->height);
+	for (size_t i = 0; i < sThemeImages.size(); i++) {
+		if (sThemeImages[i].hash == hash) {
+			*id = sThemeImages[i].id;
+			return true;
+		}
+	}
+	return false;
+}
+
+
+static bool
+vMapName(CursorPtr cursor, BCursorID* id)
+{
+	if (cursor->name == None)
+		return false;
+
+	const char* name = NameForAtom(cursor->name);
+	if (name == NULL)
+		return false;
+
+	for (int i = 0; kNamedCursors[i].name != NULL; i++) {
+		if (strcmp(kNamedCursors[i].name, name) == 0) {
+			*id = kNamedCursors[i].id;
+			return true;
+		}
+	}
+	return false;
+}
+
+
+static inline bool
+vBitSet(const unsigned char* row, int x)
+{
+#if BITMAP_BIT_ORDER == LSBFirst
+	return (row[x >> 3] >> (x & 7)) & 1;
+#else
+	return (row[x >> 3] >> (7 - (x & 7))) & 1;
+#endif
+}
+
+
+static BBitmap*
+vCursorBitmap(CursorPtr cursor)
+{
+	CursorBitsPtr bits = cursor->bits;
+	int width = bits->width;
+	int height = bits->height;
+	if (width <= 0 || height <= 0)
+		return NULL;
+
+	BBitmap* bitmap = new(std::nothrow) BBitmap(
+		BRect(0, 0, width - 1, height - 1), B_RGBA32);
+	if (bitmap == NULL || bitmap->InitCheck() != B_OK) {
+		delete bitmap;
+		return NULL;
+	}
+
+	uint8* out = (uint8*)bitmap->Bits();
+	int32 outStride = bitmap->BytesPerRow();
+
+	if (bits->argb != NULL) {
+		// Premultiplied ARGB to straight alpha.
+		for (int y = 0; y < height; y++) {
+			uint8* row = out + y * outStride;
+			for (int x = 0; x < width; x++) {
+				CARD32 pixel = bits->argb[y * width + x];
+				uint32 alpha = pixel >> 24;
+				uint32 red = (pixel >> 16) & 0xff;
+				uint32 green = (pixel >> 8) & 0xff;
+				uint32 blue = pixel & 0xff;
+				if (alpha != 0 && alpha != 255) {
+					red = red * 255 / alpha;
+					green = green * 255 / alpha;
+					blue = blue * 255 / alpha;
+					if (red > 255)
+						red = 255;
+					if (green > 255)
+						green = 255;
+					if (blue > 255)
+						blue = 255;
+				}
+				row[x * 4 + 0] = blue;
+				row[x * 4 + 1] = green;
+				row[x * 4 + 2] = red;
+				row[x * 4 + 3] = alpha;
+			}
+		}
+		return bitmap;
+	}
+
+	int stride = BitmapBytePad(width);
+	uint8 fore[3] = { (uint8)(cursor->foreBlue >> 8),
+		(uint8)(cursor->foreGreen >> 8), (uint8)(cursor->foreRed >> 8) };
+	uint8 back[3] = { (uint8)(cursor->backBlue >> 8),
+		(uint8)(cursor->backGreen >> 8), (uint8)(cursor->backRed >> 8) };
+
+	for (int y = 0; y < height; y++) {
+		uint8* row = out + y * outStride;
+		const unsigned char* source = bits->source + y * stride;
+		const unsigned char* mask = bits->mask + y * stride;
+		for (int x = 0; x < width; x++) {
+			if (!vBitSet(mask, x)) {
+				memset(row + x * 4, 0, 4);
+				continue;
+			}
+			const uint8* color = vBitSet(source, x) ? fore : back;
+			row[x * 4 + 0] = color[0];
+			row[x * 4 + 1] = color[1];
+			row[x * 4 + 2] = color[2];
+			row[x * 4 + 3] = 255;
+		}
+	}
+	return bitmap;
+}
+
+
+static BCursor*
+vCreateCursor(CursorPtr cursor)
+{
+	if (cursor == NULL)
+		return new(std::nothrow) BCursor(B_CURSOR_ID_NO_CURSOR);
+
+	CursorBitsPtr bits = cursor->bits;
+	if (bits == NULL || (bits->emptyMask && bits->argb == NULL))
+		return new(std::nothrow) BCursor(B_CURSOR_ID_NO_CURSOR);
+
+	BCursorID id;
+	if (vMapName(cursor, &id) || vMapGlyph(cursor, &id)
+		|| vMapThemeImage(cursor, &id))
+		return new(std::nothrow) BCursor(id);
+
+	BBitmap* bitmap = vCursorBitmap(cursor);
+	if (bitmap == NULL)
+		return NULL;
+
+	BCursor* result = new(std::nothrow) BCursor(bitmap,
+		BPoint(bits->xhot, bits->yhot));
+	delete bitmap;
+	if (result != NULL && result->InitCheck() != B_OK) {
+		delete result;
+		result = NULL;
+	}
+	return result;
+}
+
+
+static BCursor*
+vCursorFor(CursorPtr cursor, uint32 key)
+{
+	std::map<uint32, BCursor*>::iterator found = sCursors.find(key);
+	if (found != sCursors.end())
+		return found->second;
+
+	BCursor* result = vCreateCursor(cursor);
+	if (result == NULL)
+		return NULL;
+
+	// The server keeps the ones in use; dropping all is cheap to refill.
+	if (sCursors.size() >= kMaxCachedCursors) {
+		for (found = sCursors.begin(); found != sCursors.end(); ++found)
+			delete found->second;
+		sCursors.clear();
+	}
+	sCursors[key] = result;
+	return result;
+}
+
+
+// The surface of the toplevel the pointer is in, or the grab's.
+static VWindowPriv*
+vPointerSurface(DeviceIntPtr pDev)
+{
+	if (pDev->spriteInfo == NULL || pDev->spriteInfo->sprite == NULL)
+		return NULL;
+
+	WindowPtr pWin = pDev->spriteInfo->sprite->win;
+	if (pDev->deviceGrab.grab != NULL
+		&& pDev->deviceGrab.grab->window != NULL) {
+		pWin = pDev->deviceGrab.grab->window;
+	}
+
+	while (pWin != NULL && pWin->parent != NULL
+		&& pWin->parent->parent != NULL) {
+		pWin = pWin->parent;
+	}
+
+	if (pWin == NULL || pWin->parent == NULL)
+		return NULL;
+
+	VWindowPriv* priv = VWindowPrivFor(pWin);
+	if (priv == NULL || priv->surface == NULL)
+		return NULL;
+	return priv;
+}
+
+
+void
+VCursorApply(DeviceIntPtr pDev)
+{
+	if (pDev != inputInfo.pointer || !sCurrentKnown)
+		return;
+
+	VWindowPriv* priv = vPointerSurface(pDev);
+	if (priv == NULL)
+		return;
+
+	uint32 key = sCurrent != NULL ? sCurrent->serialNumber : kHiddenKey;
+	if (priv->cursorKey == key && priv->cursorSet)
+		return;
+
+	BCursor* cursor = vCursorFor(sCurrent, key);
+	if (cursor == NULL)
+		return;
+
+	priv->surface->SetCursor(cursor);
+	priv->cursorKey = key;
+	priv->cursorSet = true;
+}
+
+
+void
+VCursorSet(DeviceIntPtr pDev, CursorPtr pCursor)
+{
+	if (pDev != inputInfo.pointer)
+		return;
+
+	// NULL is XFixes hiding the pointer.
+	if (pCursor != NULL)
+		RefCursor(pCursor);
+	if (sCurrent != NULL)
+		FreeCursor(sCurrent, (XID)0);
+	sCurrent = pCursor;
+	sCurrentKnown = true;
+	VCursorApply(pDev);
+}
