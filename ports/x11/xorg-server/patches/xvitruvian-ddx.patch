+++ b/hw/vitruvian/vSettings.cpp
@@ -0,0 +1,270 @@
+/*
+ * Copyright 2026, Dario Casalinuovo. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+// V\OS UI settings for X clients: the XSETTINGS manager for GTK and Qt
+// plus RESOURCE_MANAGER for Xft and Xcursor.
+
+#include <dix-config.h>
+
+#include "vPriv.h"
+
+#include <X11/Xatom.h>
+
+#include <Autolock.h>
+#include <Font.h>
+#include <Locker.h>
+#include <InterfaceDefs.h>
+#include <String.h>
+
+#include <stdio.h>
+#include <string.h>
+
+
+
+void _init_global_fonts_();
+
+static const int kDpi = 96;
+static const int kCursorSize = 24;
+
+static WindowPtr sOwner = NULL;
+static uint32 sSerial = 0;
+
+
+static Atom
+vSettingAtom(const char* name)
+{
+	return MakeAtom(name, strlen(name), TRUE);
+}
+
+
+//	#pragma mark - XSETTINGS
+
+
+static void
+vPad(std::vector<uint8>& out)
+{
+	while (out.size() % 4 != 0)
+		out.push_back(0);
+}
+
+
+static void
+vPut32(std::vector<uint8>& out, uint32 value)
+{
+	for (int i = 0; i < 4; i++)
+		out.push_back((value >> (8 * i)) & 0xff);
+}
+
+
+static void
+vPutName(std::vector<uint8>& out, uint8 type, const char* name)
+{
+	size_t length = strlen(name);
+	out.push_back(type);
+	out.push_back(0);
+	out.push_back(length & 0xff);
+	out.push_back((length >> 8) & 0xff);
+	out.insert(out.end(), name, name + length);
+	vPad(out);
+	vPut32(out, sSerial);
+}
+
+
+static void
+vPutInt(std::vector<uint8>& out, const char* name, uint32 value)
+{
+	vPutName(out, 0, name);
+	vPut32(out, value);
+}
+
+
+static void
+vPutString(std::vector<uint8>& out, const char* name, const char* value)
+{
+	vPutName(out, 1, name);
+	size_t length = strlen(value);
+	vPut32(out, length);
+	out.insert(out.end(), value, value + length);
+	vPad(out);
+}
+
+
+static BLocker sCacheLock("xv settings");
+static BString sCachedFont("Sans 10");
+static bool sCachedDark = false;
+
+
+// Runs on the application thread: font and color queries talk to
+// app_server and must never run on the X thread.
+void
+VSettingsRefresh()
+{
+	_init_global_fonts_();
+
+	font_family family;
+	font_style style;
+	be_plain_font->GetFamilyAndStyle(&family, &style);
+	BString font;
+	font.SetToFormat("%s %d", family, (int)(be_plain_font->Size() + 0.5f));
+
+	rgb_color background = ui_color(B_PANEL_BACKGROUND_COLOR);
+	bool dark = (background.red * 299 + background.green * 587
+		+ background.blue * 114) / 1000 < 128;
+
+	BAutolock locker(sCacheLock);
+	sCachedFont = font;
+	sCachedDark = dark;
+}
+
+
+static void
+vReadSettings(BString& font, bool& dark)
+{
+	BAutolock locker(sCacheLock);
+	font = sCachedFont;
+	dark = sCachedDark;
+}
+
+
+static void
+vPublishXSettings(const BString& font, bool dark)
+{
+	std::vector<uint8> data;
+	data.push_back(0);	// LSBFirst
+	data.push_back(0);
+	data.push_back(0);
+	data.push_back(0);
+	vPut32(data, sSerial);
+	vPut32(data, 8);
+
+	vPutInt(data, "Xft/DPI", kDpi * 1024);
+	vPutInt(data, "Xft/Antialias", 1);
+	vPutInt(data, "Xft/Hinting", 1);
+	vPutString(data, "Xft/HintStyle", "hintslight");
+	vPutString(data, "Xft/RGBA", "none");
+	vPutString(data, "Gtk/FontName", font.String());
+	vPutString(data, "Net/ThemeName", dark ? "Adwaita-dark" : "Adwaita");
+	vPutInt(data, "Gtk/CursorThemeSize", kCursorSize);
+
+	Atom property = vSettingAtom("_XSETTINGS_SETTINGS");
+	dixChangeWindowProperty(serverClient, sOwner, property, property, 8,
+		PropModeReplace, data.size(), data.data(), TRUE);
+}
+
+
+//	#pragma mark - RESOURCE_MANAGER
+
+
+static void
+vPublishResources(WindowPtr root)
+{
+	static const char* const kKeys[] = {
+		"Xft.dpi:", "Xft.antialias:", "Xft.hinting:", "Xft.hintstyle:",
+		"Xft.rgba:", "Xcursor.size:"
+	};
+
+	// Merge like xrdb: keep every entry that is not ours.
+	BString result;
+	PropertyPtr prop = NULL;
+	if (dixLookupProperty(&prop, root, XA_RESOURCE_MANAGER, serverClient,
+			DixReadAccess) == Success && prop != NULL && prop->format == 8
+		&& prop->size > 0) {
+		BString old((const char*)prop->data, prop->size);
+		int32 start = 0;
+		while (start < old.Length()) {
+			int32 end = old.FindFirst('\n', start);
+			if (end < 0)
+				end = old.Length();
+			BString line;
+			old.CopyInto(line, start, end - start);
+			start = end + 1;
+
+			bool ours = false;
+			for (size_t i = 0; i < sizeof(kKeys) / sizeof(kKeys[0]); i++) {
+				if (line.FindFirst(kKeys[i]) == 0)
+					ours = true;
+			}
+			if (!ours && line.Length() > 0)
+				result << line << "\n";
+		}
+	}
+
+	result << "Xft.dpi:\t" << (int32)kDpi << "\n"
+		<< "Xft.antialias:\t1\n"
+		<< "Xft.hinting:\t1\n"
+		<< "Xft.hintstyle:\thintslight\n"
+		<< "Xft.rgba:\tnone\n"
+		<< "Xcursor.size:\t" << (int32)kCursorSize << "\n";
+
+	dixChangeWindowProperty(serverClient, root, XA_RESOURCE_MANAGER,
+		XA_STRING, 8, PropModeReplace, result.Length(),
+		(void*)result.String(), TRUE);
+}
+
+
+//	#pragma mark - entry points
+
+
+// Takes the _XSETTINGS_S0 selection once; later calls only republish.
+void
+VSettingsUpdate()
+{
+	if (gVScreen == NULL || gVScreen->root == NULL)
+		return;
+
+	WindowPtr root = gVScreen->root;
+	BString font;
+	bool dark;
+	vReadSettings(font, dark);
+
+	if (sOwner == NULL) {
+		int error = 0;
+		sOwner = CreateWindow(FakeClientID(0), root, -1, -1, 1, 1, 0,
+			InputOnly, 0, NULL, 0, serverClient, CopyFromParent, &error);
+		if (sOwner == NULL)
+			return;
+		if (!AddResource(sOwner->drawable.id, RT_WINDOW, sOwner)) {
+			sOwner = NULL;
+			return;
+		}
+	}
+
+	sSerial++;
+	vPublishXSettings(font, dark);
+	vPublishResources(root);
+
+	Atom selection = vSettingAtom("_XSETTINGS_S0");
+	Selection* pSel = NULL;
+	if (dixLookupSelection(&pSel, selection, serverClient,
+			DixSetAttrAccess) == Success && pSel->pWin == sOwner)
+		return;
+
+	if (pSel == NULL) {
+		pSel = dixAllocateObjectWithPrivates(Selection, PRIVATE_SELECTION);
+		if (pSel == NULL)
+			return;
+		pSel->selection = selection;
+		pSel->next = CurrentSelections;
+		CurrentSelections = pSel;
+	}
+	UpdateCurrentTime();
+	pSel->lastTimeChanged = currentTime;
+	pSel->window = sOwner->drawable.id;
+	pSel->pWin = sOwner;
+	pSel->client = NullClient;
+
+	// Announce the manager to clients that are already running.
+	xEvent event;
+	memset(&event, 0, sizeof(event));
+	event.u.u.type = ClientMessage;
+	event.u.u.detail = 32;
+	event.u.clientMessage.window = root->drawable.id;
+	event.u.clientMessage.u.l.type = vSettingAtom("MANAGER");
+	event.u.clientMessage.u.l.longs0 = currentTime.milliseconds;
+	event.u.clientMessage.u.l.longs1 = selection;
+	event.u.clientMessage.u.l.longs2 = sOwner->drawable.id;
+	DeliverEventsToWindow(PickPointer(serverClient), root, &event, 1,
+		StructureNotifyMask, NullGrab);
+}
