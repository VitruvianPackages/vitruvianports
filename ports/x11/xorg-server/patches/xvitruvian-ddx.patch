+// _NET_WM_PID when the client set one, else the connection's peer.
+static pid_t
+vClientPid(WindowPtr pWin)
+{
+	PropertyPtr prop = NULL;
+	if (dixLookupProperty(&prop, pWin, vAtom("_NET_WM_PID"), serverClient,
+			DixReadAccess) == Success && prop != NULL && prop->format == 32
+		&& prop->size >= 1 && prop->type == XA_CARDINAL) {
+		pid_t pid = (pid_t)(*(CARD32*)prop->data);
+		if (pid > 1)
+			return pid;
+	}
+	return GetClientPid(wClient(pWin));
+}
