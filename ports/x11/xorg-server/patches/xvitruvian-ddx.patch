+
+// Reads an atom-list property into outAtoms; returns the item count or
+// -1 when the property is absent or of the wrong type.
+static int
+vReadAtomList(WindowPtr pWin, Atom property, Atom* outAtoms, int maxAtoms)
+{
+	PropertyPtr prop = NULL;
+	if (dixLookupProperty(&prop, pWin, property, serverClient,
+			DixReadAccess) != Success || prop == NULL)
+		return -1;
+	if (prop->type != XA_ATOM || prop->format != 32)
+		return -1;
+
+	int count = (int)prop->size;
+	if (count > maxAtoms)
+		count = maxAtoms;
+	memcpy(outAtoms, prop->data, (size_t)count * sizeof(Atom));
+	return count;
+}
+
+
+static bool
+vWindowHasAtom(WindowPtr pWin, Atom property, Atom wanted)
+{
+	Atom atoms[64];
+	int count = vReadAtomList(pWin, property, atoms, 64);
+	for (int i = 0; i < count; i++) {
+		if (atoms[i] == wanted)
+			return true;
+	}
+	return false;
+}
+
+
+// Rounds a size to the client's WM_NORMAL_HINTS steps and minimum, as a
+// window manager does, so clients like terminals don't snap it back.
+static void
+vApplySizeHints(WindowPtr pWin, int32* width, int32* height)
+{
+	PropertyPtr prop = NULL;
+	if (dixLookupProperty(&prop, pWin, XA_WM_NORMAL_HINTS, serverClient,
+			DixReadAccess) != Success || prop == NULL || prop->format != 32
+		|| prop->size < 15) {
+		return;
+	}
+
+	const CARD32* hints = (const CARD32*)prop->data;
+	const CARD32 kMinSize = 1 << 4;
+	const CARD32 kResizeInc = 1 << 6;
+	const CARD32 kBaseSize = 1 << 8;
+	CARD32 flags = hints[0];
+
+	int32 baseW = 0;
+	int32 baseH = 0;
+	if ((flags & kBaseSize) != 0 && prop->size >= 17) {
+		baseW = (int32)hints[15];
+		baseH = (int32)hints[16];
+	} else if ((flags & kMinSize) != 0) {
+		baseW = (int32)hints[5];
+		baseH = (int32)hints[6];
+	}
+
+	if ((flags & kResizeInc) != 0) {
+		int32 incW = (int32)hints[9];
+		int32 incH = (int32)hints[10];
+		if (incW > 1 && *width > baseW)
+			*width = baseW + (*width - baseW) / incW * incW;
+		if (incH > 1 && *height > baseH)
+			*height = baseH + (*height - baseH) / incH * incH;
+	}
+
+	if ((flags & kMinSize) != 0) {
+		*width = vMaxI(*width, (int32)hints[5]);
+		*height = vMaxI(*height, (int32)hints[6]);
+	}
+}
+
+
+// The zoom button toggles between the screen and the previous frame; the
+// moved/resized events that follow carry it over to the X window.
+static void
+vZoom(VWindowPriv* priv)
+{
+	BSurface* surface = priv->surface;
+	if (priv->zoomed) {
+		surface->MoveTo(BPoint(priv->restoreX, priv->restoreY));
+		surface->ResizeTo(priv->restoreWidth, priv->restoreHeight);
+		priv->zoomed = false;
+		return;
+	}
+
+	BRect frame = surface->Frame();
+	priv->restoreX = (int32)frame.left;
+	priv->restoreY = (int32)frame.top;
+	priv->restoreWidth = frame.IntegerWidth();
+	priv->restoreHeight = frame.IntegerHeight();
+
+	BRect screen = BScreen().Frame();
+	// Leave room for the tab and the window border.
+	const float kBorder = 5;
+	const float kTab = 22;
+	surface->MoveTo(BPoint(screen.left + kBorder, screen.top + kTab));
+	surface->ResizeTo(screen.Width() - 2 * kBorder,
+		screen.Height() - kTab - kBorder);
+	priv->zoomed = true;
+}
