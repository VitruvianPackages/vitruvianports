+
+// Moves the frame for the fullscreen and maximized states, and back to the
+// saved frame once none is left.
+static void
+vPlaceWindow(VWindowPriv* priv)
+{
+	bool any = priv->fullscreen || priv->maxH || priv->maxV;
+	if (!any) {
+		if (priv->restoreSaved) {
+			priv->restoreSaved = false;
+			priv->surface->MoveTo(BPoint(priv->restoreX, priv->restoreY));
+			priv->surface->ResizeTo(priv->restoreWidth, priv->restoreHeight);
+		}
+		return;
+	}
+
+	if (!priv->restoreSaved) {
+		BRect frame = priv->surface->Frame();
+		priv->restoreX = (int32)frame.left;
+		priv->restoreY = (int32)frame.top;
+		priv->restoreWidth = frame.IntegerWidth();
+		priv->restoreHeight = frame.IntegerHeight();
+		priv->restoreSaved = true;
+	}
+
+	if (priv->fullscreen) {
+		if (gVScreen != NULL) {
+			priv->surface->Activate();
+			priv->surface->MoveTo(B_ORIGIN);
+			priv->surface->ResizeTo((float)gVScreen->width - 1,
+				(float)gVScreen->height - 1);
+		}
+		return;
+	}
+
+	BRect screen = vWorkArea();
+	float left = priv->restoreX;
+	float top = priv->restoreY;
+	float width = priv->restoreWidth;
+	float height = priv->restoreHeight;
+	if (priv->maxH) {
+		left = screen.left + priv->extents[0];
+		width = screen.Width() - priv->extents[0] - priv->extents[1];
+	}
+	if (priv->maxV) {
+		top = screen.top + priv->extents[2];
+		height = screen.Height() - priv->extents[2] - priv->extents[3];
+	}
+	priv->surface->MoveTo(BPoint(left, top));
+	priv->surface->ResizeTo(width, height);
+}
+
+
+void
+VApplyWindowState(VWindowPriv* priv)
+{
+	if (priv == NULL || priv->surface == NULL)
+		return;
+
+	WindowPtr pWin = vLookupWindow(priv->xWindow);
+	if (pWin == NULL)
+		return;
+
+	VStyle style;
+	vComputeStyle(pWin, &style);
+
+	if (!priv->styled || priv->look != style.look) {
+		priv->look = style.look;
+		priv->surface->SetLook(style.look);
+	}
+	if (!priv->styled || priv->feel != style.feel) {
+		priv->feel = style.feel;
+		priv->surface->SetFeel(style.feel);
+	}
+	if (!priv->styled || priv->flags != style.flags) {
+		priv->flags = style.flags;
+		priv->surface->SetFlags(style.flags);
+	}
+	if (!priv->styled || memcmp(priv->limits, style.limits,
+			sizeof(style.limits)) != 0) {
+		memcpy(priv->limits, style.limits, sizeof(style.limits));
+		priv->surface->SetSizeLimits(style.limits[0], style.limits[1],
+			style.limits[2], style.limits[3]);
+	}
+	bool extentsChanged = !priv->styled
+		|| memcmp(priv->extents, style.extents, sizeof(style.extents)) != 0;
+	memcpy(priv->extents, style.extents, sizeof(style.extents));
+	bool actionsChanged = priv->resizable != (int8)style.resizable;
+	priv->resizable = style.resizable;
+	priv->styled = true;
+
+	if (pWin->overrideRedirect)
+		return;
+
+	int32 csd[4];
+	vReadCsdExtents(pWin, csd);
+	if (memcmp(priv->csd, csd, sizeof(csd)) != 0) {
+		memcpy(priv->csd, csd, sizeof(csd));
+		vPlaceSurface(priv, pWin);
+		VUploadWindowDamage(priv, pWin->drawable.x, pWin->drawable.y,
+			pWin->drawable.x + (int32)pWin->drawable.width,
+			pWin->drawable.y + (int32)pWin->drawable.height);
+	}
+
+	if (extentsChanged)
+		vPublishExtents(pWin, style.extents);
+	if (actionsChanged)
+		vPublishActions(pWin, style.resizable);
+
+	Atom state = vAtom("_NET_WM_STATE");
+	bool full = vWindowHasAtom(pWin, state,
+		vAtom("_NET_WM_STATE_FULLSCREEN"));
+	bool maxH = vWindowHasAtom(pWin, state,
+		vAtom("_NET_WM_STATE_MAXIMIZED_HORZ"));
+	bool maxV = vWindowHasAtom(pWin, state,
+		vAtom("_NET_WM_STATE_MAXIMIZED_VERT"));
+	if (full != priv->fullscreen || maxH != priv->maxH || maxV != priv->maxV) {
+		priv->fullscreen = full;
+		priv->maxH = maxH;
+		priv->maxV = maxV;
+		vPlaceWindow(priv);
+	} else if (extentsChanged && (maxH || maxV) && !full)
+		vPlaceWindow(priv);
+
+	bool hidden = vWindowHasAtom(pWin, state, vAtom("_NET_WM_STATE_HIDDEN"));
+	if (hidden != priv->minimized) {
+		priv->minimized = hidden;
+		priv->surface->Minimize(hidden);
+	}
+}
+
+
+void
+VWindowPropertyChanged(WindowPtr pWin, Atom prop)
+{
+	VWindowPriv* priv = vPriv(pWin);
+	if (priv == NULL || priv->surface == NULL)
+		return;
+
+	Atom netName = vAtom("_NET_WM_NAME");
+	Atom state = vAtom("_NET_WM_STATE");
+
+	if (prop == XA_WM_NAME || prop == netName)
+		VSyncWindowTitle(priv);
+	else if (prop == state || prop == vAtom("_NET_WM_WINDOW_TYPE")
+		|| prop == vAtom("_MOTIF_WM_HINTS")
+		|| prop == vAtom("_GTK_FRAME_EXTENTS") || prop == XA_WM_NORMAL_HINTS
+		|| prop == XA_WM_TRANSIENT_FOR)
+		VApplyWindowState(priv);
+	else if (prop == vAtom("_NET_WM_PID"))
+		VWindowAttribute(pWin);
+}
