+// A logout or shutdown ends the X server the way SIGTERM does; be_app
+// stays alive for the surfaces until the process exits.
+bool
+XVApp::QuitRequested()
+{
+	kill(getpid(), SIGTERM);
+	VWakeServer();
+	return true;
+}
