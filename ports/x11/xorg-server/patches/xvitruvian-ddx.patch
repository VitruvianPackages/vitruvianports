+ */
+
+// DRI3 import of dma-buf pixmaps and Present. Clients render into their own
+// buffers. A buffer that covers its window goes to the server as a dma-buf
+// and is shown without a copy; any other Present copies the pixmap into the
+// window pixmap, which goes out through the normal damage upload.
+
+#ifdef HAVE_DIX_CONFIG_H
+#include <dix-config.h>
+#endif
+
+#include "vPriv.h"
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/dma-buf.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <OS.h>
+#include <PortFds.h>
+#include <Region.h>
+#include <Surface.h>
+
+#define class class_
+#define public public_
+extern "C" {
+#ifdef DRI3
+#include "dri3.h"
+#include "misyncshm.h"
+#endif
+#ifdef PRESENT
+#include "present.h"
+#endif
+}
+#undef public
+#undef class
+
+#ifdef DRI3
+
+static const uint32_t kFormatXRGB8888 = 0x34325258;
+static const uint32_t kFormatARGB8888 = 0x34325241;
+static const uint64_t kModLinear = 0;
+static const uint64_t kModInvalid = 0x00ffffffffffffffULL;
+
+struct VDmabuf {
+	int		fd;
+	void*	map;
+	size_t	mapSize;
+	size_t	offset;
+	bool	syncing;
+	// The device's own layout: the pages cannot be read as rows.
+	bool	tiled;
+	// Blank pages a tiled buffer shows to copies.
+	void*	shadow;
+	// The window whose chain holds the slot, 0 when none.
+	Window	flipWindow;
+};
+
+static const int kFlipSlots = 4;
+static const bigtime_t kFlipBackstop = 250000;
+
+// A buffer shown on a window, idle once the server shows another one.
+struct VFlipPending {
+	PixmapPtr				pixmap;
+	CARD32					serial;
+	struct present_fence*	fence;
+	int						slot;
+	bigtime_t				since;
+};
+
+// Imported buffers of one window.
+struct VFlip {
+	Window			window;
+	BSurface*		surface;
+	int32			width;
+	int32			height;
+	PixmapPtr		slots[kFlipSlots];
+	int				slotCount;
+	VFlipPending*	pending;
+	int				pendingCount;
+};
+
+static DevPrivateKeyRec sDmabufKey;
+static int sRenderFd = -1;
+static DestroyPixmapProcPtr sDestroyPixmap = NULL;
+static VDmabuf** sImported = NULL;
+static int sImportedCount = 0;
+static bool sFlipEnabled = true;
+static char sRenderDriver[32];
+static VFlip** sFlips = NULL;
+static int sFlipCount = 0;
+
+static VDmabuf*
+vDmabuf(PixmapPtr pix)
+{
+	return (VDmabuf*)dixGetPrivateAddr(&pix->devPrivates, &sDmabufKey);
+}
+
+
+static void
+vDmabufSync(VDmabuf* buf, uint64_t flags)
+{
+	struct dma_buf_sync sync;
+	sync.flags = flags;
+	while (ioctl(buf->fd, DMA_BUF_IOCTL_SYNC, &sync) < 0 && errno == EINTR)
+		;
+}
+
+
+static void
+vTrackImport(VDmabuf* buf, bool add)
+{
+	if (add) {
+		VDmabuf** list = (VDmabuf**)realloc(sImported,
+			sizeof(VDmabuf*) * (sImportedCount + 1));
+		if (list == NULL)
+			return;
+		sImported = list;
+		sImported[sImportedCount++] = buf;
+		return;
+	}
+	for (int i = 0; i < sImportedCount; i++) {
+		if (sImported[i] == buf) {
+			sImported[i] = sImported[--sImportedCount];
+			break;
+		}
+	}
+}
+
+
+// Present copies from the client pixmap inside requests, with no hook to
+// bracket it. Keep a read window open per imported buffer and renew it
+// each loop so the next batch of copies sees fresh GPU writes.
+static void vFlipPoll(void* timeout);
+
+
+static void
+vDmabufBlock(void* /*data*/, void* timeout)
+{
+	vFlipPoll(timeout);
+	for (int i = 0; i < sImportedCount; i++) {
+		VDmabuf* buf = sImported[i];
+		if (buf->tiled)
+			continue;
+		if (buf->syncing)
+			vDmabufSync(buf, DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ);
+		vDmabufSync(buf, DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ);
+		buf->syncing = true;
+	}
+}
+
+
+static void
+vDmabufWakeup(void* /*data*/, int /*result*/)
+{
+}
+
+
+static bigtime_t
+vNow()
+{
+	struct timespec now;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	return (bigtime_t)now.tv_sec * 1000000 + now.tv_nsec / 1000;
+}
+
+
+static VFlip*
+vFlipFor(Window window, bool create)
+{
+	for (int i = 0; i < sFlipCount; i++) {
+		if (sFlips[i]->window == window)
+			return sFlips[i];
+	}
+	if (!create)
+		return NULL;
+
+	VFlip* flip = (VFlip*)calloc(1, sizeof(VFlip));
+	VFlip** list = (VFlip**)realloc(sFlips, sizeof(VFlip*) * (sFlipCount + 1));
+	if (flip == NULL || list == NULL) {
+		free(flip);
+		return NULL;
+	}
+	flip->window = window;
+	sFlips = list;
+	sFlips[sFlipCount++] = flip;
+	return flip;
+}
+
+
+static void
+vFlipIdle(VFlip* flip, int index)
+{
+	VFlipPending done = flip->pending[index];
+	flip->pending[index] = flip->pending[--flip->pendingCount];
+	WindowPtr window = flip->window != 0 ? VWindowForId(flip->window) : NULL;
+	present_window_flip_done(done.pixmap, window, done.serial, done.fence);
+}
+
+
+// Forgets the slots the server holds; a buffer still on screen idles late.
+static void
+vFlipReset(VFlip* flip, bool tellServer)
+{
+	if (tellServer && flip->surface != NULL)
+		flip->surface->ExternalReset();
+	for (int i = 0; i < flip->slotCount; i++) {
+		if (flip->slots[i] != NULL) {
+			VDmabuf* buf = vDmabuf(flip->slots[i]);
+			if (buf != NULL)
+				buf->flipWindow = 0;
+		}
+		flip->slots[i] = NULL;
+	}
+	flip->slotCount = 0;
+	for (int i = 0; i < flip->pendingCount; i++)
+		flip->pending[i].slot = -1;
+}
+
+
+static void
+vFlipPoll(void* timeout)
+{
+	if (sFlipCount == 0)
+		return;
+
+	bool waiting = false;
+	const bigtime_t now = vNow();
+	for (int f = 0; f < sFlipCount; f++) {
+		VFlip* flip = sFlips[f];
+		for (int i = flip->pendingCount - 1; i >= 0; i--) {
+			const VFlipPending& pending = flip->pending[i];
+			const bool released = pending.slot >= 0 && flip->surface != NULL
+				&& flip->surface->ExternalReleased(pending.slot);
+			const bigtime_t age = now - pending.since;
+			// The server showed nothing else: do not stall the client.
+			if (released || age > kFlipBackstop
+				|| (pending.slot < 0 && age > 100000))
+				vFlipIdle(flip, i);
+		}
+		waiting = waiting || flip->pendingCount > 0;
+	}
+	if (waiting)
+		AdjustWaitForDelay(timeout, 2);
+}
+
+
+// Present of a buffer that covers its window: the server shows it in place.
+static Bool
+vWindowFlip(WindowPtr window, PixmapPtr pixmap, RegionPtr update,
+	int16_t xOff, int16_t yOff, CARD32 serial, struct present_fence* fence)
+{
+	if (!sFlipEnabled || xOff != 0 || yOff != 0 || window->firstChild != NULL
+		|| pixmap->drawable.depth != 24)
+		return FALSE;
+
+	VWindowPriv* priv = VWindowPrivFor(window);
+	VDmabuf* buf = vDmabuf(pixmap);
+	if (priv == NULL || priv->surface == NULL || !priv->topLevel
+		|| !priv->mapped || buf->fd <= 0
+		|| priv->csd[0] != 0 || priv->csd[1] != 0 || priv->csd[2] != 0
+		|| priv->csd[3] != 0
+		|| pixmap->drawable.width != window->drawable.width
+		|| pixmap->drawable.height != window->drawable.height)
+		return FALSE;
+	if (!priv->surface->ExternalReady() || priv->surface->ExternalRefused())
+		return FALSE;
+
+	VFlip* flip = vFlipFor(priv->xWindow, true);
+	if (flip == NULL)
+		return FALSE;
+	// A resized chain has dropped the buffers the server held.
+	if (flip->surface != priv->surface || flip->width != pixmap->drawable.width
+		|| flip->height != pixmap->drawable.height) {
+		vFlipReset(flip, flip->surface == priv->surface);
+		flip->surface = priv->surface;
+		flip->width = pixmap->drawable.width;
+		flip->height = pixmap->drawable.height;
+	}
+
+	int slot = -1;
+	for (int i = 0; i < flip->slotCount; i++) {
+		if (flip->slots[i] == pixmap)
+			slot = i;
+	}
+	if (slot < 0) {
+		if (flip->slotCount == kFlipSlots || buf->flipWindow != 0)
+			return FALSE;
+		BPrivate::swap_chain_external desc;
+		desc.width = pixmap->drawable.width;
+		desc.height = pixmap->drawable.height;
+		desc.fourcc = kFormatXRGB8888;
+		desc.stride = pixmap->devKind;
+		desc.offset = buf->offset;
+		desc.modifier = buf->tiled ? kModInvalid : kModLinear;
+		int32 imported = -1;
+		if (!priv->surface->ExternalImport(buf->fd, desc, &imported)
+			|| imported != flip->slotCount)
+			return FALSE;
+		slot = imported;
+		flip->slots[flip->slotCount++] = pixmap;
+		buf->flipWindow = priv->xWindow;
+	}
+
+	VFlipPending* list = (VFlipPending*)realloc(flip->pending,
+		sizeof(VFlipPending) * (flip->pendingCount + 1));
+	if (list == NULL)
+		return FALSE;
+	flip->pending = list;
+
+	BRegion damage;
+	if (update == NULL) {
+		damage.Set(BRect(0, 0, flip->width - 1, flip->height - 1));
+	} else {
+		for (int i = 0; i < RegionNumRects(update); i++) {
+			BoxPtr box = RegionRects(update) + i;
+			damage.Include(BRect(box->x1, box->y1, box->x2 - 1,
+				box->y2 - 1));
+		}
+	}
+	if (!priv->surface->PresentExternal(slot, damage))
+		return FALSE;
+
+	VFlipPending& pending = flip->pending[flip->pendingCount++];
+	pending.pixmap = pixmap;
+	pending.serial = serial;
+	pending.fence = fence;
+	pending.slot = slot;
+	pending.since = vNow();
+	priv->flipped = true;
+	return TRUE;
+}
+
+
+// X drew into a window that shows a client buffer. 0: not flipped, 1: the
+// window pixmap holds the picture again and the caller uploads it, 2: the
+// buffer cannot be read back, the drawing is dropped.
+int
+VFlipRestore(VWindowPriv* priv, WindowPtr window, RegionPtr damage)
+{
+	if (priv == NULL || !priv->flipped)
+		return 0;
+
+	VFlip* flip = vFlipFor(priv->xWindow, false);
+	PixmapPtr shown = NULL;
+	if (flip != NULL && flip->pendingCount > 0) {
+		int slot = flip->pending[flip->pendingCount - 1].slot;
+		if (slot >= 0 && slot < flip->slotCount)
+			shown = flip->slots[slot];
+	}
+	VDmabuf* buf = shown != NULL ? vDmabuf(shown) : NULL;
+	if (buf != NULL && buf->tiled)
+		return 2;
+
+	if (buf != NULL && buf->map != NULL) {
+		PixmapPtr dst = (*gVScreen->GetWindowPixmap)(window);
+		if (dst != NULL && dst->devPrivate.ptr != NULL
+			&& dst->drawable.width == shown->drawable.width
+			&& dst->drawable.height == shown->drawable.height) {
+			// Keep what X just drew, restore the rest.
+			RegionRec rest;
+			BoxRec box = { 0, 0, (short)dst->drawable.width,
+				(short)dst->drawable.height };
+			RegionInit(&rest, &box, 1);
+			RegionSubtract(&rest, &rest, damage);
+			vDmabufSync(buf, DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ);
+			for (int i = 0; i < RegionNumRects(&rest); i++) {
+				BoxPtr r = RegionRects(&rest) + i;
+				for (int y = r->y1; y < r->y2; y++) {
+					memcpy((char*)dst->devPrivate.ptr + (size_t)y
+							* dst->devKind + (size_t)r->x1 * 4,
+						(char*)shown->devPrivate.ptr + (size_t)y
+							* shown->devKind + (size_t)r->x1 * 4,
+						(size_t)(r->x2 - r->x1) * 4);
+				}
+			}
+			vDmabufSync(buf, DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ);
+			RegionUninit(&rest);
+		}
+	}
+	priv->flipped = false;
+	return 1;
+}
+
+
+void
+VFlipForget(VWindowPriv* priv)
+{
+	if (priv == NULL)
+		return;
+
+	for (int f = 0; f < sFlipCount; f++) {
+		VFlip* flip = sFlips[f];
+		if (flip->window != priv->xWindow)
+			continue;
+
+		vFlipReset(flip, false);
+		while (flip->pendingCount > 0)
+			vFlipIdle(flip, flip->pendingCount - 1);
+		free(flip->pending);
+		free(flip);
+		sFlips[f] = sFlips[--sFlipCount];
+		break;
+	}
+	priv->flipped = false;
+}
+
+
+
+static Bool
+vDestroyPixmap(PixmapPtr pix)
+{
+	if (pix->refcnt == 1) {
+		VDmabuf* buf = vDmabuf(pix);
+		if (buf->fd > 0 && buf->flipWindow != 0) {
+			VFlip* flip = vFlipFor(buf->flipWindow, false);
+			if (flip != NULL)
+				vFlipReset(flip, true);
+		}
+		if (buf->fd > 0) {
+			vTrackImport(buf, false);
+			if (buf->syncing)
+				vDmabufSync(buf, DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ);
+			if (buf->map != NULL)
+				munmap(buf->map, buf->mapSize);
+			free(buf->shadow);
+			buf->shadow = NULL;
+			close(buf->fd);
+			buf->fd = 0;
+			buf->map = NULL;
+		}
+	}
+	return (*sDestroyPixmap)(pix);
+}
+
+
+static int
+vOpenClient(ClientPtr /*client*/, ScreenPtr /*screen*/,
+	RRProviderPtr /*provider*/, int* fd)
+{
+	int dup = fcntl(sRenderFd, F_DUPFD_CLOEXEC, 3);
+	if (dup < 0)
+		return BadAlloc;
+	*fd = dup;
+	return Success;
+}
+
+
+static int
+vOpen(ScreenPtr screen, RRProviderPtr provider, int* fd)
+{
+	return vOpenClient(NULL, screen, provider, fd);
+}
+
+
+// Name of the kernel driver behind a render node or the exporter of a
+// dma-buf (fdinfo), '' when unknown.
+static void
+vExporterOf(int fd, char* name)
+{
+	name[0] = '\0';
+	char path[64];
+	snprintf(path, sizeof(path), "/proc/self/fdinfo/%d", fd);
+	FILE* file = fopen(path, "r");
+	if (file == NULL)
+		return;
+	char line[128];
+	while (fgets(line, sizeof(line), file) != NULL) {
+		if (sscanf(line, "exp_name: %31s", name) == 1)
+			break;
+	}
+	fclose(file);
+}
+
+
+static PixmapPtr
+vPixmapFromFds(ScreenPtr screen, CARD8 numFds, const int* fds, CARD16 width,
+	CARD16 height, const CARD32* strides, const CARD32* offsets, CARD8 depth,
+	CARD8 bpp, CARD64 modifier)
+{
+	if (numFds != 1 || bpp != 32 || (depth != 24 && depth != 32)
+		|| (modifier != kModLinear && modifier != kModInvalid)
+		|| width == 0 || height == 0 || strides[0] < (CARD32)width * 4)
+		return NULL;
+
+	// Rows can be read only from LINEAR, or from INVALID made by another
+	// GPU. Anything else is the display GPU's layout and can only be flipped.
+	bool tiled = false;
+	if (modifier == kModInvalid) {
+		char exporter[32];
+		vExporterOf(fds[0], exporter);
+		tiled = strcmp(exporter, sRenderDriver) == 0;
+	}
+	if (tiled && !sFlipEnabled)
+		return NULL;
+
+	struct stat st;
+	size_t need = (size_t)offsets[0] + (size_t)strides[0] * height;
+	if (fstat(fds[0], &st) < 0 || (size_t)st.st_size < need)
+		return NULL;
+
+	void* map = NULL;
+	if (tiled) {
+		// Copies show this buffer blank; the server shows it in place.
+		map = calloc(1, need);
+	} else {
+		map = mmap(NULL, need, PROT_READ | PROT_WRITE, MAP_SHARED, fds[0], 0);
+		if (map == MAP_FAILED)
+			map = NULL;
+	}
+	if (map == NULL)
+		return NULL;
+	#define V_UNMAP() do { if (tiled) free(map); else munmap(map, need); } while (0)
+
+	PixmapPtr pix = fbCreatePixmap(screen, 0, 0, depth, 0);
+	if (pix == NULL) {
+		V_UNMAP();
+		return NULL;
+	}
+	if (!(*screen->ModifyPixmapHeader)(pix, width, height, depth, bpp,
+			strides[0], (char*)map + offsets[0])) {
+		(*screen->DestroyPixmap)(pix);
+		V_UNMAP();
+		return NULL;
+	}
+
+	int dup = fcntl(fds[0], F_DUPFD_CLOEXEC, 3);
+	if (dup < 0) {
+		(*screen->DestroyPixmap)(pix);
+		V_UNMAP();
+		return NULL;
+	}
+
+	VDmabuf* buf = vDmabuf(pix);
+	buf->fd = dup;
+	buf->map = tiled ? NULL : map;
+	buf->mapSize = need;
+	buf->offset = offsets[0];
+	buf->tiled = tiled;
+	buf->flipWindow = 0;
+	buf->syncing = false;
+	if (tiled) {
+		// The pages live in the pixmap's own storage until it is freed.
+		pix->devPrivate.ptr = (char*)map + offsets[0];
+		buf->map = NULL;
+		buf->shadow = map;
+	} else {
+		vDmabufSync(buf, DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ);
+		buf->syncing = true;
+		vTrackImport(buf, true);
+	}
+	#undef V_UNMAP
+	return pix;
+}
+
+
+static int
+vFdsFromPixmap(ScreenPtr /*screen*/, PixmapPtr pix, int* fds,
+	uint32_t* strides, uint32_t* offsets, uint64_t* modifier)
+{
+	VDmabuf* buf = vDmabuf(pix);
+	if (buf->fd <= 0 || buf->map == NULL)
+		return 0;
+	int dup = fcntl(buf->fd, F_DUPFD_CLOEXEC, 3);
+	if (dup < 0)
+		return 0;
+	fds[0] = dup;
+	strides[0] = pix->devKind;
+	offsets[0] = (uint32_t)((char*)pix->devPrivate.ptr - (char*)buf->map);
+	*modifier = kModLinear;
+	return 1;
+}
+
+
+static Bool
+vGetFormats(ScreenPtr /*screen*/, CARD32* count, CARD32** formats)
+{
+	CARD32* list = (CARD32*)malloc(2 * sizeof(CARD32));
+	if (list == NULL)
+		return FALSE;
+	list[0] = kFormatXRGB8888;
+	list[1] = kFormatARGB8888;
+	*count = 2;
+	*formats = list;
+	return TRUE;
+}
+
+
+static Bool
+vModifiers(uint32_t format, uint32_t* count, uint64_t** modifiers)
+{
+	if (format != kFormatXRGB8888 && format != kFormatARGB8888)
+		return FALSE;
+	uint64_t* list = (uint64_t*)malloc(sizeof(uint64_t));
+	if (list == NULL)
+		return FALSE;
+	list[0] = kModLinear;
+	*count = 1;
+	*modifiers = list;
+	return TRUE;
+}
+
+
+static Bool
+vGetModifiers(ScreenPtr /*screen*/, uint32_t format, uint32_t* count,
+	uint64_t** modifiers)
+{
+	return vModifiers(format, count, modifiers);
+}
+
+
+static Bool
+vGetDrawableModifiers(DrawablePtr /*draw*/, uint32_t format, uint32_t* count,
+	uint64_t** modifiers)
+{
+	return vModifiers(format, count, modifiers);
+}
