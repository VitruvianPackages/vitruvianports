+
+// Off the startup path so a slow reply cannot delay the first client.
+static int32
+vAddonThread(void*)
+{
+	if (gVAddon != NULL)
+		return 0;
+
+	OutputAddonClient* addon = new(std::nothrow) OutputAddonClient();
+	if (addon == NULL)
+		return 0;
+
+	if (addon->Connect("XVitruvian X server") != B_OK) {
+		delete addon;
+		return 0;
+	}
+	gVAddon = addon;
+	return 0;
+}
+
+
+static void
+vConnectAddon()
+{
+	thread_id thread = spawn_thread(vAddonThread, "xv addon",
+		B_NORMAL_PRIORITY, NULL);
+	if (thread >= B_OK)
+		resume_thread(thread);
+}
