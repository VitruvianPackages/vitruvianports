+
+static Bool
+vScreenInit(ScreenPtr pScreen, int argc, char** argv)
+{
+	int dpix = monitorResolution;
+	int dpiy = monitorResolution;
+	if (dpix == 0)
+		dpix = 96;
+	if (dpiy == 0)
+		dpiy = 96;
+
+	BScreen screen(0);
+	BRect frame = screen.Frame();
+	int width = (int)frame.IntegerWidth() + 1;
+	int height = (int)frame.IntegerHeight() + 1;
+
+	// Invisible root backing; the screen itself is never blitted. Each
+	// toplevel window gets its own pixmap through fb's window handling.
+	char* pbits = (char*)calloc((size_t)width * height, 4);
+	if (pbits == NULL)
+		return FALSE;
+	sRootBits = pbits;
+	sRootSize = (size_t)width * height * 4;
+
+	if (!miSetVisualTypesAndMasks(24, 1 << TrueColor, 8, TrueColor,
+			0xff0000, 0x00ff00, 0x0000ff)
+		|| !miSetPixmapDepths())
+		return FALSE;
+
+	if (!fbScreenInit(pScreen, pbits, width, height, dpix, dpiy,
+			width, 32))
+		return FALSE;
+
+	fbPictureInit(pScreen, 0, 0);
+	ShmRegisterFuncs(pScreen, &sShmFuncs);
+
+	pScreen->CreateWindow = VCreateWindow;
+	pScreen->DestroyWindow = VDestroyWindow;
+	pScreen->RealizeWindow = VRealizeWindow;
+	pScreen->UnrealizeWindow = VUnrealizeWindow;
+	pScreen->PositionWindow = VPositionWindow;
+	pScreen->ChangeWindowAttributes = VChangeWindowAttributes;
+
+	pScreen->CloseScreen = vCloseScreen;
+
+	// Same convention as Xvfb: the default colormap maps these indices.
+	pScreen->blackPixel = 0;
+	pScreen->whitePixel = 1;
+
+	pScreen->InstallColormap = miInstallColormap;
+	pScreen->UninstallColormap = miUninstallColormap;
+	pScreen->ListInstalledColormaps = miListInstalledColormaps;
+	pScreen->ResolveColor = miResolveColor;
+	if (!fbCreateDefColormap(pScreen))
+		return FALSE;
+
+	if (!miPointerInitialize(pScreen, &vSpriteFuncs, &vPointerCursorFuncs,
+			FALSE))
+		return FALSE;
+
+	return TRUE;
+}
