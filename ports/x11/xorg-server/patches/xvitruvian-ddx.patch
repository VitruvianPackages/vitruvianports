+
+static void
+vTrimQuoted(char* value)
+{
+	char* start = strchr(value, '"');
+	if (start == NULL)
+		return;
+	char* end = strrchr(value, '"');
+	if (end == NULL || end <= start)
+		return;
+	*end = '\0';
+	memmove(value, start + 1, strlen(start));
+}
+
+
+static void
+vReadXkbSetting(const char* path, const char* key, char* out, size_t outSize)
+{
+	out[0] = '\0';
+
+	FILE* file = fopen(path, "r");
+	if (file == NULL)
+		return;
+
+	char line[512];
+	size_t keyLength = strlen(key);
+	while (fgets(line, sizeof(line), file) != NULL) {
+		if (strncmp(line, key, keyLength) != 0 || line[keyLength] != '=')
+			continue;
+		char* value = line + keyLength + 1;
+		value[strcspn(value, "\n")] = '\0';
+		vTrimQuoted(value);
+		snprintf(out, outSize, "%s", value);
+		break;
+	}
+
+	fclose(file);
+}
+
+
+static BLocker sRoleLock("xv roles");
+static char sRoleOptions[64];
+
+
+// Application thread: reads the Ctrl/Alt roles from input_server (never
+// from the X thread) and caches the matching xkb option. Linux mode needs
+// none; classic mode swaps Alt and Ctrl for X clients.
+void
+VKeymapRefresh()
+{
+	uint32 command = 0;
+	uint32 control = 0;
+	char options[sizeof(sRoleOptions)] = "";
+	if (get_modifier_key(B_LEFT_COMMAND_KEY, &command) == B_OK
+		&& get_modifier_key(B_LEFT_CONTROL_KEY, &control) == B_OK
+		&& command == 0x5d && control == 0x5c) {
+		strlcpy(options, "ctrl:swap_lalt_lctl", sizeof(options));
+	}
+
+	BAutolock locker(sRoleLock);
+	strlcpy(sRoleOptions, options, sizeof(sRoleOptions));
+}
+
+
+// Appends the role option to the layout's options unless already there.
+static void
+vMergeRoleOptions(char* options, size_t size)
+{
+	char role[sizeof(sRoleOptions)];
+	{
+		BAutolock locker(sRoleLock);
+		strlcpy(role, sRoleOptions, sizeof(role));
+	}
+	if (role[0] == '\0')
+		return;
+
+	for (const char* p = options; *p != '\0';) {
+		size_t length = strcspn(p, ",");
+		if (length == strlen(role) && strncmp(p, role, length) == 0)
+			return;
+		p += length + (p[length] == ',' ? 1 : 0);
+	}
+	if (options[0] != '\0')
+		strlcat(options, ",", size);
+	strlcat(options, role, size);
+}
+
+
+static void
+vFillRMLVO(XkbRMLVOSet* rmlvo)
+{
+	static char rules[] = "evdev";
+	static char model[64];
+	static char layout[64];
+	static char variant[128];
+	static char options[256];
+
+	// Same order as input_server: the Keymap preflet's cache, then the
+	// system default written at first boot.
+	BPath cache;
+	if (find_directory(B_USER_SETTINGS_DIRECTORY, &cache) == B_OK
+		&& cache.Append("input/xkb_layout") == B_OK) {
+		vReadXkbSetting(cache.Path(), "model", model, sizeof(model));
+		vReadXkbSetting(cache.Path(), "layout", layout, sizeof(layout));
+		vReadXkbSetting(cache.Path(), "variant", variant, sizeof(variant));
+		vReadXkbSetting(cache.Path(), "options", options, sizeof(options));
+	}
+	if (layout[0] == '\0') {
+		const char* path = "/etc/default/keyboard";
+		vReadXkbSetting(path, "XKBMODEL", model, sizeof(model));
+		vReadXkbSetting(path, "XKBLAYOUT", layout, sizeof(layout));
+		vReadXkbSetting(path, "XKBVARIANT", variant, sizeof(variant));
+		vReadXkbSetting(path, "XKBOPTIONS", options, sizeof(options));
+	}
+
+	vMergeRoleOptions(options, sizeof(options));
+
+	rmlvo->rules = rules;
+	rmlvo->model = model[0] != '\0' ? model : (char*)"pc105";
+	rmlvo->layout = layout[0] != '\0' ? layout : (char*)"us";
+	rmlvo->variant = variant;
+	rmlvo->options = options;
+}
