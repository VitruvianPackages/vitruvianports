+
+// Rootless window lane: every realized X toplevel owns a BSurface. Damage
+// on the X pixmap is copied into the surface buffer and presented; the
+// surface events arrive on a notify fd, so all of it runs on the server
+// thread.
+
+#ifdef HAVE_DIX_CONFIG_H
+#include <dix-config.h>
+#endif
+
+#include "vPriv.h"
+
+#include <X11/Xatom.h>
+
+#include <AppDefs.h>
+#include <Bitmap.h>
+#include <Message.h>
+#include <Point.h>
+#include <Deskbar.h>
+#include <Rect.h>
+#include <Region.h>
+#include <Screen.h>
+#include <String.h>
+#include <Surface.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <new>
+
+
+static int32 sWindowSerial = 0;
+
+
+// misc.h defines min/max macros that break the std versions.
+static inline int32
+vMaxI(int32 a, int32 b)
+{
+	return a > b ? a : b;
+}
+
+
+static inline int32
+vMinI(int32 a, int32 b)
+{
+	return a < b ? a : b;
+}
+
+
+static Atom
+vAtom(const char* name)
+{
+	return MakeAtom(name, strlen(name), TRUE);
+}
+
+
+static WindowPtr
+vLookupWindow(Window window)
+{
+	WindowPtr pWin = NULL;
+	if (dixLookupWindow(&pWin, window, serverClient, DixReadAccess)
+			!= Success)
+		return NULL;
+	return pWin;
+}
+
+
+static VWindowPriv*
+vPriv(WindowPtr pWin)
+{
+	if (pWin == NULL)
+		return NULL;
+	return (VWindowPriv*)dixGetPrivate(&pWin->devPrivates,
+		gVWindowPrivateKey);
+}
+
+
+// _NET_WM_PID when the client set one, else the connection's peer.
+static pid_t
+vClientPid(WindowPtr pWin)
+{
+	PropertyPtr prop = NULL;
+	if (dixLookupProperty(&prop, pWin, vAtom("_NET_WM_PID"), serverClient,
+			DixReadAccess) == Success && prop != NULL && prop->format == 32
+		&& prop->size >= 1 && prop->type == XA_CARDINAL) {
+		pid_t pid = (pid_t)(*(CARD32*)prop->data);
+		if (pid > 1)
+			return pid;
+	}
+	return GetClientPid(wClient(pWin));
+}
+
+
+// Hands the window's pid to the app thread, which resolves the team.
+void
+VWindowAttribute(WindowPtr pWin)
+{
+	pid_t pid = vClientPid(pWin);
+	if (pid > 0)
+		VPostWindowPid((uint32)pWin->drawable.id, (int32)pid);
+}
+
+
+void
+VWindowSetTeam(uint32 windowId, team_id team)
+{
+	VWindowPriv* priv = vPriv(vLookupWindow((Window)windowId));
+	if (priv != NULL && priv->surface != NULL && team > 0)
+		priv->surface->SetTeam(team);
+}
+
+
+VWindowPriv*
+VWindowPrivFor(WindowPtr pWin)
+{
+	return vPriv(pWin);
+}
+
+
+WindowPtr
+VWindowForId(uint32 id)
+{
+	return vLookupWindow((Window)id);
+}
+
+
+// Reads an atom-list property into outAtoms; returns the item count or
+// -1 when the property is absent or of the wrong type.
+static int
+vReadAtomList(WindowPtr pWin, Atom property, Atom* outAtoms, int maxAtoms)
+{
+	PropertyPtr prop = NULL;
+	if (dixLookupProperty(&prop, pWin, property, serverClient,
+			DixReadAccess) != Success || prop == NULL)
+		return -1;
+	if (prop->type != XA_ATOM || prop->format != 32)
+		return -1;
+
+	int count = (int)prop->size;
+	if (count > maxAtoms)
+		count = maxAtoms;
+	memcpy(outAtoms, prop->data, (size_t)count * sizeof(Atom));
+	return count;
+}
+
+
+static bool
+vWindowHasAtom(WindowPtr pWin, Atom property, Atom wanted)
+{
+	Atom atoms[64];
+	int count = vReadAtomList(pWin, property, atoms, 64);
+	for (int i = 0; i < count; i++) {
+		if (atoms[i] == wanted)
+			return true;
+	}
+	return false;
+}
+
+
+// Rounds a size to the client's WM_NORMAL_HINTS steps and minimum, as a
+// window manager does, so clients like terminals don't snap it back.
+static void
+vApplySizeHints(WindowPtr pWin, int32* width, int32* height)
+{
+	PropertyPtr prop = NULL;
+	if (dixLookupProperty(&prop, pWin, XA_WM_NORMAL_HINTS, serverClient,
+			DixReadAccess) != Success || prop == NULL || prop->format != 32
+		|| prop->size < 15) {
+		return;
+	}
+
+	const CARD32* hints = (const CARD32*)prop->data;
+	const CARD32 kMinSize = 1 << 4;
+	const CARD32 kResizeInc = 1 << 6;
+	const CARD32 kBaseSize = 1 << 8;
+	CARD32 flags = hints[0];
+
+	int32 baseW = 0;
+	int32 baseH = 0;
+	if ((flags & kBaseSize) != 0 && prop->size >= 17) {
+		baseW = (int32)hints[15];
+		baseH = (int32)hints[16];
+	} else if ((flags & kMinSize) != 0) {
+		baseW = (int32)hints[5];
+		baseH = (int32)hints[6];
+	}
+
+	if ((flags & kResizeInc) != 0) {
+		int32 incW = (int32)hints[9];
+		int32 incH = (int32)hints[10];
+		if (incW > 1 && *width > baseW)
+			*width = baseW + (*width - baseW) / incW * incW;
+		if (incH > 1 && *height > baseH)
+			*height = baseH + (*height - baseH) / incH * incH;
+	}
+
+	if ((flags & kMinSize) != 0) {
+		*width = vMaxI(*width, (int32)hints[5]);
+		*height = vMaxI(*height, (int32)hints[6]);
+	}
+}
+
+
+static void vChangeNetStates(WindowPtr pWin, int action, Atom a, Atom b);
+static int vReadCards(WindowPtr pWin, Atom property, CARD32* out,
+	int maxItems);
+
+
+// Shadow margins a client-decorated window reserves around its content
+// (_GTK_FRAME_EXTENTS: left, right, top, bottom). Only the inset part
+// is shown on the surface; a fullscreen window keeps all of it.
+static void
+vReadCsdExtents(WindowPtr pWin, int32* out)
+{
+	out[0] = out[1] = out[2] = out[3] = 0;
+	CARD32 cards[4];
+	if (vReadCards(pWin, vAtom("_GTK_FRAME_EXTENTS"), cards, 4) < 4)
+		return;
+	if (vWindowHasAtom(pWin, vAtom("_NET_WM_STATE"),
+			vAtom("_NET_WM_STATE_FULLSCREEN")))
+		return;
+	int32 values[4];
+	for (int i = 0; i < 4; i++)
+		values[i] = vMinI((int32)cards[i], 1024);
+	if (values[0] + values[1] >= (int32)pWin->drawable.width
+		|| values[2] + values[3] >= (int32)pWin->drawable.height)
+		return;
+	memcpy(out, values, sizeof(values));
+}
+
+
+// The screen without the Deskbar.
+static BRect
+vWorkArea()
+{
+	BRect area = BScreen().Frame();
+	BDeskbar deskbar;
+	if (!deskbar.IsRunning())
+		return area;
+	BRect bar = deskbar.Frame();
+	if (!bar.IsValid() || bar.Width() < 1 || bar.Height() < 1)
+		return area;
+	if (bar.Width() >= area.Width() * 0.5f) {
+		if (bar.top <= area.top + 1)
+			area.top = vMaxI((int32)area.top, (int32)bar.bottom + 1);
+		else
+			area.bottom = vMinI((int32)area.bottom, (int32)bar.top - 1);
+	} else {
+		if (bar.left <= area.left + 1)
+			area.left = vMaxI((int32)area.left, (int32)bar.right + 1);
+		else
+			area.right = vMinI((int32)area.right, (int32)bar.left - 1);
+	}
+	return area;
+}
+
+
+// Keeps a new window's tab and border inside the work area, shrinking it
+// when it cannot fit.
+static void
+vClampToWorkArea(VWindowPriv* priv)
+{
+	BRect area = vWorkArea();
+	BRect frame = priv->surface->Frame();
+	float maxWidth = area.Width() - priv->extents[0] - priv->extents[1];
+	float maxHeight = area.Height() - priv->extents[2] - priv->extents[3];
+	if (frame.Width() > maxWidth || frame.Height() > maxHeight) {
+		priv->surface->ResizeTo(frame.Width() > maxWidth
+			? maxWidth : frame.Width(), frame.Height() > maxHeight
+			? maxHeight : frame.Height());
+		frame = priv->surface->Frame();
+	}
+
+	float left = frame.left;
+	float top = frame.top;
+	float minLeft = area.left + priv->extents[0];
+	float minTop = area.top + priv->extents[2];
+	float maxLeft = area.right - priv->extents[1] - frame.Width();
+	float maxTop = area.bottom - priv->extents[3] - frame.Height();
+	if (left > maxLeft)
+		left = maxLeft;
+	if (top > maxTop)
+		top = maxTop;
+	if (left < minLeft)
+		left = minLeft;
+	if (top < minTop)
+		top = minTop;
+	if (left != frame.left || top != frame.top)
+		priv->surface->MoveTo(BPoint(left, top));
+}
+
+
+// Puts the surface on the X window's content, less the shadow margins.
+static void
+vPlaceSurface(VWindowPriv* priv, WindowPtr pWin)
+{
+	BRect frame = priv->surface->Frame();
+	float width = (float)((int32)pWin->drawable.width - priv->csd[0]
+		- priv->csd[1]) - 1;
+	float height = (float)((int32)pWin->drawable.height - priv->csd[2]
+		- priv->csd[3]) - 1;
+	BPoint where(pWin->drawable.x + priv->csd[0],
+		pWin->drawable.y + priv->csd[2]);
+	if (frame.LeftTop() != where)
+		priv->surface->MoveTo(where);
+	if (frame.Width() != width || frame.Height() != height)
+		priv->surface->ResizeTo(width, height);
+}
+
+
+
+//	#pragma mark - interactive move and resize
+
+
+// _NET_WM_MOVERESIZE directions.
+enum {
+	kMoveResizeMove = 8,
+	kMoveResizeCancel = 11,
+};
+
+
+static void
+vDragEnd(VWindowPriv* priv)
+{
+	priv->dragMode = -1;
+}
+
+
+static void
+vDragStart(VWindowPriv* priv, float x, float y, int mode)
+{
+	BRect frame = priv->surface->Frame();
+	priv->dragMode = mode;
+	priv->dragX = x;
+	priv->dragY = y;
+	priv->dragFrame[0] = frame.left;
+	priv->dragFrame[1] = frame.top;
+	priv->dragFrame[2] = frame.right;
+	priv->dragFrame[3] = frame.bottom;
+}
+
+
+static void
+vDragUpdate(VWindowPriv* priv, BPoint where)
+{
+	float dx = where.x - priv->dragX;
+	float dy = where.y - priv->dragY;
+	float l = priv->dragFrame[0];
+	float t = priv->dragFrame[1];
+	float r = priv->dragFrame[2];
+	float b = priv->dragFrame[3];
+
+	int mode = priv->dragMode;
+	if (mode == kMoveResizeMove) {
+		l += dx;
+		r += dx;
+		t += dy;
+		b += dy;
+	} else {
+		// 0 TL, 1 T, 2 TR, 3 R, 4 BR, 5 B, 6 BL, 7 L
+		if (mode == 0 || mode == 6 || mode == 7)
+			l = vMinI((int32)(l + dx), (int32)r - 8);
+		if (mode == 2 || mode == 3 || mode == 4)
+			r = vMaxI((int32)(r + dx), (int32)l + 8);
+		if (mode == 0 || mode == 1 || mode == 2)
+			t = vMinI((int32)(t + dy), (int32)b - 8);
+		if (mode == 4 || mode == 5 || mode == 6)
+			b = vMaxI((int32)(b + dy), (int32)t + 8);
+	}
+
+	BRect frame = priv->surface->Frame();
+	if (frame.left != l || frame.top != t)
+		priv->surface->MoveTo(BPoint(l, t));
+	if (frame.Width() != r - l || frame.Height() != b - t)
+		priv->surface->ResizeTo(r - l, b - t);
+}
+
+
+//	#pragma mark - surface events
+
+
+// X picks the pointer's window from its own stacking: keep the window under
+// the pointer above the other managed windows, below any popup.
+static void
+vRaiseForInput(WindowPtr pWin)
+{
+	if (pWin == NULL || pWin->overrideRedirect || pWin->parent == NULL)
+		return;
+
+	WindowPtr top = pWin->parent->firstChild;
+	while (top != NULL && (top->overrideRedirect || !top->mapped))
+		top = top->nextSib;
+	if (top == NULL || top == pWin)
+		return;
+
+	XID values[2] = { top->drawable.id, Above };
+	ConfigureWindow(pWin, CWSibling | CWStackMode, values, serverClient);
+}
+
+
+// Runs on the server thread from the notify fd; nothing here needs a lock.
+static void
+vSurfaceNotify(int fd, int ready, void* data)
+{
+	VWindowPriv* priv = (VWindowPriv*)data;
+	BMessage event;
+	while (priv->surface != NULL && priv->surface->NextEvent(&event, 0) == B_OK) {
+		WindowPtr pWin = vLookupWindow(priv->xWindow);
+		if (event.what == B_MOUSE_MOVED)
+			VDndPointerMoved(event);
+		else if (event.what == _MESSAGE_DROPPED_ && event.WasDropped())
+			VDndDropped(event);
+		if (priv->dragMode >= 0) {
+			BPoint where;
+			if (event.what == B_MOUSE_MOVED
+				&& event.FindPoint("screen_where", &where) == B_OK) {
+				vDragUpdate(priv, where);
+				continue;
+			}
+			if (event.what == B_MOUSE_UP)
+				vDragEnd(priv);
+		}
+		switch (event.what) {
+			case B_WINDOW_MOVED:
+			{
+				BPoint where;
+				if (pWin != NULL && event.FindPoint("where", &where) == B_OK) {
+					// The native frame is the X content origin.
+					int bw = wBorderWidth(pWin);
+					XID values[2] = { (XID)((int32)where.x - bw - priv->csd[0]),
+						(XID)((int32)where.y - bw - priv->csd[2]) };
+					// A move X did not ask for is a tab drag: it is the
+					// outside click a menu waits for.
+					if (!pWin->overrideRedirect
+						&& ((int32)values[0] != pWin->drawable.x - bw
+							|| (int32)values[1] != pWin->drawable.y - bw))
+						VBreakPopupGrabs();
+					ConfigureWindow(pWin, CWX | CWY, values, wClient(pWin));
+				}
+				break;
+			}
+			case B_WINDOW_RESIZED:
+			{
+				// Frame width, i.e. one less than the pixel count.
+				int32 width = event.GetInt32("width", -1) + 1;
+				int32 height = event.GetInt32("height", -1) + 1;
+				if (pWin != NULL && width > 0 && height > 0) {
+					width += priv->csd[0] + priv->csd[1];
+					height += priv->csd[2] + priv->csd[3];
+					int32 requestedWidth = width;
+					int32 requestedHeight = height;
+					vApplySizeHints(pWin, &width, &height);
+					XID values[2] = { (XID)width, (XID)height };
+					ConfigureWindow(pWin, CWWidth | CWHeight, values,
+						wClient(pWin));
+					// A rounded size can equal the current X size, so no
+					// PositionWindow follows; correct the native frame here.
+					if (width != requestedWidth || height != requestedHeight) {
+						priv->surface->ResizeTo(
+							(float)(width - priv->csd[0] - priv->csd[1]) - 1,
+							(float)(height - priv->csd[2] - priv->csd[3]) - 1);
+					}
+				}
+				break;
+			}
+			case B_WINDOW_ACTIVATED:
+				if (event.GetBool("active", false))
+					vRaiseForInput(pWin);
+				VSetWindowFocus(priv->xWindow,
+					event.GetBool("active", false));
+				break;
+			case B_QUIT_REQUESTED:
+				VSendDeleteWindow(pWin);
+				break;
+			case B_ZOOM:
+				if (pWin != NULL) {
+					vChangeNetStates(pWin, priv->maxH && priv->maxV ? 0 : 1,
+						vAtom("_NET_WM_STATE_MAXIMIZED_HORZ"),
+						vAtom("_NET_WM_STATE_MAXIMIZED_VERT"));
+				}
+				break;
+			case B_MINIMIZE:
+			{
+				// Tab double click and Deskbar restore.
+				bool minimize;
+				if (event.FindBool("minimize", &minimize) == B_OK) {
+					priv->minimized = minimize;
+					priv->surface->Minimize(minimize);
+					if (pWin != NULL) {
+						vChangeNetStates(pWin, minimize ? 1 : 0,
+							vAtom("_NET_WM_STATE_HIDDEN"), None);
+					}
+				}
+				break;
+			}
+			case B_FONTS_UPDATED:
+			{
+				VOp op;
+				memset(&op, 0, sizeof(op));
+				op.what = kVOpSettingsChanged;
+				VEnqueueOp(op);
+				break;
+			}
+			case B_KEY_DOWN:
+			case B_KEY_UP:
+			case B_UNMAPPED_KEY_DOWN:
+			case B_UNMAPPED_KEY_UP:
+			case B_MOUSE_DOWN:
+			case B_MOUSE_UP:
+			case B_MOUSE_MOVED:
+			case B_MOUSE_WHEEL_CHANGED:
+				if (event.what == B_MOUSE_MOVED
+					&& event.HasInt32("_view_token"))
+					vRaiseForInput(pWin);
+				VHandleWindowInput(event);
+				break;
+			default:
+				break;
+		}
+	}
+}
+
+
+//	#pragma mark - damage upload
+
+
+// Damage is reported before the rendering op lands, so only queue here.
+static const int kMaxDirty = 256;
+static VWindowPriv* sDirty[kMaxDirty];
+static int sDirtyCount = 0;
+static bool sHandlerRegistered = false;
+
+
+static void
+vDamageReport(DamagePtr pDamage, RegionPtr pRegion, void* closure)
+{
+	// NonEmpty only reports again after DamageEmpty, so never drop one.
+	VWindowPriv* priv = (VWindowPriv*)closure;
+	if (priv == NULL || priv->dirty)
+		return;
+
+	if (sDirtyCount >= kMaxDirty)
+		return;
+
+	priv->dirty = true;
+	sDirty[sDirtyCount++] = priv;
+}
+
+
+static void
+vForgetDirty(VWindowPriv* priv)
+{
+	for (int i = 0; i < sDirtyCount; i++) {
+		if (sDirty[i] == priv) {
+			sDirty[i] = sDirty[--sDirtyCount];
+			break;
+		}
+	}
+	priv->dirty = false;
+}
+
+
+static void
+vFlushDamage(void* data, void* timeout)
+{
+	// Rendering for this request batch is complete by block time.
+	while (sDirtyCount > 0) {
+		VWindowPriv* priv = sDirty[--sDirtyCount];
+		priv->dirty = false;
+
+		if (priv->damage == NULL)
+			continue;
+
+		DamagePtr damage = (DamagePtr)priv->damage;
+		RegionPtr region = DamageRegion(damage);
+		int nRects = RegionNumRects(region);
+		BoxPtr rects = RegionRects(region);
+		// Window damage is kept relative to the window origin.
+		WindowPtr pWin = vLookupWindow(priv->xWindow);
+		if (pWin != NULL && priv->surface != NULL && priv->mapped
+			&& rects != NULL && nRects > 0) {
+			// X drew over a client buffer: put its picture back first.
+			const int flipped = VFlipRestore(priv, pWin, region);
+			if (flipped == 1) {
+				BoxRec whole = { 0, 0, (short)pWin->drawable.width,
+					(short)pWin->drawable.height };
+				VUploadWindowRegion(priv, &whole, 1, pWin->drawable.x,
+					pWin->drawable.y);
+			} else if (flipped == 0) {
+				VUploadWindowRegion(priv, rects, nRects, pWin->drawable.x,
+					pWin->drawable.y);
+			}
+		}
+
+		DamageEmpty(damage);
+	}
+}
+
+
+static void
+vWakeupNop(void* data, int result)
+{
+}
+
+
+// The damage layer destroys window damages itself on DestroyWindow.
+static void
+vDamageDestroy(DamagePtr pDamage, void* closure)
+{
+	VWindowPriv* priv = (VWindowPriv*)closure;
+	if (priv != NULL)
+		priv->damage = NULL;
+}
+
+
+void
+VUploadWindowRegion(VWindowPriv* priv, const BoxRec* rects, int n, int dx,
+	int dy)
+{
+	if (priv == NULL || priv->surface == NULL || gVScreen == NULL
+		|| rects == NULL || n <= 0)
+		return;
+
+	// Buffer() can change after Present(): fetch it once per flush.
+	BBitmap* buffer = priv->surface->Buffer();
+	if (buffer == NULL)
+		return;
+
+	WindowPtr pWin = vLookupWindow(priv->xWindow);
+	if (pWin == NULL)
+		return;
+
+	PixmapPtr pix = (*gVScreen->GetWindowPixmap)(pWin);
+	if (pix == NULL || pix->devPrivate.ptr == NULL)
+		return;
+
+	// Damage is in screen coordinates here; the per-window pixmap and the
+	// buffer are both addressed relative to their own origin.
+	int32 bw = buffer->Bounds().IntegerWidth() + 1;
+	int32 bh = buffer->Bounds().IntegerHeight() + 1;
+	int32 offX = pWin->drawable.x + priv->csd[0];
+	int32 offY = pWin->drawable.y + priv->csd[2];
+	int32 srcOffX = pix->screen_x;
+	int32 srcOffY = pix->screen_y;
+
+	int32 srcStride = pix->devKind;
+	uint8* srcBase = (uint8*)pix->devPrivate.ptr;
+	int32 dstStride = buffer->BytesPerRow();
+	uint8* dstBase = (uint8*)buffer->Bits();
+	if (dstBase == NULL)
+		return;
+
+	BRegion region;
+	for (int i = 0; i < n; i++) {
+		int32 x1 = vMaxI(vMaxI(rects[i].x1 + dx, offX), srcOffX);
+		int32 y1 = vMaxI(vMaxI(rects[i].y1 + dy, offY), srcOffY);
+		int32 x2 = vMinI(vMinI(rects[i].x2 + dx, offX + bw),
+			srcOffX + (int32)pix->drawable.width);
+		int32 y2 = vMinI(vMinI(rects[i].y2 + dy, offY + bh),
+			srcOffY + (int32)pix->drawable.height);
+
+		int32 width = x2 - x1;
+		int32 height = y2 - y1;
+		if (width <= 0 || height <= 0)
+			continue;
+
+		for (int32 y = 0; y < height; y++) {
+			memcpy(dstBase + (int64)(y1 - offY + y) * dstStride
+					+ (int64)(x1 - offX) * 4,
+				srcBase + (int64)(y1 - srcOffY + y) * srcStride
+					+ (int64)(x1 - srcOffX) * 4,
+				(size_t)width * 4);
+
+			// X leaves alpha at 0, which the compositor would treat as clear.
+			uint32* row = (uint32*)(dstBase
+				+ (int64)(y1 - offY + y) * dstStride + (int64)(x1 - offX) * 4);
+			for (int32 i = 0; i < width; i++)
+				row[i] |= 0xff000000;
+		}
+
+		region.Include(BRect(x1 - offX, y1 - offY, x2 - offX - 1,
+			y2 - offY - 1));
+	}
+
+	if (region.CountRects() > 0)
+		priv->surface->Present(region);
+}
+
+
+void
+VUploadWindowDamage(VWindowPriv* priv, int x1, int y1, int x2, int y2)
+{
+	BoxRec box = { (short)x1, (short)y1, (short)x2, (short)y2 };
+	VUploadWindowRegion(priv, &box, 1, 0, 0);
+}
