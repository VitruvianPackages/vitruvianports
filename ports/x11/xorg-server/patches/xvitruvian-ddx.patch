+
+void
+XVApp::ReadyToRun()
+{
+	be_clipboard->StartWatching(BMessenger(this));
+	// A client registers after it connects: re-attribute on each launch.
+	be_roster->StartWatching(BMessenger(this), B_REQUEST_LAUNCHED);
+	sAppMessenger = BMessenger(this);
+	sAppReady = true;
+	VSettingsRefresh();
+	VKeymapRefresh();
+	vConnectAddon();
+	{
+		// The first keymap was compiled before the roles were known.
+		VOp op;
+		memset(&op, 0, sizeof(op));
+		op.what = kVOpKeymapChanged;
+		VEnqueueOp(op);
+	}
+	VDndInit();
+}
+
+
+void
+XVApp::MessageReceived(BMessage* message)
+{
+	switch (message->what) {
+		case kMsgWindowPid:
+		{
+			int32 window, pid;
+			if (message->FindInt32("window", &window) != B_OK
+				|| message->FindInt32("pid", &pid) != B_OK) {
+				break;
+			}
+			VWindowTeam& entry = sWindowTeams[(uint32)window];
+			if (entry.pid != (pid_t)pid) {
+				entry.pid = (pid_t)pid;
+				entry.team = -1;
+			}
+			vAttributeWindow((uint32)window, entry);
+			break;
+		}
+		case kMsgWindowGone:
+		{
+			int32 window;
+			if (message->FindInt32("window", &window) == B_OK)
+				sWindowTeams.erase((uint32)window);
+			break;
+		}
+		case B_SOME_APP_LAUNCHED:
+		{
+			for (std::map<uint32, VWindowTeam>::iterator it
+					= sWindowTeams.begin(); it != sWindowTeams.end(); ++it) {
+				vAttributeWindow(it->first, it->second);
+			}
+			break;
+		}
+		case B_CLIPBOARD_CHANGED:
+		{
+			VOp op;
+			memset(&op, 0, sizeof(op));
+			op.what = kVOpClipboardChanged;
+			VEnqueueOp(op);
+			break;
+		}
+		case B_SCREEN_CHANGED:
+		{
+			BScreen screen(0);
+			BRect frame = screen.Frame();
+			VOp op;
+			op.what = kVOpScreenChanged;
+			op.windowId = 0;
+			op.i0 = (int32)frame.IntegerWidth() + 1;
+			op.i1 = (int32)frame.IntegerHeight() + 1;
+			op.i2 = 0;
+			op.i3 = 0;
+			VEnqueueOp(op);
+			break;
+		}
+		case B_COLORS_UPDATED:
+		case B_FONTS_UPDATED:
+		{
+			VSettingsRefresh();
+			VOp op;
+			memset(&op, 0, sizeof(op));
+			op.what = kVOpSettingsChanged;
+			VEnqueueOp(op);
+			BApplication::MessageReceived(message);
+			break;
+		}
+		case B_KEY_MAP_LOADED:
+		{
+			VKeymapRefresh();
+			VOp op;
+			memset(&op, 0, sizeof(op));
+			op.what = kVOpKeymapChanged;
+			VEnqueueOp(op);
+			break;
+		}
+		default:
+			BApplication::MessageReceived(message);
+			break;
+	}
+}
