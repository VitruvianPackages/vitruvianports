+static void
+vRandRScreenSize(ScreenPtr pScreen, int width, int height)
+{
+	rrScrPrivPtr pScrPriv = rrGetScrPriv(pScreen);
+	if (pScrPriv == NULL)
+		return;
+
+	SetRootClip(pScreen, ROOT_CLIP_NONE);
+	pScreen->width = width;
+	pScreen->height = height;
+	pScreen->mmWidth = (CARD32)width * 254 / (96 * 10);
+	pScreen->mmHeight = (CARD32)height * 254 / (96 * 10);
+	SetRootClip(pScreen, ROOT_CLIP_FULL);
+
+	RRScreenSizeNotify(pScreen);
+	RRTellChanged(pScreen);
+}
+
+
+// The root pixmap grows with the screen; anything drawing on the root
+// (background, root-window tools) must stay inside the allocation.
+void
+VResizeScreen(int width, int height)
+{
+	ScreenPtr pScreen = gVScreen;
+	if (pScreen == NULL || width <= 0 || height <= 0)
+		return;
+
+	PixmapPtr root = (*pScreen->GetScreenPixmap)(pScreen);
+	size_t size = (size_t)width * height * 4;
+	char* bits = NULL;
+	if (size > sRootSize) {
+		bits = (char*)calloc(size, 1);
+		if (bits == NULL)
+			return;
+	}
+	(*pScreen->ModifyPixmapHeader)(root, width, height, -1, -1, width * 4,
+		bits);
+	if (bits != NULL) {
+		free(sRootBits);
+		sRootBits = bits;
+		sRootSize = size;
+	}
+
+	vRandRScreenSize(pScreen, width, height);
+	VResizeValuators(pScreen);
+}
+
+
+void
+VResizeValuators(ScreenPtr pScreen)
+{
+	// Keep the XI2 pointer's absolute axes inside the new screen bounds.
+	for (DeviceIntPtr dev = inputInfo.devices; dev != NULL;
+			dev = dev->next) {
+		if (dev->valuator == NULL || dev->valuator->numAxes < 2)
+			continue;
+		dev->valuator->axes[0].max_value = pScreen->width - 1;
+		dev->valuator->axes[1].max_value = pScreen->height - 1;
+	}
+}
