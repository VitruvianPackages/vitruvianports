+//	#pragma mark - property observation
+
+
+// Connected clients, not counting one that is going away.
+static int
+VLiveClientCount()
+{
+	int count = 0;
+	for (int i = 1; i < currentMaxClients; i++) {
+		ClientPtr client = clients[i];
+		if (client != NULL && (client->clientState == ClientStateInitial
+				|| client->clientState == ClientStateRunning)) {
+			count++;
+		}
+	}
+	return count;
+}
+
+
+static void
+vPropertyCallback(CallbackListPtr* /*pcbl*/, void* /*arg*/, void* callData)
+{
+	PropertyStateRec* rec = (PropertyStateRec*)callData;
+	if (rec == NULL || rec->win == NULL || rec->prop == NULL)
+		return;
+
+	VClipboardPropertyChanged(rec->win, rec->prop, rec->state);
+	// A deleted property is being freed.
+	if (rec->state != PropertyDelete)
+		VWindowPropertyChanged(rec->win, rec->prop->propertyName);
+}
+
+
+static CARD32
+vIdleExit(OsTimerPtr /*timer*/, CARD32 /*now*/, void* /*arg*/)
+{
+	if (VLiveClientCount() == 0) {
+		ErrorF("XVitruvian: idle, exiting\n");
+		kill(getpid(), SIGTERM);
+	}
+	return 0;
+}
+
+
+static void
+vClientCallback(CallbackListPtr* /*pcbl*/, void* /*arg*/, void* callData)
+{
+	NewClientInfoRec* info = (NewClientInfoRec*)callData;
+	if (info != NULL && info->client->clientState == ClientStateRunning)
+		VSetupWindowManager();
+
+	if (sListenFd >= 0) {
+		sIdleTimer = TimerSet(sIdleTimer, 0,
+			VLiveClientCount() == 0 ? kIdleExitMs : 0, vIdleExit, NULL);
+	}
+}
