+
+static void vChangeNetState(WindowPtr pWin, int action, Atom wanted);
+
+
+//	#pragma mark - surface events
+
+
+// Runs on the server thread from the notify fd; nothing here needs a lock.
+static void
+vSurfaceNotify(int fd, int ready, void* data)
+{
+	VWindowPriv* priv = (VWindowPriv*)data;
+	BMessage event;
+	while (priv->surface != NULL && priv->surface->NextEvent(&event, 0) == B_OK) {
+		WindowPtr pWin = vLookupWindow(priv->xWindow);
+		if (event.what == B_MOUSE_MOVED)
+			VDndPointerMoved(event);
+		else if (event.what == _MESSAGE_DROPPED_ && event.WasDropped())
+			VDndDropped(event);
+		switch (event.what) {
+			case B_WINDOW_MOVED:
+			{
+				BPoint where;
+				if (pWin != NULL && event.FindPoint("where", &where) == B_OK) {
+					// The native frame is the X content origin.
+					int bw = wBorderWidth(pWin);
+					XID values[2] = { (XID)((int32)where.x - bw),
+						(XID)((int32)where.y - bw) };
+					ConfigureWindow(pWin, CWX | CWY, values, wClient(pWin));
+				}
+				break;
+			}
+			case B_WINDOW_RESIZED:
+			{
+				// Frame width, i.e. one less than the pixel count.
+				int32 width = event.GetInt32("width", -1) + 1;
+				int32 height = event.GetInt32("height", -1) + 1;
+				if (pWin != NULL && width > 0 && height > 0) {
+					int32 requestedWidth = width;
+					int32 requestedHeight = height;
+					vApplySizeHints(pWin, &width, &height);
+					XID values[2] = { (XID)width, (XID)height };
+					ConfigureWindow(pWin, CWWidth | CWHeight, values,
+						wClient(pWin));
+					// A rounded size can equal the current X size, so no
+					// PositionWindow follows; correct the native frame here.
+					if (width != requestedWidth || height != requestedHeight) {
+						priv->surface->ResizeTo((float)width - 1,
+							(float)height - 1);
+					}
+				}
+				break;
+			}
+			case B_WINDOW_ACTIVATED:
+				VSetWindowFocus(priv->xWindow,
+					event.GetBool("active", false));
+				break;
+			case B_QUIT_REQUESTED:
+				VSendDeleteWindow(pWin);
+				break;
+			case B_ZOOM:
+				vZoom(priv);
+				break;
+			case B_MINIMIZE:
+			{
+				// Tab double click and Deskbar restore.
+				bool minimize;
+				if (event.FindBool("minimize", &minimize) == B_OK) {
+					priv->surface->Minimize(minimize);
+					if (pWin != NULL) {
+						vChangeNetState(pWin, minimize ? 1 : 0,
+							vAtom("_NET_WM_STATE_HIDDEN"));
+					}
+				}
+				break;
+			}
+			case B_FONTS_UPDATED:
+			{
+				VOp op;
+				memset(&op, 0, sizeof(op));
+				op.what = kVOpSettingsChanged;
+				VEnqueueOp(op);
+				break;
+			}
+			case B_KEY_DOWN:
+			case B_KEY_UP:
+			case B_UNMAPPED_KEY_DOWN:
+			case B_UNMAPPED_KEY_UP:
+			case B_MOUSE_DOWN:
+			case B_MOUSE_UP:
+			case B_MOUSE_MOVED:
+			case B_MOUSE_WHEEL_CHANGED:
+				VHandleWindowInput(event);
+				break;
+			default:
+				break;
+		}
+	}
+}
+
+
+//	#pragma mark - damage upload
+
+
+// Damage is reported before the rendering op lands, so only queue here.
+static const int kMaxDirty = 256;
+static VWindowPriv* sDirty[kMaxDirty];
+static int sDirtyCount = 0;
+static bool sHandlerRegistered = false;
+
+
+static void
+vDamageReport(DamagePtr pDamage, RegionPtr pRegion, void* closure)
+{
+	// NonEmpty only reports again after DamageEmpty, so never drop one.
+	VWindowPriv* priv = (VWindowPriv*)closure;
+	if (priv == NULL || priv->dirty)
+		return;
+
+	if (sDirtyCount >= kMaxDirty)
+		return;
+
+	priv->dirty = true;
+	sDirty[sDirtyCount++] = priv;
+}
+
+
+static void
+vForgetDirty(VWindowPriv* priv)
+{
+	for (int i = 0; i < sDirtyCount; i++) {
+		if (sDirty[i] == priv) {
+			sDirty[i] = sDirty[--sDirtyCount];
+			break;
+		}
+	}
+	priv->dirty = false;
+}
+
+
+static void
+vFlushDamage(void* data, void* timeout)
+{
+	// Rendering for this request batch is complete by block time.
+	while (sDirtyCount > 0) {
+		VWindowPriv* priv = sDirty[--sDirtyCount];
+		priv->dirty = false;
+
+		if (priv->damage == NULL)
+			continue;
+
+		DamagePtr damage = (DamagePtr)priv->damage;
+		RegionPtr region = DamageRegion(damage);
+		int nRects = RegionNumRects(region);
+		BoxPtr rects = RegionRects(region);
+		// Window damage is kept relative to the window origin.
+		WindowPtr pWin = vLookupWindow(priv->xWindow);
+		if (pWin != NULL && priv->surface != NULL && priv->mapped
+			&& rects != NULL && nRects > 0) {
+			int dx = pWin->drawable.x;
+			int dy = pWin->drawable.y;
+			for (int i = 0; i < nRects; i++)
+				VUploadWindowDamage(priv, rects[i].x1 + dx, rects[i].y1 + dy,
+					rects[i].x2 + dx, rects[i].y2 + dy);
+		}
+
+		DamageEmpty(damage);
+	}
+}
+
+
+static void
+vWakeupNop(void* data, int result)
+{
+}
+
+
+// The damage layer destroys window damages itself on DestroyWindow.
+static void
+vDamageDestroy(DamagePtr pDamage, void* closure)
+{
+	VWindowPriv* priv = (VWindowPriv*)closure;
+	if (priv != NULL)
+		priv->damage = NULL;
+}
+
+
+void
+VUploadWindowDamage(VWindowPriv* priv, int x1, int y1, int x2, int y2)
+{
+	if (priv == NULL || priv->surface == NULL || gVScreen == NULL)
+		return;
+
+	BBitmap* buffer = priv->surface->Buffer();
+	if (buffer == NULL)
+		return;
+
+	WindowPtr pWin = vLookupWindow(priv->xWindow);
+	if (pWin == NULL)
+		return;
+
+	PixmapPtr pix = (*gVScreen->GetWindowPixmap)(pWin);
+	if (pix == NULL || pix->devPrivate.ptr == NULL)
+		return;
+
+	// Damage is in screen coordinates here; the per-window pixmap and the
+	// buffer are both addressed relative to their own origin.
+	int32 bw = buffer->Bounds().IntegerWidth() + 1;
+	int32 bh = buffer->Bounds().IntegerHeight() + 1;
+	int32 offX = pWin->drawable.x;
+	int32 offY = pWin->drawable.y;
+	int32 srcOffX = pix->screen_x;
+	int32 srcOffY = pix->screen_y;
+
+	x1 = vMaxI(vMaxI(x1, offX), srcOffX);
+	y1 = vMaxI(vMaxI(y1, offY), srcOffY);
+	x2 = vMinI(vMinI(x2, offX + bw), srcOffX + (int32)pix->drawable.width);
+	y2 = vMinI(vMinI(y2, offY + bh), srcOffY + (int32)pix->drawable.height);
+
+	int32 width = x2 - x1;
+	int32 height = y2 - y1;
+	if (width <= 0 || height <= 0)
+		return;
+
+	int32 srcStride = pix->devKind;
+	uint8* srcBase = (uint8*)pix->devPrivate.ptr;
+	int32 dstStride = buffer->BytesPerRow();
+	uint8* dstBase = (uint8*)buffer->Bits();
+	if (dstBase == NULL)
+		return;
+
+	for (int32 y = 0; y < height; y++) {
+		memcpy(dstBase + (int64)(y1 - offY + y) * dstStride
+				+ (int64)(x1 - offX) * 4,
+			srcBase + (int64)(y1 - srcOffY + y) * srcStride
+				+ (int64)(x1 - srcOffX) * 4,
+			(size_t)width * 4);
+
+		// X leaves alpha at 0, which the compositor would treat as clear.
+		uint32* row = (uint32*)(dstBase + (int64)(y1 - offY + y) * dstStride
+			+ (int64)(x1 - offX) * 4);
+		for (int32 i = 0; i < width; i++)
+			row[i] |= 0xff000000;
+	}
+
+	x1 -= offX;
+	x2 -= offX;
+	y1 -= offY;
+	y2 -= offY;
+
+	priv->surface->Present(BRect(x1, y1, x2 - 1, y2 - 1));
+}
+
+
+//	#pragma mark - WM properties
+
+
+void
+VSyncWindowTitle(VWindowPriv* priv)
+{
+	if (priv == NULL || priv->surface == NULL)
+		return;
+
+	WindowPtr pWin = vLookupWindow(priv->xWindow);
+	if (pWin == NULL)
+		return;
+
+	Atom utf8Atom = vAtom("UTF8_STRING");
+	Atom netName = vAtom("_NET_WM_NAME");
+
+	// Property data carries no terminator.
+	BString title;
+	PropertyPtr prop = NULL;
+	if (dixLookupProperty(&prop, pWin, netName, serverClient,
+			DixReadAccess) == Success && prop != NULL
+		&& prop->format == 8 && prop->size > 0
+		&& (prop->type == utf8Atom || prop->type == XA_STRING)) {
+		title.SetTo((const char*)prop->data, prop->size);
+	}
+
+	if (title.IsEmpty() && dixLookupProperty(&prop, pWin, XA_WM_NAME,
+			serverClient, DixReadAccess) == Success && prop != NULL
+		&& prop->format == 8 && prop->size > 0) {
+		title.SetTo((const char*)prop->data, prop->size);
+	}
+
+	if (!title.IsEmpty())
+		priv->surface->SetTitle(title.String());
+}
+
+
+void
+VApplyWindowState(VWindowPriv* priv)
+{
+	if (priv == NULL || priv->surface == NULL)
+		return;
+
+	WindowPtr pWin = vLookupWindow(priv->xWindow);
+	if (pWin == NULL)
+		return;
+
+	if (priv->topLevel && pWin->overrideRedirect) {
+		priv->surface->SetLook(B_NO_BORDER_WINDOW_LOOK);
+		priv->surface->SetFeel(B_FLOATING_APP_WINDOW_FEEL);
+		priv->surface->SetFlags(B_AVOID_FOCUS);
+		return;
+	}
+
+	Atom state = vAtom("_NET_WM_STATE");
+	Atom full = vAtom("_NET_WM_STATE_FULLSCREEN");
+	if (vWindowHasAtom(pWin, state, full)) {
+		if (priv->fullscreen)
+			return;
+		// V\OS has no fullscreen look; borderless plus screen-sized
+		// frame is the native equivalent for an X client's request.
+		// The frame is saved the way zoom does, to undo it later.
+		BRect frame = priv->surface->Frame();
+		priv->restoreX = (int32)frame.left;
+		priv->restoreY = (int32)frame.top;
+		priv->restoreWidth = frame.IntegerWidth();
+		priv->restoreHeight = frame.IntegerHeight();
+		priv->fullscreen = true;
+		priv->surface->SetLook(B_NO_BORDER_WINDOW_LOOK);
+		priv->surface->Activate();
+		if (gVScreen != NULL) {
+			priv->surface->MoveTo(B_ORIGIN);
+			priv->surface->ResizeTo((float)gVScreen->width - 1,
+				(float)gVScreen->height - 1);
+		}
+	} else if (priv->fullscreen) {
+		priv->fullscreen = false;
+		priv->zoomed = false;
+		priv->surface->SetLook(B_TITLED_WINDOW_LOOK);
+		priv->surface->MoveTo(BPoint(priv->restoreX, priv->restoreY));
+		priv->surface->ResizeTo(priv->restoreWidth, priv->restoreHeight);
+	}
+}
+
+
+void
+VWindowPropertyChanged(WindowPtr pWin, Atom prop)
+{
+	VWindowPriv* priv = vPriv(pWin);
+	if (priv == NULL || priv->surface == NULL)
+		return;
+
+	Atom netName = vAtom("_NET_WM_NAME");
+	Atom state = vAtom("_NET_WM_STATE");
+
+	if (prop == XA_WM_NAME || prop == netName)
+		VSyncWindowTitle(priv);
+	else if (prop == state)
+		VApplyWindowState(priv);
+	else if (prop == vAtom("_NET_WM_PID"))
+		VWindowAttribute(pWin);
+}
+
+
+static void
+vSetAtomList(WindowPtr pWin, Atom property, Atom* atoms, int count)
+{
+	dixChangeWindowProperty(serverClient, pWin, property, XA_ATOM, 32,
+		PropModeReplace, count, atoms, TRUE);
+}
+
+
+// Applies one _NET_WM_STATE client message item to the window property;
+// the property observer then does the native work.
+static void
+vChangeNetState(WindowPtr pWin, int action, Atom wanted)
+{
+	if (wanted == None)
+		return;
+
+	Atom state = vAtom("_NET_WM_STATE");
+	Atom atoms[65];
+	int count = vReadAtomList(pWin, state, atoms, 64);
+	if (count < 0)
+		count = 0;
+
+	int index = -1;
+	for (int i = 0; i < count; i++) {
+		if (atoms[i] == wanted)
+			index = i;
+	}
+
+	bool add = action == 1 || (action == 2 && index < 0);
+	if (add && index < 0)
+		atoms[count++] = wanted;
+	else if (!add && index >= 0)
+		atoms[index] = atoms[--count];
+	else
+		return;
+
+	vSetAtomList(pWin, state, atoms, count);
+}
+
+
+static int (*sRealSendEvent)(ClientPtr client) = NULL;
+
+
+// There is no window manager: requests clients address to the root are
+// answered here.
+static int
+vSendEvent(ClientPtr client)
+{
+	REQUEST(xSendEventReq);
+	WindowPtr bridge = VClipboardWindow();
+	if (!client->swapped && bridge != NULL
+		&& client->req_len >= bytes_to_int32(sizeof(xSendEventReq))
+		&& stuff->destination == bridge->drawable.id
+		&& VDndSendEvent(&stuff->event))
+		return Success;
+
+	if (client->swapped || client->req_len < bytes_to_int32(sizeof(xSendEventReq))
+		|| gVScreen == NULL
+		|| stuff->destination != gVScreen->root->drawable.id
+		|| (stuff->event.u.u.type & 0x7f) != ClientMessage)
+		return sRealSendEvent(client);
+
+	auto* message = &stuff->event.u.clientMessage;
+
+	WindowPtr pWin = vLookupWindow(message->window);
+	if (pWin == NULL || message->u.l.type == None)
+		return sRealSendEvent(client);
+
+	if (message->u.l.type == vAtom("_NET_WM_STATE")) {
+		int action = (int)message->u.l.longs0;
+		vChangeNetState(pWin, action, (Atom)message->u.l.longs1);
+		vChangeNetState(pWin, action, (Atom)message->u.l.longs2);
+		return Success;
+	}
+
+	if (message->u.l.type == vAtom("_NET_ACTIVE_WINDOW")) {
+		VWindowPriv* priv = vPriv(pWin);
+		if (priv != NULL && priv->surface != NULL && priv->mapped)
+			priv->surface->Activate();
+		return Success;
+	}
+
+	return sRealSendEvent(client);
+}
+
+
+void
+VSetupWindowManager()
+{
+	if (gVScreen == NULL || gVScreen->root == NULL)
+		return;
+
+	WindowPtr root = gVScreen->root;
+	static bool hooked = false;
+	if (!hooked) {
+		hooked = true;
+		sRealSendEvent = ProcVector[X_SendEvent];
+		ProcVector[X_SendEvent] = vSendEvent;
+	}
+
+	VSettingsUpdate();
+	VClipboardInit();
+
+	PropertyPtr existing = NULL;
+	if (dixLookupProperty(&existing, root, vAtom("_NET_SUPPORTED"),
+			serverClient, DixReadAccess) == Success)
+		return;
+
+	Atom supported[] = {
+		vAtom("_NET_SUPPORTED"), vAtom("_NET_SUPPORTING_WM_CHECK"),
+		vAtom("_NET_WM_STATE"), vAtom("_NET_WM_STATE_FULLSCREEN"),
+		vAtom("_NET_WM_STATE_HIDDEN"), vAtom("_NET_ACTIVE_WINDOW"),
+		vAtom("_NET_WM_NAME")
+	};
+	vSetAtomList(root, vAtom("_NET_SUPPORTED"), supported,
+		sizeof(supported) / sizeof(supported[0]));
+
+	// The root doubles as the check window.
+	CARD32 id = root->drawable.id;
+	Atom check = vAtom("_NET_SUPPORTING_WM_CHECK");
+	dixChangeWindowProperty(serverClient, root, check, XA_WINDOW, 32,
+		PropModeReplace, 1, &id, TRUE);
+	const char* name = "XVitruvian";
+	dixChangeWindowProperty(serverClient, root, vAtom("_NET_WM_NAME"),
+		vAtom("UTF8_STRING"), 8, PropModeReplace, strlen(name), (void*)name,
+		TRUE);
+}
+
+
+void
+VSendDeleteWindow(WindowPtr pWin)
+{
+	if (pWin == NULL)
+		return;
+
+	Atom protocols = vAtom("WM_PROTOCOLS");
+	Atom deleteWindow = vAtom("WM_DELETE_WINDOW");
+	if (!vWindowHasAtom(pWin, protocols, deleteWindow)) {
+		// No polite way to ask; disconnect the client like a window
+		// manager's kill.
+		ClientPtr client = wClient(pWin);
+		if (client != NULL && client != serverClient)
+			CloseDownClient(client);
+		return;
+	}
+
+	xEvent event;
+	memset(&event, 0, sizeof(event));
+	event.u.u.type = ClientMessage;
+	event.u.u.detail = 32;
+	event.u.clientMessage.window = pWin->drawable.id;
+	event.u.clientMessage.u.l.type = protocols;
+	event.u.clientMessage.u.l.longs0 = deleteWindow;
+	event.u.clientMessage.u.l.longs1 = CurrentTime;
+	DeliverEvents(pWin, &event, 1, (WindowPtr)NULL);
+}
+
+
+//	#pragma mark - screen procs
+
+
+Bool
+VCreateWindow(WindowPtr pWin)
+{
+	VWindowPriv* priv = (VWindowPriv*)calloc(1, sizeof(VWindowPriv));
+	if (priv == NULL)
+		return FALSE;
+
+	priv->xWindow = pWin->drawable.id;
+	dixSetPrivate(&pWin->devPrivates, gVWindowPrivateKey, priv);
+
+	return fbCreateWindow(pWin);
+}
+
+
+Bool
+VDestroyWindow(WindowPtr pWin)
+{
+	VWindowPriv* priv = vPriv(pWin);
+	if (priv != NULL) {
+		vForgetDirty(priv);
+		if (priv->damage != NULL) {
+			DamageUnregister((DamagePtr)priv->damage);
+			DamageDestroy((DamagePtr)priv->damage);
+			priv->damage = NULL;
+		}
+
+		if (priv->surface != NULL) {
+			VPostWindowGone((uint32)pWin->drawable.id);
+			RemoveNotifyFd(priv->fd);
+			close(priv->fd);
+			delete priv->surface;
+			priv->surface = NULL;
+		}
+
+		free(priv);
+		dixSetPrivate(&pWin->devPrivates, gVWindowPrivateKey, NULL);
+	}
+
+	return fbDestroyWindow(pWin);
+}
+
+
+Bool
+VRealizeWindow(WindowPtr pWin)
+{
+	// InputOnly windows have no content to show.
+	bool topLevel = pWin->parent != NULL && pWin->parent->parent == NULL
+		&& pWin->drawable.class_ != InputOnly;
+
+	if (!fbRealizeWindow(pWin))
+		return FALSE;
+
+	// After the realize so the pixmap is allocated for a mapped window.
+	if (topLevel && pWin->redirectDraw != RedirectDrawManual)
+		compRedirectWindow(serverClient, pWin, CompositeRedirectManual);
+
+	VWindowPriv* priv = vPriv(pWin);
+	if (priv == NULL)
+		return TRUE;
+
+	if (topLevel) {
+		priv->topLevel = true;
+		priv->x = pWin->drawable.x;
+		priv->y = pWin->drawable.y;
+		priv->width = pWin->drawable.width;
+		priv->height = pWin->drawable.height;
+		priv->serial = atomic_add(&sWindowSerial, 1) + 1;
+
+		BRect frame(priv->x, priv->y, priv->x + priv->width - 1,
+			priv->y + priv->height - 1);
+		const char* title = "X11";
+
+		window_look look = B_TITLED_WINDOW_LOOK;
+		window_feel feel = B_NORMAL_WINDOW_FEEL;
+		if (pWin->overrideRedirect) {
+			look = B_NO_BORDER_WINDOW_LOOK;
+			feel = B_FLOATING_APP_WINDOW_FEEL;
+		}
+
+		if (priv->surface == NULL) {
+			BSurface* surface = new(std::nothrow) BSurface(frame, title,
+				look, feel, 0);
+			if (surface == NULL || surface->InitCheck() != B_OK) {
+				delete surface;
+				return TRUE;
+			}
+			int fd = port_to_fd(surface->EventPort());
+			if (fd < 0) {
+				delete surface;
+				return TRUE;
+			}
+			// X clients track the pointer outside their own windows too.
+			surface->SetEventMask(B_POINTER_EVENTS, B_NO_POINTER_HISTORY);
+			// Listed under the client until the app thread finds its
+			// registered team (Deskbar, roster).
+			pid_t pid = vClientPid(pWin);
+			if (pid > 0)
+				surface->SetTeam((team_id)pid);
+			priv->surface = surface;
+			priv->fd = fd;
+			SetNotifyFd(fd, vSurfaceNotify, X_NOTIFY_READ, priv);
+
+			DamagePtr damage = DamageCreate(vDamageReport, vDamageDestroy,
+				DamageReportNonEmpty, TRUE, pWin->drawable.pScreen, priv);
+			if (damage != NULL) {
+				DamageRegister(&pWin->drawable, damage);
+				priv->damage = damage;
+			}
+		} else {
+			priv->surface->MoveTo(frame.LeftTop());
+			priv->surface->ResizeTo(frame.Width(), frame.Height());
+		}
+
+		VSyncWindowTitle(priv);
+		VApplyWindowState(priv);
+
+		// A window at the origin would hide its tab off screen; Xt and
+		// others ask for 0,0 even with no real preference, so cascade it
+		// like a window manager would. The B_WINDOW_MOVED that follows
+		// moves the X window too. A fullscreen window stays put.
+		if (priv->fullscreen) {
+			// Already placed by VApplyWindowState().
+		} else if (!pWin->overrideRedirect && pWin->drawable.x <= 0
+			&& pWin->drawable.y <= 0) {
+			static int32 sCascade = 0;
+			int32 step = sCascade++ % 8;
+			priv->surface->MoveTo(BPoint(40 + step * 24, 60 + step * 24));
+		} else if (!pWin->overrideRedirect
+			&& (pWin->drawable.x < 5 || pWin->drawable.y < 27)) {
+			// Keep the border and tab on screen, as a window manager
+			// places a client that asked for the corner.
+			priv->surface->MoveTo(BPoint(vMaxI(pWin->drawable.x, 5),
+				vMaxI(pWin->drawable.y, 27)));
+		}
+
+		priv->surface->Show();
+		priv->mapped = true;
+		VWindowAttribute(pWin);
+
+		if (!sHandlerRegistered) {
+			RegisterBlockAndWakeupHandlers(vFlushDamage, vWakeupNop, NULL);
+			sHandlerRegistered = true;
+		}
+
+		// Initial content; later changes arrive through the damage list.
+		VUploadWindowDamage(priv, pWin->drawable.x, pWin->drawable.y,
+			pWin->drawable.x + pWin->drawable.width,
+			pWin->drawable.y + pWin->drawable.height);
+		if (priv->damage != NULL)
+			DamageEmpty((DamagePtr)priv->damage);
+	}
+
+	return TRUE;
+}
+
+
+Bool
+VUnrealizeWindow(WindowPtr pWin)
+{
+	VWindowPriv* priv = vPriv(pWin);
+	if (priv != NULL && priv->surface != NULL) {
+		priv->mapped = false;
+		priv->surface->Hide();
+	}
+
+	return fbUnrealizeWindow(pWin);
+}
+
+
+Bool
+VPositionWindow(WindowPtr pWin, int x, int y)
+{
+	Bool result = fbPositionWindow(pWin, x, y);
+
+	VWindowPriv* priv = vPriv(pWin);
+	if (priv != NULL && priv->surface != NULL) {
+		// Skip echoes of a native move.
+		if (priv->surface->Frame().LeftTop() != BPoint(x, y))
+			priv->surface->MoveTo(BPoint(x, y));
+		priv->x = x;
+		priv->y = y;
+		VSyncWindowFrame(priv);
+	}
+
+	return result;
+}
+
+
+Bool
+VChangeWindowAttributes(WindowPtr pWin, unsigned long mask)
+{
+	VWindowPriv* priv = vPriv(pWin);
+	if (priv != NULL && (mask & CWOverrideRedirect) != 0)
+		VApplyWindowState(priv);
+
+	return fbChangeWindowAttributes(pWin, mask);
+}
+
+
+void
+VSyncWindowFrame(VWindowPriv* priv)
+{
+	if (priv == NULL || priv->surface == NULL)
+		return;
+
+	WindowPtr pWin = vLookupWindow(priv->xWindow);
+	if (pWin == NULL)
+		return;
+
+	int32 width = pWin->drawable.width;
+	int32 height = pWin->drawable.height;
+	if (priv->width == width && priv->height == height)
+		return;
+
+	priv->width = width;
+	priv->height = height;
+	BRect frame = priv->surface->Frame();
+	if (frame.IntegerWidth() + 1 != width
+		|| frame.IntegerHeight() + 1 != height) {
+		priv->surface->ResizeTo((float)width - 1, (float)height - 1);
+	}
+
+	// The buffer is reallocated for the new size; refill all of it.
+	VUploadWindowDamage(priv, pWin->drawable.x, pWin->drawable.y,
+		pWin->drawable.x + width, pWin->drawable.y + height);
+}
diff --git a/hw/vitruvian/xvitruvian-session.sh b/hw/vitruvian/xvitruvian-session.sh
new file mode 100644
--- /dev/null
+++ b/hw/vitruvian/xvitruvian-session.sh
@@ -0,0 +1,51 @@
+#!/bin/sh
+# Copyright 2026, Dario Casalinuovo. All rights reserved.
+# Distributed under the terms of the MIT License.
+#
+# XVitruvian session launcher: one X server per V\OS session.
+#
+# Mints a MIT-MAGIC-COOKIE-1 for this session, picks a free display,
+# and execs the server with TCP disabled. Runs under the session user;
+# session rules gate who may start it.
+
+set -e
+
+XVITR="${XVITR:-Xvitr}"
+AUTH_DIR="${XAUTHORITY_DIR:-/tmp/.xvitruvian-$$}"
+
+if ! command -v xauth >/dev/null 2>&1; then
+	echo "xvitruvian-session: xauth is required" >&2
+	exit 1
+fi
+
+mkdir -p "$AUTH_DIR"
+chmod 700 "$AUTH_DIR"
+export XAUTHORITY="$AUTH_DIR/Xauthority"
+: > "$XAUTHORITY"
+COOKIE="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
+# Display: first argument (":N" or "N"), else $DISPLAY_NUM, else the
+# first free one.
+NUM=""
+case "${1:-}" in
+	:[0-9]*) NUM="${1#:}"; shift ;;
+	[0-9]*) NUM="$1"; shift ;;
+esac
+[ -n "$NUM" ] || NUM="${DISPLAY_NUM:-}"
+if [ -z "$NUM" ]; then
+	NUM=0
+	# A lock whose server is gone is stale; the server clears it itself.
+	while [ -e "/tmp/.X$NUM-lock" ] \
+		&& kill -0 "$(tr -d ' ' < "/tmp/.X$NUM-lock")" 2>/dev/null; do
+		NUM=$((NUM + 1))
+	done
+fi
+
+# ":N" is the local (unix socket) entry clients look up.
+xauth -f "$XAUTHORITY" add ":$NUM" . "$COOKIE"
+
+# Usually created root-owned 1777 at boot; only set up a missing one.
+[ -d /tmp/.X11-unix ] || mkdir -m 1777 /tmp/.X11-unix
+
+export DISPLAY=":$NUM"
+
+exec "$XVITR" ":$NUM" -auth "$XAUTHORITY" -nolisten tcp -noreset "$@"
diff --git a/hw/vitruvian/vClipboard.cpp b/hw/vitruvian/vClipboard.cpp
new file mode 100644
--- /dev/null
+++ b/hw/vitruvian/vClipboard.cpp
@@ -0,0 +1,328 @@
+/*
+ * Copyright 2026, Dario Casalinuovo. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+// Bridge between the V\OS system clipboard (text/plain) and the X CLIPBOARD
+// selection. A hidden window owns the selection when V\OS has the content;
+// when an X client owns it, the text is fetched as UTF8_STRING.
+
+#include <dix-config.h>
+
+#include "vPriv.h"
+
+#include <X11/Xatom.h>
+
+#include <Clipboard.h>
+#include <Message.h>
+#include <String.h>
+
+#include <string.h>
+
+
+static WindowPtr sWindow = NULL;
+static BString sText;
+static uint32 sOwnCount = 0;
+static bool sHooked = false;
+static int (*sRealConvert)(ClientPtr) = NULL;
+
+
+static Atom
+vClipAtom(const char* name)
+{
+	return MakeAtom(name, strlen(name), TRUE);
+}
+
+
+WindowPtr
+VClipboardWindow()
+{
+	return sWindow;
+}
+
+
+//	#pragma mark - X to V\OS
+
+
+static void
+vLatin1ToUtf8(const uint8* data, size_t length, BString& out)
+{
+	for (size_t i = 0; i < length; i++) {
+		if (data[i] < 0x80)
+			out.Append((const char*)&data[i], 1);
+		else {
+			char pair[2] = { (char)(0xc0 | (data[i] >> 6)),
+				(char)(0x80 | (data[i] & 0x3f)) };
+			out.Append(pair, 2);
+		}
+	}
+}
+
+
+static void
+vPutClipboard(const BString& text)
+{
+	if (text.Length() == 0 || text == sText)
+		return;
+
+	sText = text;
+	if (!be_clipboard->Lock())
+		return;
+	be_clipboard->Clear();
+	BMessage* data = be_clipboard->Data();
+	if (data != NULL) {
+		data->AddData("text/plain", B_MIME_TYPE, text.String(),
+			text.Length());
+		if (be_clipboard->Commit() == B_OK)
+			sOwnCount = be_clipboard->SystemCount();
+	}
+	be_clipboard->Unlock();
+}
+
+
+static void
+vSelectionCallback(CallbackListPtr* /*pcbl*/, void* /*arg*/, void* callData)
+{
+	SelectionInfoRec* info = (SelectionInfoRec*)callData;
+	Selection* pSel = info->selection;
+	if (sWindow == NULL || info->kind != SelectionSetOwner
+		|| pSel->selection != vClipAtom("CLIPBOARD")
+		|| pSel->pWin == NULL || pSel->pWin == sWindow
+		|| pSel->client == NullClient)
+		return;
+
+	// Ask the new owner for the text; the reply lands as a property.
+	xEvent event;
+	memset(&event, 0, sizeof(event));
+	event.u.u.type = SelectionRequest;
+	event.u.selectionRequest.time = currentTime.milliseconds;
+	event.u.selectionRequest.owner = pSel->window;
+	event.u.selectionRequest.requestor = sWindow->drawable.id;
+	event.u.selectionRequest.selection = pSel->selection;
+	event.u.selectionRequest.target = vClipAtom("UTF8_STRING");
+	event.u.selectionRequest.property = vClipAtom("_VOS_CLIPBOARD");
+	WriteEventsToClient(pSel->client, 1, &event);
+}
+
+
+void
+VClipboardPropertyChanged(WindowPtr pWin, PropertyPtr prop, int state)
+{
+	if (pWin != sWindow || state != PropertyNewValue
+		|| prop->propertyName != vClipAtom("_VOS_CLIPBOARD")
+		|| prop->format != 8 || prop->size == 0)
+		return;
+
+	// INCR transfers are not supported.
+	BString text;
+	if (prop->type == vClipAtom("UTF8_STRING"))
+		text.SetTo((const char*)prop->data, prop->size);
+	else if (prop->type == XA_STRING)
+		vLatin1ToUtf8((const uint8*)prop->data, prop->size, text);
+	else
+		return;
+
+	vPutClipboard(text);
+}
+
+
+//	#pragma mark - V\OS to X
+
+
+static void
+vTextFromClipboard(BString& text)
+{
+	text = "";
+	if (!be_clipboard->Lock())
+		return;
+	BMessage* data = be_clipboard->Data();
+	const char* bytes;
+	ssize_t length;
+	if (data != NULL && data->FindData("text/plain", B_MIME_TYPE,
+			(const void**)&bytes, &length) == B_OK && length > 0)
+		text.SetTo(bytes, length);
+	be_clipboard->Unlock();
+}
+
+
+static int
+vConvertSelection(ClientPtr client)
+{
+	xConvertSelectionReq* stuff
+		= (xConvertSelectionReq*)client->requestBuffer;
+	Selection* pSel = NULL;
+	WindowPtr pWin = NULL;
+	if (sWindow == NULL || (stuff->selection != vClipAtom("CLIPBOARD")
+			&& stuff->selection != vClipAtom("XdndSelection"))
+		|| dixLookupSelection(&pSel, stuff->selection, client, DixReadAccess)
+			!= Success
+		|| pSel->pWin != sWindow
+		|| dixLookupWindow(&pWin, stuff->requestor, client, DixSetAttrAccess)
+			!= Success)
+		return sRealConvert(client);
+
+	Atom property = stuff->property != None ? stuff->property : stuff->target;
+	Atom targets = vClipAtom("TARGETS");
+	Atom utf8 = vClipAtom("UTF8_STRING");
+	Atom plainUtf8 = vClipAtom("text/plain;charset=utf-8");
+	Atom plain = vClipAtom("text/plain");
+	Atom textAtom = vClipAtom("TEXT");
+
+	bool done = true;
+	if (stuff->selection == vClipAtom("XdndSelection"))
+		done = VDndConvert(stuff->target, pWin, property);
+	else if (stuff->target == targets) {
+		Atom list[] = { targets, utf8, XA_STRING, textAtom, plainUtf8,
+			plain };
+		dixChangeWindowProperty(serverClient, pWin, property, XA_ATOM, 32,
+			PropModeReplace, sizeof(list) / sizeof(list[0]), list, TRUE);
+	} else if (stuff->target == utf8 || stuff->target == textAtom
+			|| stuff->target == plainUtf8 || stuff->target == plain) {
+		dixChangeWindowProperty(serverClient, pWin, property,
+			stuff->target == textAtom ? utf8 : stuff->target, 8,
+			PropModeReplace, sText.Length(), (void*)sText.String(), TRUE);
+	} else if (stuff->target == XA_STRING) {
+		// Latin-1: keep ASCII and U+0080..U+00FF, drop the rest to '?'.
+		std::vector<uint8> out;
+		const uint8* s = (const uint8*)sText.String();
+		for (int32 i = 0; i < sText.Length(); i++) {
+			if (s[i] < 0x80)
+				out.push_back(s[i]);
+			else if ((s[i] & 0xfe) == 0xc2 && i + 1 < sText.Length()) {
+				out.push_back(((s[i] & 0x03) << 6) | (s[i + 1] & 0x3f));
+				i++;
+			} else {
+				out.push_back('?');
+				while (i + 1 < sText.Length() && (s[i + 1] & 0xc0) == 0x80)
+					i++;
+			}
+		}
+		dixChangeWindowProperty(serverClient, pWin, property, XA_STRING, 8,
+			PropModeReplace, out.size(), out.data(), TRUE);
+	} else
+		done = false;
+
+	xEvent event;
+	memset(&event, 0, sizeof(event));
+	event.u.u.type = SelectionNotify;
+	event.u.selectionNotify.time = stuff->time;
+	event.u.selectionNotify.requestor = stuff->requestor;
+	event.u.selectionNotify.selection = stuff->selection;
+	event.u.selectionNotify.target = stuff->target;
+	event.u.selectionNotify.property = done ? property : None;
+	WriteEventsToClient(client, 1, &event);
+	return Success;
+}
+
+
+void
+VSelectionTake(Atom selection)
+{
+	Selection* pSel = NULL;
+	if (dixLookupSelection(&pSel, selection, serverClient, DixSetAttrAccess)
+			!= Success)
+		pSel = NULL;
+
+	if (pSel != NULL && pSel->pWin == sWindow)
+		return;
+
+	if (pSel == NULL) {
+		pSel = dixAllocateObjectWithPrivates(Selection, PRIVATE_SELECTION);
+		if (pSel == NULL)
+			return;
+		pSel->selection = selection;
+		pSel->next = CurrentSelections;
+		CurrentSelections = pSel;
+	} else if (pSel->client != NullClient && pSel->window != None) {
+		xEvent clear;
+		memset(&clear, 0, sizeof(clear));
+		clear.u.u.type = SelectionClear;
+		clear.u.selectionClear.time = currentTime.milliseconds;
+		clear.u.selectionClear.window = pSel->window;
+		clear.u.selectionClear.atom = selection;
+		WriteEventsToClient(pSel->client, 1, &clear);
+	}
+
+	UpdateCurrentTime();
+	pSel->lastTimeChanged = currentTime;
+	pSel->window = sWindow->drawable.id;
+	pSel->pWin = sWindow;
+	pSel->client = NullClient;
+
+	// Let XFIXES and clipboard managers see the change.
+	SelectionInfoRec info = { pSel, serverClient, SelectionSetOwner };
+	CallCallbacks(&SelectionCallback, &info);
+}
+
+
+void
+VSelectionRelease(Atom selection)
+{
+	Selection* pSel = NULL;
+	if (dixLookupSelection(&pSel, selection, serverClient, DixSetAttrAccess)
+			!= Success || pSel->pWin != sWindow)
+		return;
+
+	pSel->window = None;
+	pSel->pWin = NULL;
+	pSel->client = NullClient;
+	SelectionInfoRec info = { pSel, serverClient, SelectionSetOwner };
+	CallCallbacks(&SelectionCallback, &info);
+}
+
+
+static void
+vTakeOwnership()
+{
+	VSelectionTake(vClipAtom("CLIPBOARD"));
+}
+
+
+// Called from the server thread on B_CLIPBOARD_CHANGED.
+void
+VClipboardChanged()
+{
+	if (sWindow == NULL)
+		return;
+
+	// Our own commit comes back as a change notice.
+	if (be_clipboard->SystemCount() == sOwnCount)
+		return;
+
+	BString text;
+	vTextFromClipboard(text);
+	if (text.Length() == 0)
+		return;
+
+	sText = text;
+	vTakeOwnership();
+}
+
+
+void
+VClipboardInit()
+{
+	if (sHooked || gVScreen == NULL || gVScreen->root == NULL)
+		return;
+
+	int error = 0;
+	sWindow = CreateWindow(FakeClientID(0), gVScreen->root, -1, -1, 1, 1, 0,
+		InputOnly, 0, NULL, 0, serverClient, CopyFromParent, &error);
+	if (sWindow == NULL)
+		return;
+	if (!AddResource(sWindow->drawable.id, RT_WINDOW, sWindow)) {
+		sWindow = NULL;
+		return;
+	}
+
+	sHooked = true;
+	sRealConvert = ProcVector[X_ConvertSelection];
+	ProcVector[X_ConvertSelection] = vConvertSelection;
+	AddCallback(&SelectionCallback, vSelectionCallback, NULL);
+
+	vTextFromClipboard(sText);
+	if (sText.Length() > 0) {
+		sOwnCount = 0;
+		vTakeOwnership();
+	}
+}
diff --git a/hw/vitruvian/vDnd.cpp b/hw/vitruvian/vDnd.cpp
new file mode 100644
--- /dev/null
+++ b/hw/vitruvian/vDnd.cpp
@@ -0,0 +1,768 @@
