+
+//	#pragma mark - server op queue
+
+
+void
+VEnqueueOp(const VOp& op)
+{
+	if (sOpLock < B_OK || acquire_sem(sOpLock) != B_OK)
+		return;
+
+	int32 slot = atomic_add(&sOpCount, 1);
+	if (slot >= sOpCapacity) {
+		atomic_add(&sOpCount, -1);
+		release_sem(sOpLock);
+		return;
+	}
+
+	sOps[slot] = op;
+	release_sem(sOpLock);
+	VWakeServer();
+}
+
+
+void
+VWakeServer()
+{
+	if (gVWakeWrite >= 0) {
+		char byte = 0;
+		ssize_t ignored = write(gVWakeWrite, &byte, sizeof(byte));
+		(void)ignored;
+	}
+}
+
+
+void
+VProcessOps()
+{
+	while (true) {
+		if (sOpLock < B_OK || acquire_sem(sOpLock) != B_OK)
+			return;
+
+		int32 count = sOpCount;
+		if (count <= 0) {
+			release_sem(sOpLock);
+			return;
+		}
+
+		VOp ops[32];
+		int32 take = count < 32 ? count : 32;
+		memcpy(ops, sOps, take * sizeof(VOp));
+		if (count > take)
+			memmove(sOps, sOps + take, (count - take) * sizeof(VOp));
+		atomic_add(&sOpCount, -take);
+		release_sem(sOpLock);
+
+		for (int32 i = 0; i < take; i++) {
+			const VOp& op = ops[i];
+			switch (op.what) {
+				case kVOpScreenChanged:
+					VResizeScreen(op.i0, op.i1);
+					break;
+				case kVOpSettingsChanged:
+					VSettingsUpdate();
+					break;
+				case kVOpKeymapChanged:
+					VReloadKeymap();
+					break;
+				case kVOpClipboardChanged:
+					VClipboardChanged();
+					break;
+				case kVOpSetTeam:
+					VWindowSetTeam(op.windowId, (team_id)op.i0);
+					break;
+				default:
+					break;
+			}
+		}
+	}
+}
+
+
+static void
+vNotifyRead(int /*fd*/, int /*ready*/, void* /*data*/)
+{
+	// Drain the wake pipe; input and window ops were already queued.
+	char buffer[64];
+	while (read(gVWakeRead, buffer, sizeof(buffer)) > 0)
+		;
+
+	VDrainInputPort();
+	VProcessOps();
+}
