+static void
+vPublishExtents(WindowPtr pWin, const int32* extents)
+{
+	CARD32 values[4] = { (CARD32)extents[0], (CARD32)extents[1],
+		(CARD32)extents[2], (CARD32)extents[3] };
+	dixChangeWindowProperty(serverClient, pWin,
+		vAtom("_NET_FRAME_EXTENTS"), XA_CARDINAL, 32, PropModeReplace, 4,
+		values, TRUE);
+}
