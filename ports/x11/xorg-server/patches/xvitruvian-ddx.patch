+
+// Applies a _NET_WM_STATE client message (add, remove, toggle) for up to
+// two atoms in one property write; the property observer then does the
+// native work.
+static void
+vChangeNetStates(WindowPtr pWin, int action, Atom first, Atom second)
+{
+	Atom state = vAtom("_NET_WM_STATE");
+	Atom atoms[66];
+	int count = vReadAtomList(pWin, state, atoms, 64);
+	if (count < 0)
+		count = 0;
+
+	bool changed = false;
+	Atom wanted[2] = { first, second };
+	for (int n = 0; n < 2; n++) {
+		if (wanted[n] == None)
+			continue;
+		int index = -1;
+		for (int i = 0; i < count; i++) {
+			if (atoms[i] == wanted[n])
+				index = i;
+		}
+		bool add = action == 1 || (action == 2 && index < 0);
+		if (add && index < 0) {
+			atoms[count++] = wanted[n];
+			changed = true;
+		} else if (!add && index >= 0) {
+			atoms[index] = atoms[--count];
+			changed = true;
+		}
+	}
+
+	if (changed)
+		vSetAtomList(pWin, state, atoms, count);
+}
+
+
+static int (*sRealSendEvent)(ClientPtr client) = NULL;
+
+
+// There is no window manager: requests clients address to the root are
+// answered here.
+static int
+vSendEvent(ClientPtr client)
+{
+	REQUEST(xSendEventReq);
+	WindowPtr bridge = VClipboardWindow();
+	if (!client->swapped && bridge != NULL
+		&& client->req_len >= bytes_to_int32(sizeof(xSendEventReq))
+		&& stuff->destination == bridge->drawable.id
+		&& VDndSendEvent(&stuff->event))
+		return Success;
+
+	if (client->swapped || client->req_len < bytes_to_int32(sizeof(xSendEventReq))
+		|| gVScreen == NULL
+		|| stuff->destination != gVScreen->root->drawable.id
+		|| (stuff->event.u.u.type & 0x7f) != ClientMessage)
+		return sRealSendEvent(client);
+
+	auto* message = &stuff->event.u.clientMessage;
+
+	WindowPtr pWin = vLookupWindow(message->window);
+	if (pWin == NULL || message->u.l.type == None)
+		return sRealSendEvent(client);
+
+	if (message->u.l.type == vAtom("_NET_WM_STATE")) {
+		vChangeNetStates(pWin, (int)message->u.l.longs0,
+			(Atom)message->u.l.longs1, (Atom)message->u.l.longs2);
+		return Success;
+	}
+
+	// ICCCM: IconicState asks for minimize.
+	if (message->u.l.type == vAtom("WM_CHANGE_STATE")) {
+		if (message->u.l.longs0 == 3)
+			vChangeNetStates(pWin, 1, vAtom("_NET_WM_STATE_HIDDEN"), None);
+		return Success;
+	}
+
+	// The client wants to know the frame before it maps the window.
+	if (message->u.l.type == vAtom("_NET_REQUEST_FRAME_EXTENTS")) {
+		VStyle style;
+		vComputeStyle(pWin, &style);
+		vPublishExtents(pWin, style.extents);
+		return Success;
+	}
+
+	if (message->u.l.type == vAtom("_NET_WM_MOVERESIZE")) {
+		VWindowPriv* priv = vPriv(pWin);
+		if (priv == NULL || priv->surface == NULL || !priv->mapped)
+			return Success;
+		int direction = (int)message->u.l.longs2;
+		if (direction == kMoveResizeCancel) {
+			if (priv->dragMode >= 0) {
+				priv->surface->MoveTo(BPoint(priv->dragFrame[0],
+					priv->dragFrame[1]));
+				priv->surface->ResizeTo(priv->dragFrame[2] - priv->dragFrame[0],
+					priv->dragFrame[3] - priv->dragFrame[1]);
+				vDragEnd(priv);
+			}
+		} else if (direction >= 0 && direction <= kMoveResizeMove
+			&& !priv->fullscreen)
+			vDragStart(priv, (float)(int32)message->u.l.longs0,
+				(float)(int32)message->u.l.longs1, direction);
+		return Success;
+	}
+
+	if (message->u.l.type == vAtom("_NET_ACTIVE_WINDOW")) {
+		VWindowPriv* priv = vPriv(pWin);
+		if (priv != NULL && priv->surface != NULL && priv->mapped) {
+			if (priv->minimized)
+				vChangeNetStates(pWin, 0, vAtom("_NET_WM_STATE_HIDDEN"), None);
+			priv->surface->Activate();
+		}
+		return Success;
+	}
+
+	return sRealSendEvent(client);
+}
+
+
+void
+VSetupWindowManager()
+{
+	if (gVScreen == NULL || gVScreen->root == NULL)
+		return;
+
+	WindowPtr root = gVScreen->root;
+	static bool hooked = false;
+	if (!hooked) {
+		hooked = true;
+		sRealSendEvent = ProcVector[X_SendEvent];
+		ProcVector[X_SendEvent] = vSendEvent;
+	}
+
+	VSettingsUpdate();
+	VClipboardInit();
+
+	PropertyPtr existing = NULL;
+	if (dixLookupProperty(&existing, root, vAtom("_NET_SUPPORTED"),
+			serverClient, DixReadAccess) == Success)
+		return;
+
+	static const char* const kSupported[] = {
+		"_NET_SUPPORTED",
+		"_NET_SUPPORTING_WM_CHECK",
+		"_NET_WM_STATE",
+		"_NET_WM_STATE_FULLSCREEN",
+		"_NET_WM_STATE_HIDDEN",
+		"_NET_WM_STATE_MAXIMIZED_HORZ",
+		"_NET_WM_STATE_MAXIMIZED_VERT",
+		"_NET_WM_STATE_MODAL",
+		"_NET_ACTIVE_WINDOW",
+		"_NET_WM_NAME",
+		"_NET_FRAME_EXTENTS",
+		"_GTK_FRAME_EXTENTS",
+		"_NET_REQUEST_FRAME_EXTENTS",
+		"_NET_WM_MOVERESIZE",
+		"_NET_WM_ALLOWED_ACTIONS",
+		"_NET_WM_ACTION_MOVE",
+		"_NET_WM_ACTION_RESIZE",
+		"_NET_WM_ACTION_MINIMIZE",
+		"_NET_WM_ACTION_MAXIMIZE_HORZ",
+		"_NET_WM_ACTION_MAXIMIZE_VERT",
+		"_NET_WM_ACTION_FULLSCREEN",
+		"_NET_WM_ACTION_CLOSE",
+		"_NET_WM_WINDOW_TYPE",
+		"_NET_WM_WINDOW_TYPE_NORMAL",
+		"_NET_WM_WINDOW_TYPE_DIALOG",
+		"_NET_WM_WINDOW_TYPE_UTILITY",
+		"_NET_WM_WINDOW_TYPE_TOOLBAR",
+		"_NET_WM_WINDOW_TYPE_SPLASH",
+		"_NET_WM_WINDOW_TYPE_NOTIFICATION",
+		"_NET_WM_WINDOW_TYPE_MENU",
+		"_NET_WM_WINDOW_TYPE_DROPDOWN_MENU",
+		"_NET_WM_WINDOW_TYPE_POPUP_MENU",
+		"_NET_WM_WINDOW_TYPE_TOOLTIP",
+		"_NET_WM_WINDOW_TYPE_COMBO",
+		"_NET_WM_WINDOW_TYPE_DND",
+	};
+	Atom supported[sizeof(kSupported) / sizeof(kSupported[0])];
+	for (size_t i = 0; i < sizeof(supported) / sizeof(supported[0]); i++)
+		supported[i] = vAtom(kSupported[i]);
+	vSetAtomList(root, vAtom("_NET_SUPPORTED"), supported,
+		sizeof(supported) / sizeof(supported[0]));
+
+	// The root doubles as the check window.
+	CARD32 id = root->drawable.id;
+	Atom check = vAtom("_NET_SUPPORTING_WM_CHECK");
+	dixChangeWindowProperty(serverClient, root, check, XA_WINDOW, 32,
+		PropModeReplace, 1, &id, TRUE);
+	const char* name = "XVitruvian";
+	dixChangeWindowProperty(serverClient, root, vAtom("_NET_WM_NAME"),
+		vAtom("UTF8_STRING"), 8, PropModeReplace, strlen(name), (void*)name,
+		TRUE);
+}
