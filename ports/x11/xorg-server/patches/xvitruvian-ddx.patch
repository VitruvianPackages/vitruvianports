+// misc.h defines min/max macros that break the std versions.
+static inline int32
+vMaxI(int32 a, int32 b)
+{
+	return a > b ? a : b;
+}
+
+
+static inline int32
+vMinI(int32 a, int32 b)
+{
+	return a < b ? a : b;
+}
