@@ -0,0 +1,385 @@
+/*
+ * Copyright 2026, Dario Casalinuovo. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+// V\OS UI settings for X clients: the XSETTINGS manager for GTK and Qt
+// plus RESOURCE_MANAGER for Xft and Xcursor.
+
+#include <dix-config.h>
+
+#include "vPriv.h"
+
+#include <X11/Xatom.h>
+
+#include <Autolock.h>
+#include <Font.h>
+#include <Locker.h>
+#include <InterfaceDefs.h>
+#include <String.h>
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+
+
+void _init_global_fonts_();
+status_t get_subpixel_antialiasing(bool* subpix);
+status_t get_hinting_mode(uint8* hinting);
+
+static const int kCursorSize = 24;
+
+static WindowPtr sOwner = NULL;
+static uint32 sSerial = 0;
+
+
+static Atom
+vSettingAtom(const char* name)
+{
+	return MakeAtom(name, strlen(name), TRUE);
+}
+
+
+//	#pragma mark - XSETTINGS
+
+
+static void
+vPad(std::vector<uint8>& out)
+{
+	while (out.size() % 4 != 0)
+		out.push_back(0);
+}
+
+
+static void
+vPut32(std::vector<uint8>& out, uint32 value)
+{
+	for (int i = 0; i < 4; i++)
+		out.push_back((value >> (8 * i)) & 0xff);
+}
+
+
+static void
+vPutName(std::vector<uint8>& out, uint8 type, const char* name)
+{
+	size_t length = strlen(name);
+	out.push_back(type);
+	out.push_back(0);
+	out.push_back(length & 0xff);
+	out.push_back((length >> 8) & 0xff);
+	out.insert(out.end(), name, name + length);
+	vPad(out);
+	vPut32(out, sSerial);
+}
+
+
+static void
+vPutInt(std::vector<uint8>& out, const char* name, uint32 value)
+{
+	vPutName(out, 0, name);
+	vPut32(out, value);
+}
+
+
+static void
+vPutString(std::vector<uint8>& out, const char* name, const char* value)
+{
+	vPutName(out, 1, name);
+	size_t length = strlen(value);
+	vPut32(out, length);
+	out.insert(out.end(), value, value + length);
+	vPad(out);
+}
+
+
+struct VLook {
+	BString	font;
+	bool	dark;
+	bool	antialias;
+	bool	subpixel;
+	uint8	hinting;
+	BString	plainFamily;
+	BString	boldFamily;
+	BString	fixedFamily;
+};
+
+static BLocker sCacheLock("xv settings");
+static VLook sCached = { BString("Sans 10"), false, true, false, 1 };
+
+
+// The fontconfig aliases and rendering defaults X clients read; rewritten
+// only when the text changes.
+static void
+vWriteFontconfig(const VLook& look)
+{
+	const char* config = getenv("XDG_CONFIG_HOME");
+	const char* home = getenv("HOME");
+	BString dir;
+	if (config != NULL && config[0] != '\0')
+		dir = config;
+	else if (home != NULL && home[0] != '\0')
+		dir << home << "/.config";
+	else
+		return;
+	dir << "/fontconfig";
+	mkdir(dir.String(), 0755);
+	dir << "/conf.d";
+	mkdir(dir.String(), 0755);
+
+	const char* hintStyle = look.hinting == 0 ? "hintnone" : "hintslight";
+	BString text;
+	text << "<?xml version=\"1.0\"?>\n"
+		"<!DOCTYPE fontconfig SYSTEM \"urn:fontconfig:fonts.dtd\">\n"
+		"<!-- Generated from the V\\OS font settings. -->\n"
+		"<fontconfig>\n";
+	const char* const kGeneric[3] = { "sans-serif", "serif", "monospace" };
+	const BString* families[3] = { &look.plainFamily, &look.boldFamily,
+		&look.fixedFamily };
+	for (int i = 0; i < 3; i++) {
+		if (families[i]->IsEmpty())
+			continue;
+		text << "\t<alias binding=\"same\">\n\t\t<family>" << kGeneric[i]
+			<< "</family>\n\t\t<prefer><family>" << *families[i]
+			<< "</family></prefer>\n\t</alias>\n";
+	}
+	text << "\t<match target=\"font\">\n"
+		"\t\t<edit name=\"antialias\" mode=\"assign\"><bool>"
+		<< (look.antialias ? "true" : "false") << "</bool></edit>\n"
+		"\t\t<edit name=\"hinting\" mode=\"assign\"><bool>"
+		<< (look.hinting != 0 ? "true" : "false") << "</bool></edit>\n"
+		"\t\t<edit name=\"hintstyle\" mode=\"assign\"><const>"
+		<< hintStyle << "</const></edit>\n"
+		"\t\t<edit name=\"rgba\" mode=\"assign\"><const>"
+		<< (look.subpixel ? "rgb" : "none") << "</const></edit>\n"
+		"\t</match>\n</fontconfig>\n";
+
+	BString path(dir);
+	path << "/60-vos.conf";
+	FILE* file = fopen(path.String(), "r");
+	if (file != NULL) {
+		BString old;
+		char buffer[1024];
+		size_t count;
+		while ((count = fread(buffer, 1, sizeof(buffer), file)) > 0)
+			old.Append(buffer, count);
+		fclose(file);
+		if (old == text)
+			return;
+	}
+
+	BString temp(path);
+	temp << ".tmp";
+	file = fopen(temp.String(), "w");
+	if (file == NULL)
+		return;
+	bool ok = fwrite(text.String(), 1, text.Length(), file)
+		== (size_t)text.Length();
+	ok = fclose(file) == 0 && ok;
+	if (!ok || rename(temp.String(), path.String()) != 0)
+		unlink(temp.String());
+}
+
+
+// Runs on the application thread: font and color queries talk to
+// app_server and must never run on the X thread.
+void
+VSettingsRefresh()
+{
+	_init_global_fonts_();
+
+	font_family family;
+	font_style style;
+	be_plain_font->GetFamilyAndStyle(&family, &style);
+	BString font;
+	font.SetToFormat("%s %d", family, (int)(be_plain_font->Size() + 0.5f));
+	VLook look;
+	look.font = font;
+	look.plainFamily = family;
+	font_family boldFamily;
+	be_bold_font->GetFamilyAndStyle(&boldFamily, &style);
+	look.boldFamily = boldFamily;
+	font_family fixedFamily;
+	be_fixed_font->GetFamilyAndStyle(&fixedFamily, &style);
+	look.fixedFamily = fixedFamily;
+	look.antialias = (be_plain_font->Flags() & B_DISABLE_ANTIALIASING) == 0;
+	look.subpixel = false;
+	get_subpixel_antialiasing(&look.subpixel);
+	look.hinting = 1;
+	get_hinting_mode(&look.hinting);
+
+	rgb_color background = ui_color(B_PANEL_BACKGROUND_COLOR);
+	bool dark = (background.red * 299 + background.green * 587
+		+ background.blue * 114) / 1000 < 128;
+
+	look.dark = dark;
+
+	vWriteFontconfig(look);
+
+	BAutolock locker(sCacheLock);
+	sCached = look;
+}
+
+
+static void
+vReadSettings(VLook& look)
+{
+	BAutolock locker(sCacheLock);
+	look = sCached;
+}
+
+
+static void
+vPublishXSettings(const VLook& look)
+{
+	const BString& font = look.font;
+	bool dark = look.dark;
+	std::vector<uint8> data;
+	data.push_back(0);	// LSBFirst
+	data.push_back(0);
+	data.push_back(0);
+	data.push_back(0);
+	vPut32(data, sSerial);
+	vPut32(data, 15);
+
+	vPutInt(data, "Xft/DPI", VNativeDpi() * 1024);
+	vPutInt(data, "Xft/Antialias", look.antialias ? 1 : 0);
+	vPutInt(data, "Xft/Hinting", look.hinting != 0 ? 1 : 0);
+	vPutString(data, "Xft/HintStyle",
+		look.hinting != 0 ? "hintslight" : "hintnone");
+	vPutString(data, "Xft/RGBA", look.subpixel ? "rgb" : "none");
+	vPutString(data, "Gtk/FontName", font.String());
+	vPutString(data, "Net/ThemeName", dark ? "Adwaita-dark" : "Adwaita");
+	vPutString(data, "Net/IconThemeName", "Adwaita");
+	vPutString(data, "Gtk/CursorThemeName", "Adwaita");
+	vPutInt(data, "Gtk/CursorThemeSize", kCursorSize);
+	vPutInt(data, "Gtk/MenuImages", 1);
+	vPutInt(data, "Gtk/ButtonImages", 1);
+	vPutInt(data, "Gtk/EnableAnimations", 1);
+	vPutInt(data, "Gtk/ApplicationPreferDarkTheme", dark ? 1 : 0);
+	vPutString(data, "Gtk/DecorationLayout", ":minimize,maximize,close");
+
+	Atom property = vSettingAtom("_XSETTINGS_SETTINGS");
+	dixChangeWindowProperty(serverClient, sOwner, property, property, 8,
+		PropModeReplace, data.size(), data.data(), TRUE);
+}
+
+
+//	#pragma mark - RESOURCE_MANAGER
+
+
+static void
+vPublishResources(WindowPtr root, const VLook& look)
+{
+	static const char* const kKeys[] = {
+		"Xft.dpi:", "Xft.antialias:", "Xft.hinting:", "Xft.hintstyle:",
+		"Xft.rgba:", "Xcursor.size:", "Xcursor.theme:"
+	};
+
+	// Merge like xrdb: keep every entry that is not ours.
+	BString result;
+	PropertyPtr prop = NULL;
+	if (dixLookupProperty(&prop, root, XA_RESOURCE_MANAGER, serverClient,
+			DixReadAccess) == Success && prop != NULL && prop->format == 8
+		&& prop->size > 0) {
+		BString old((const char*)prop->data, prop->size);
+		int32 start = 0;
+		while (start < old.Length()) {
+			int32 end = old.FindFirst('\n', start);
+			if (end < 0)
+				end = old.Length();
+			BString line;
+			old.CopyInto(line, start, end - start);
+			start = end + 1;
+
+			bool ours = false;
+			for (size_t i = 0; i < sizeof(kKeys) / sizeof(kKeys[0]); i++) {
+				if (line.FindFirst(kKeys[i]) == 0)
+					ours = true;
+			}
+			if (!ours && line.Length() > 0)
+				result << line << "\n";
+		}
+	}
+
+	result << "Xft.dpi:\t" << (int32)VNativeDpi() << "\n"
+		<< "Xft.antialias:\t" << (look.antialias ? "1" : "0") << "\n"
+		<< "Xft.hinting:\t" << (look.hinting != 0 ? "1" : "0") << "\n"
+		<< "Xft.hintstyle:\t"
+		<< (look.hinting != 0 ? "hintslight" : "hintnone") << "\n"
+		<< "Xft.rgba:\t" << (look.subpixel ? "rgb" : "none") << "\n"
+		<< "Xcursor.size:\t" << (int32)kCursorSize << "\n"
+		<< "Xcursor.theme:\tAdwaita\n";
+
+	dixChangeWindowProperty(serverClient, root, XA_RESOURCE_MANAGER,
+		XA_STRING, 8, PropModeReplace, result.Length(),
+		(void*)result.String(), TRUE);
+}
+
+
+//	#pragma mark - entry points
+
+
+// Takes the _XSETTINGS_S0 selection once; later calls only republish.
+void
+VSettingsUpdate()
+{
+	if (gVScreen == NULL || gVScreen->root == NULL)
+		return;
+
+	WindowPtr root = gVScreen->root;
+	VLook look;
+	vReadSettings(look);
+
+	if (sOwner == NULL) {
+		int error = 0;
+		sOwner = CreateWindow(FakeClientID(0), root, -1, -1, 1, 1, 0,
+			InputOnly, 0, NULL, 0, serverClient, CopyFromParent, &error);
+		if (sOwner == NULL)
+			return;
+		if (!AddResource(sOwner->drawable.id, RT_WINDOW, sOwner)) {
+			sOwner = NULL;
+			return;
+		}
+	}
+
+	sSerial++;
+	vPublishXSettings(look);
+	vPublishResources(root, look);
+
+	Atom selection = vSettingAtom("_XSETTINGS_S0");
+	Selection* pSel = NULL;
+	if (dixLookupSelection(&pSel, selection, serverClient,
+			DixSetAttrAccess) == Success && pSel->pWin == sOwner)
+		return;
+
+	if (pSel == NULL) {
+		pSel = dixAllocateObjectWithPrivates(Selection, PRIVATE_SELECTION);
+		if (pSel == NULL)
+			return;
+		pSel->selection = selection;
+		pSel->next = CurrentSelections;
+		CurrentSelections = pSel;
+	}
+	UpdateCurrentTime();
+	pSel->lastTimeChanged = currentTime;
+	pSel->window = sOwner->drawable.id;
+	pSel->pWin = sOwner;
+	pSel->client = NullClient;
+
+	// Announce the manager to clients that are already running.
+	xEvent event;
+	memset(&event, 0, sizeof(event));
+	event.u.u.type = ClientMessage;
+	event.u.u.detail = 32;
+	event.u.clientMessage.window = root->drawable.id;
+	event.u.clientMessage.u.l.type = vSettingAtom("MANAGER");
+	event.u.clientMessage.u.l.longs0 = currentTime.milliseconds;
+	event.u.clientMessage.u.l.longs1 = selection;
+	event.u.clientMessage.u.l.longs2 = sOwner->drawable.id;
+	DeliverEventsToWindow(PickPointer(serverClient), root, &event, 1,
+		StructureNotifyMask, NullGrab);
+}
