+//	#pragma mark - application
+
+
+// Window to client pid and the team it is listed under; app thread only.
+struct VWindowTeam {
+	pid_t		pid;
+	team_id		team;
+};
+static std::map<uint32, VWindowTeam> sWindowTeams;
+
+
+static pid_t
+vParentPid(pid_t pid)
+{
+	char path[64];
+	snprintf(path, sizeof(path), "/proc/%d/stat", (int)pid);
+	FILE* f = fopen(path, "r");
+	if (f == NULL)
+		return -1;
+	char line[512];
+	size_t size = fread(line, 1, sizeof(line) - 1, f);
+	fclose(f);
+	line[size] = '\0';
+	// comm may hold spaces and parentheses; ppid follows the last ')'.
+	const char* end = strrchr(line, ')');
+	int ppid = -1;
+	if (end == NULL || sscanf(end + 1, " %*c %d", &ppid) != 1)
+		return -1;
+	return (pid_t)ppid;
+}
+
+
+// Team of the registered app owning pid: the process itself, else the
+// nearest ancestor that is a registered X client (browser helpers).
+static team_id
+vResolveTeam(pid_t pid)
+{
+	static const char kClient[] = "application/x-vnd.vos-x-";
+	pid_t p = pid;
+	for (int depth = 0; p > 1 && depth < 16; depth++) {
+		app_info info;
+		if (be_roster->GetRunningAppInfo((team_id)p, &info) == B_OK
+			&& (depth == 0
+				|| strncmp(info.signature, kClient, sizeof(kClient) - 1)
+					== 0)) {
+			return (team_id)p;
+		}
+		p = vParentPid(p);
+	}
+	return -1;
+}
+
+
+static void
+vAttributeWindow(uint32 id, VWindowTeam& entry)
+{
+	team_id team = vResolveTeam(entry.pid);
+	if (team <= 0 || team == entry.team)
+		return;
+	entry.team = team;
+	VOp op;
+	memset(&op, 0, sizeof(op));
+	op.what = kVOpSetTeam;
+	op.windowId = id;
+	op.i0 = (int32)team;
+	VEnqueueOp(op);
+}
+
+
+void
+VPostWindowPid(uint32 windowId, int32 pid)
+{
+	if (!sAppReady)
+		return;
+	BMessage message(kMsgWindowPid);
+	message.AddInt32("window", (int32)windowId);
+	message.AddInt32("pid", pid);
+	sAppMessenger.SendMessage(&message, (BHandler*)NULL, 0);
+}
+
+
+void
+VPostWindowGone(uint32 windowId)
+{
+	if (!sAppReady)
+		return;
+	BMessage message(kMsgWindowGone);
+	message.AddInt32("window", (int32)windowId);
+	sAppMessenger.SendMessage(&message, (BHandler*)NULL, 0);
+}
