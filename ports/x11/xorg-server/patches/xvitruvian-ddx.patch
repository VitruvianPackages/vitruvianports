+ * Distributed under the terms of the MIT License.
+ */
+
+// Drag and drop between V\OS and X (XDND v5). An X-source drag over native
+// windows is one-way: the source is never told about the target.
+
+#ifdef HAVE_DIX_CONFIG_H
+#include <dix-config.h>
+#endif
+
+#include "vPriv.h"
+
+#include <X11/Xatom.h>
+
+#include <AppDefs.h>
+#include <Entry.h>
+#include <Message.h>
+#include <Path.h>
+#include <String.h>
+#include <View.h>
+#include <Window.h>
+
+#include <stdio.h>
+#include <string.h>
+
+#include <vector>
+
+
+static const int kVersion = 5;
+static const bigtime_t kStatusTimeout = 300000;
+static const CARD32 kFinishTimeout = 10000;
+
+static const char* const kOriginField = "x-vnd.v-os-xvitruvian:origin";
+
+
+static Atom
+vA(const char* name)
+{
+	return MakeAtom(name, strlen(name), TRUE);
+}
+
+
+static inline int32
+vMinI(int32 a, int32 b)
+{
+	return a < b ? a : b;
+}
+
+
+static WindowPtr
+vFind(Window id)
+{
+	WindowPtr pWin = NULL;
+	if (dixLookupWindow(&pWin, id, serverClient, DixReadAccess) != Success)
+		return NULL;
+	return pWin;
+}
+
+
+//	#pragma mark - V\OS to X: data
+
+
+static BString sUris;
+static BString sText;
+static bool sHasUris = false;
+static bool sHasText = false;
+static std::vector<Atom> sTypes;
+
+
+static void
+vEncodeUri(const char* path, BString& out)
+{
+	out << "file://";
+	for (const unsigned char* p = (const unsigned char*)path; *p != 0; p++) {
+		if (isalnum(*p) || strchr("/-._~", *p) != NULL)
+			out.Append((const char*)p, 1);
+		else {
+			char hex[4];
+			snprintf(hex, sizeof(hex), "%%%02X", *p);
+			out << hex;
+		}
+	}
+	out << "\r\n";
+}
+
+
+static bool
+vBuildData(const BMessage& drag)
+{
+	sUris = "";
+	sText = "";
+	sHasUris = false;
+	sHasText = false;
+	sTypes.clear();
+
+	if (drag.HasBool(kOriginField))
+		return false;
+
+	entry_ref ref;
+	for (int32 i = 0; drag.FindRef("refs", i, &ref) == B_OK; i++) {
+		BPath path(&ref);
+		if (path.InitCheck() != B_OK)
+			continue;
+		vEncodeUri(path.Path(), sUris);
+		sHasUris = true;
+	}
+
+	const void* data;
+	ssize_t length;
+	if (drag.FindData("text/plain", B_MIME_TYPE, &data, &length) == B_OK
+		&& length > 0) {
+		// A trailing NUL is part of some senders' payload.
+		while (length > 0 && ((const char*)data)[length - 1] == '\0')
+			length--;
+		sText.SetTo((const char*)data, length);
+		sHasText = sText.Length() > 0;
+	}
+
+	if (sHasUris)
+		sTypes.push_back(vA("text/uri-list"));
+	if (sHasText) {
+		sTypes.push_back(vA("text/plain;charset=utf-8"));
+		sTypes.push_back(vA("UTF8_STRING"));
+		sTypes.push_back(vA("text/plain"));
+		sTypes.push_back(XA_STRING);
+	}
+	return !sTypes.empty();
+}
+
+
+// Called with the selection request of an XDND target.
+bool
+VDndConvert(Atom target, WindowPtr pWin, Atom property)
+{
+	Atom uriList = vA("text/uri-list");
+	Atom targets = vA("TARGETS");
+	bool isText = target == vA("text/plain;charset=utf-8")
+		|| target == vA("UTF8_STRING") || target == vA("text/plain")
+		|| target == XA_STRING || target == vA("TEXT");
+
+	if (target == targets) {
+		std::vector<Atom> list;
+		list.push_back(targets);
+		list.insert(list.end(), sTypes.begin(), sTypes.end());
+		dixChangeWindowProperty(serverClient, pWin, property, XA_ATOM, 32,
+			PropModeReplace, list.size(), list.data(), TRUE);
+		return true;
+	}
+	if (target == uriList && sHasUris) {
+		dixChangeWindowProperty(serverClient, pWin, property, target, 8,
+			PropModeReplace, sUris.Length(), (void*)sUris.String(), TRUE);
+		return true;
+	}
+	if (isText && sHasText) {
+		dixChangeWindowProperty(serverClient, pWin, property,
+			target == vA("TEXT") ? vA("UTF8_STRING") : target, 8,
+			PropModeReplace, sText.Length(), (void*)sText.String(), TRUE);
+		return true;
+	}
+	return false;
+}
+
+
+//	#pragma mark - V\OS to X: session
+
+
+struct VDndSession {
+	bool		active;
+	bool		dropped;
+	bool		accepted;
+	bool		waiting;
+	bigtime_t	sentAt;
+	Window		target;
+	int			version;
+	bool		hasPending;
+	int32		pendingX;
+	int32		pendingY;
+	int32		lastX;
+	int32		lastY;
+};
+
+static VDndSession sSession;
+static bool sDragSeen = false;
+static bool sDragUsable = false;
+static bool sOwning = false;
+static OsTimerPtr sFinishTimer = NULL;
+
+
+static void
+vSendMessage(WindowPtr target, Atom type, long l0, long l1, long l2, long l3,
+	long l4)
+{
+	WindowPtr source = VClipboardWindow();
+	if (target == NULL || source == NULL)
+		return;
+
+	xEvent event;
+	memset(&event, 0, sizeof(event));
+	event.u.u.type = ClientMessage;
+	event.u.u.detail = 32;
+	event.u.clientMessage.window = target->drawable.id;
+	event.u.clientMessage.u.l.type = type;
+	event.u.clientMessage.u.l.longs0 = l0;
+	event.u.clientMessage.u.l.longs1 = l1;
+	event.u.clientMessage.u.l.longs2 = l2;
+	event.u.clientMessage.u.l.longs3 = l3;
+	event.u.clientMessage.u.l.longs4 = l4;
+	WriteEventsToClient(wClient(target), 1, &event);
+}
+
+
+static void
+vReleaseSelection()
+{
+	if (sFinishTimer != NULL) {
+		TimerFree(sFinishTimer);
+		sFinishTimer = NULL;
+	}
+	if (sOwning) {
+		VSelectionRelease(vA("XdndSelection"));
+		sOwning = false;
+	}
+}
+
+
+static CARD32
+vFinishTimeout(OsTimerPtr /*timer*/, CARD32 /*now*/, void* /*arg*/)
+{
+	sFinishTimer = NULL;
+	sSession.active = false;
+	sSession.dropped = false;
+	vReleaseSelection();
+	return 0;
+}
+
+
+static void
+vEndSession(bool sendLeave)
+{
+	if (sSession.active && sendLeave && !sSession.dropped) {
+		WindowPtr target = vFind(sSession.target);
+		WindowPtr source = VClipboardWindow();
+		if (target != NULL && source != NULL) {
+			vSendMessage(target, vA("XdndLeave"), source->drawable.id, 0, 0,
+				0, 0);
+		}
+	}
+	memset(&sSession, 0, sizeof(sSession));
+	vReleaseSelection();
+}
+
+
+static bool
+vInside(WindowPtr w, int32 x, int32 y)
+{
+	int32 bw = wBorderWidth(w);
+	return x >= w->drawable.x - bw && y >= w->drawable.y - bw
+		&& x < w->drawable.x + (int32)w->drawable.width + bw
+		&& y < w->drawable.y + (int32)w->drawable.height + bw;
+}
+
+
+static WindowPtr
+vTopWindowAt(int32 x, int32 y, bool skipOverride)
+{
+	if (gVScreen == NULL)
+		return NULL;
+
+	for (WindowPtr w = gVScreen->root->firstChild; w != NULL;
+			w = w->nextSib) {
+		if (!w->mapped || w->drawable.class_ != InputOutput
+			|| (skipOverride && w->overrideRedirect))
+			continue;
+		if (vInside(w, x, y))
+			return w;
+	}
+	return NULL;
+}
+
+
+// The deepest window under the point that advertises XdndAware.
+static WindowPtr
+vFindAware(WindowPtr top, int32 x, int32 y, int* version)
+{
+	Atom aware = vA("XdndAware");
+	WindowPtr best = NULL;
+	WindowPtr w = top;
+	while (w != NULL) {
+		PropertyPtr prop = NULL;
+		if (dixLookupProperty(&prop, w, aware, serverClient, DixReadAccess)
+				== Success && prop != NULL && prop->format == 32
+			&& prop->size >= 1) {
+			best = w;
+			*version = vMinI((int32)((CARD32*)prop->data)[0], kVersion);
+		}
+
+		WindowPtr next = NULL;
+		for (WindowPtr c = w->firstChild; c != NULL; c = c->nextSib) {
+			if (c->mapped && c->drawable.class_ == InputOutput
+				&& vInside(c, x, y)) {
+				next = c;
+				break;
+			}
+		}
+		w = next;
+	}
+	return best;
+}
+
+
+static void
+vSendEnter(WindowPtr target)
+{
+	WindowPtr source = VClipboardWindow();
+	if (source == NULL)
+		return;
+
+	long more = sTypes.size() > 3 ? 1 : 0;
+	if (more) {
+		dixChangeWindowProperty(serverClient, source, vA("XdndTypeList"),
+			XA_ATOM, 32, PropModeReplace, sTypes.size(), sTypes.data(), TRUE);
+	}
+	long t[3] = { 0, 0, 0 };
+	for (size_t i = 0; i < 3 && i < sTypes.size(); i++)
+		t[i] = (long)sTypes[i];
+	vSendMessage(target, vA("XdndEnter"), source->drawable.id,
+		((long)sSession.version << 24) | more, t[0], t[1], t[2]);
+}
+
+
+static void
+vSendPosition(WindowPtr target, int32 x, int32 y)
+{
+	WindowPtr source = VClipboardWindow();
+	if (source == NULL)
+		return;
+
+	sSession.waiting = true;
+	sSession.sentAt = system_time();
+	sSession.hasPending = false;
+	sSession.lastX = x;
+	sSession.lastY = y;
+	vSendMessage(target, vA("XdndPosition"), source->drawable.id, 0,
+		((long)(x & 0xffff) << 16) | (y & 0xffff),
+		(long)currentTime.milliseconds, (long)vA("XdndActionCopy"));
+}
+
+
+static bool
+vPointOf(const BMessage& event, BPoint* where)
+{
+	return event.FindPoint("screen_where", where) == B_OK
+		|| event.FindPoint("where", where) == B_OK;
+}
+
+
+//	#pragma mark - X to V\OS
+
+
+class VDragHost : public BWindow {
+public:
+	VDragHost()
+		:
+		BWindow(BRect(-200, -200, -190, -190), "xdnd",
+			B_NO_BORDER_WINDOW_LOOK, B_NORMAL_WINDOW_FEEL,
+			B_NOT_ZOOMABLE | B_AVOID_FOCUS | B_NOT_MOVABLE),
+		fView(new BView(Bounds(), "xdnd", B_FOLLOW_ALL, 0))
+	{
+		AddChild(fView);
+	}
+
+	virtual void MessageReceived(BMessage* message)
+	{
+		if (message->what != 'XDnd') {
+			BWindow::MessageReceived(message);
+			return;
+		}
+
+		BMessage drag;
+		if (message->FindMessage("drag", &drag) != B_OK)
+			return;
+		drag.AddBool(kOriginField, true);
+		fView->DragMessage(&drag, NULL, B_OP_BLEND, BPoint(0, 0), fView);
+	}
+
+private:
+	BView*	fView;
+};
+
+static VDragHost* sHost = NULL;
+
+enum {
+	kFetchIdle = 0,
+	kFetching,
+	kFetchDone
+};
+
+static int sFetchState = kFetchIdle;
+static size_t sFetchIndex = 0;
+static int32 sFetchButtons = 0;
+
+
+static Atom
+vFetchTarget(size_t index)
+{
+	switch (index) {
+		case 0:
+			return vA("text/uri-list");
+		case 1:
+			return vA("text/plain;charset=utf-8");
+		case 2:
+			return vA("UTF8_STRING");
+		case 3:
+			return XA_STRING;
+	}
+	return None;
+}
+
+
+static void
+vRequestFetch(Selection* pSel)
+{
+	WindowPtr source = VClipboardWindow();
+	Atom target = vFetchTarget(sFetchIndex);
+	if (source == NULL || target == None) {
+		sFetchState = kFetchDone;
+		return;
+	}
+
+	xEvent event;
+	memset(&event, 0, sizeof(event));
+	event.u.u.type = SelectionRequest;
+	event.u.selectionRequest.time = pSel->lastTimeChanged.milliseconds;
+	event.u.selectionRequest.owner = pSel->window;
+	event.u.selectionRequest.requestor = source->drawable.id;
+	event.u.selectionRequest.selection = pSel->selection;
+	event.u.selectionRequest.target = target;
+	event.u.selectionRequest.property = vA("_VOS_XDND");
+	WriteEventsToClient(pSel->client, 1, &event);
+}
+
+
+static int
+vHexValue(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F')
+		return c - 'A' + 10;
+	return -1;
+}
+
+
+static void
+vPostDrag(BMessage& drag, int32 buttons)
+{
+	if (sHost == NULL)
+		return;
+
+	drag.AddInt32("buttons", buttons);
+	BMessage post('XDnd');
+	post.AddMessage("drag", &drag);
+	sHost->PostMessage(&post);
+}
+
+
+static void
+vFetchComplete(Atom target, const uint8* data, size_t size)
+{
+	BMessage drag;
+	if (target == vA("text/uri-list")) {
+		drag.what = B_SIMPLE_DATA;
+		BString all((const char*)data, size);
+		int32 start = 0;
+		bool any = false;
+		while (start < all.Length()) {
+			int32 end = all.FindFirst('\n', start);
+			if (end < 0)
+				end = all.Length();
+			BString line;
+			all.CopyInto(line, start, end - start);
+			line.RemoveAll("\r");
+			start = end + 1;
+			if (!line.StartsWith("file://"))
+				continue;
+
+			// Percent-decode the path after the (empty) host.
+			BString path;
+			const char* p = line.String() + 7;
+			p = strchr(p, '/');
+			if (p == NULL)
+				continue;
+			for (; *p != '\0'; p++) {
+				if (*p == '%' && vHexValue(p[1]) >= 0 && vHexValue(p[2]) >= 0) {
+					char c = (char)(vHexValue(p[1]) * 16 + vHexValue(p[2]));
+					path.Append(&c, 1);
+					p += 2;
+				} else
+					path.Append(p, 1);
+			}
+
+			entry_ref ref;
+			if (get_ref_for_path(path.String(), &ref) == B_OK) {
+				drag.AddRef("refs", &ref);
+				any = true;
+			}
+		}
+		if (!any)
+			return;
+	} else {
+		drag.what = B_MIME_DATA;
+		BString text;
+		if (target == XA_STRING) {
+			for (size_t i = 0; i < size; i++) {
+				if (data[i] < 0x80)
+					text.Append((const char*)&data[i], 1);
+				else {
+					char pair[2] = { (char)(0xc0 | (data[i] >> 6)),
+						(char)(0x80 | (data[i] & 0x3f)) };
+					text.Append(pair, 2);
+				}
+			}
+		} else
+			text.SetTo((const char*)data, size);
+		if (text.Length() == 0)
+			return;
+		drag.AddData("text/plain", B_MIME_TYPE, text.String(), text.Length());
+	}
+
+	vPostDrag(drag, sFetchButtons);
+}
+
+
+// A SelectionNotify the XDND source answered our fetch with.
+static void
+vFetchNotify(xEvent* event)
+{
+	WindowPtr source = VClipboardWindow();
+	if (source == NULL || sFetchState != kFetching)
+		return;
+
+	Atom property = event->u.selectionNotify.property;
+	Atom target = event->u.selectionNotify.target;
+	if (property != None) {
+		PropertyPtr prop = NULL;
+		if (dixLookupProperty(&prop, source, vA("_VOS_XDND"), serverClient,
+				DixReadAccess) == Success && prop != NULL
+			&& prop->format == 8 && prop->size > 0) {
+			sFetchState = kFetchDone;
+			vFetchComplete(target, (const uint8*)prop->data, prop->size);
+			DeleteProperty(serverClient, source, vA("_VOS_XDND"));
+			return;
+		}
+	}
+
+	Selection* pSel = NULL;
+	if (++sFetchIndex < 4 && dixLookupSelection(&pSel, vA("XdndSelection"),
+			serverClient, DixGetAttrAccess) == Success && pSel->client != NULL)
+		vRequestFetch(pSel);
+	else
+		sFetchState = kFetchDone;
+}
+
+
+static void
+vCheckXSource(const BMessage& event, BPoint where)
+{
+	int32 buttons = 0;
+	event.FindInt32("buttons", &buttons);
+	if (buttons == 0) {
+		sFetchState = kFetchIdle;
+		sFetchIndex = 0;
+		return;
+	}
+	if (sFetchState != kFetchIdle)
+		return;
+
+	WindowPtr clip = VClipboardWindow();
+	Selection* pSel = NULL;
+	if (clip == NULL || dixLookupSelection(&pSel, vA("XdndSelection"),
+			serverClient, DixGetAttrAccess) != Success
+		|| pSel->pWin == NULL || pSel->pWin == clip
+		|| pSel->client == NullClient)
+		return;
+
+	// An explicit grab by the selection owner is a drag in progress; an
+	// implicit one is just a button held in an X window.
+	DeviceIntPtr pointer = inputInfo.pointer;
+	if (pointer == NULL || pointer->deviceGrab.grab == NULL
+		|| pointer->deviceGrab.implicitGrab
+		|| (int)CLIENT_ID(pointer->deviceGrab.grab->resource)
+			!= pSel->client->index)
+		return;
+
+	if (vTopWindowAt((int32)where.x, (int32)where.y, true) != NULL)
+		return;
+
+	sFetchState = kFetching;
+	sFetchIndex = 0;
+	sFetchButtons = buttons;
+	vRequestFetch(pSel);
+}
+
+
+//	#pragma mark - entry points
+
+
+void
+VDndInit()
+{
+	if (sHost != NULL)
+		return;
+
+	sHost = new(std::nothrow) VDragHost();
+	if (sHost != NULL)
+		sHost->Run();
+}
+
+
+// B_MOUSE_MOVED on a surface; with be:drag_message a V\OS drag is over
+// X, without one an X drag may have left it.
+void
+VDndPointerMoved(const BMessage& event)
+{
+	BPoint where;
+	if (!vPointOf(event, &where))
+		return;
+
+	BMessage drag;
+	if (event.FindMessage("be:drag_message", &drag) != B_OK) {
+		if (sDragSeen) {
+			sDragSeen = false;
+			if (sSession.active && !sSession.dropped)
+				vEndSession(true);
+		}
+		vCheckXSource(event, where);
+		return;
+	}
+
+	if (!sDragSeen) {
+		sDragSeen = true;
+		sDragUsable = vBuildData(drag);
+		if (sSession.active)
+			vEndSession(false);
+	}
+	if (!sDragUsable || sSession.dropped)
+		return;
+
+	int32 x = (int32)where.x;
+	int32 y = (int32)where.y;
+	int version = 0;
+	WindowPtr top = vTopWindowAt(x, y, false);
+	WindowPtr target = top != NULL ? vFindAware(top, x, y, &version) : NULL;
+	WindowPtr source = VClipboardWindow();
+	if (target == NULL || source == NULL) {
+		if (sSession.active)
+			vEndSession(true);
+		return;
+	}
+
+	if (sSession.active && sSession.target != target->drawable.id)
+		vEndSession(true);
+
+	if (!sSession.active) {
+		if (!sOwning) {
+			VSelectionTake(vA("XdndSelection"));
+			sOwning = true;
+		}
+		sSession.active = true;
+		sSession.target = target->drawable.id;
+		sSession.version = version;
+		sSession.accepted = false;
+		sSession.waiting = false;
+		vSendEnter(target);
+		vSendPosition(target, x, y);
+		return;
+	}
+
+	if (x == sSession.lastX && y == sSession.lastY)
+		return;
+
+	if (sSession.waiting
+		&& system_time() - sSession.sentAt < kStatusTimeout) {
+		sSession.hasPending = true;
+		sSession.pendingX = x;
+		sSession.pendingY = y;
+		return;
+	}
+	vSendPosition(target, x, y);
+}
+
+
+// The drop arrives as the dropped message on the surface under the
+// pointer.
+void
+VDndDropped(const BMessage& event)
+{
+	BPoint where;
+	if (!sSession.active || sSession.dropped || !vPointOf(event, &where))
+		return;
+
+	WindowPtr target = vFind(sSession.target);
+	WindowPtr source = VClipboardWindow();
+	if (target == NULL || source == NULL) {
+		vEndSession(false);
+		return;
+	}
+
+	if (!sSession.accepted) {
+		vEndSession(true);
+		return;
+	}
+
+	if ((int32)where.x != sSession.lastX || (int32)where.y != sSession.lastY)
+		vSendPosition(target, (int32)where.x, (int32)where.y);
+
+	sSession.dropped = true;
+	sDragSeen = false;
+	vSendMessage(target, vA("XdndDrop"), source->drawable.id, 0,
+		(long)currentTime.milliseconds, 0, 0);
+	sFinishTimer = TimerSet(sFinishTimer, 0, kFinishTimeout, vFinishTimeout,
+		NULL);
+}
+
+
+// SendEvent requests addressed to the bridge window: XDND replies from
+// the target and the answer to an X-source fetch.
+bool
+VDndSendEvent(xEvent* event)
+{
+	uint8 type = event->u.u.type & 0x7f;
+	if (type == SelectionNotify) {
+		if (event->u.selectionNotify.selection != vA("XdndSelection"))
+			return false;
+		vFetchNotify(event);
+		return true;
+	}
+	if (type != ClientMessage)
+		return false;
+
+	auto* message = &event->u.clientMessage;
+	if (message->u.l.type == vA("XdndStatus")) {
+		if (!sSession.active || (Window)message->u.l.longs0 != sSession.target)
+			return true;
+
+		sSession.accepted = (message->u.l.longs1 & 1) != 0;
+		sSession.waiting = false;
+		if (sSession.hasPending && !sSession.dropped) {
+			WindowPtr target = vFind(sSession.target);
+			if (target != NULL) {
+				vSendPosition(target, sSession.pendingX, sSession.pendingY);
+			}
+		}
+		return true;
+	}
+	if (message->u.l.type == vA("XdndFinished")) {
+		if (sSession.active && sSession.dropped
+			&& (Window)message->u.l.longs0 == sSession.target) {
+			vEndSession(false);
+		}
+		return true;
+	}
+	return false;
+}
