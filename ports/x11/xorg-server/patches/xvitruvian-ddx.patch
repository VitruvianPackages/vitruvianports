+
+static int
+vKeyboardProc(DeviceIntPtr pDevice, int onoff)
+{
+	switch (onoff) {
+		case DEVICE_INIT:
+		{
+			XkbRMLVOSet rmlvo;
+			memset(&rmlvo, 0, sizeof(rmlvo));
+			vFillRMLVO(&rmlvo);
+			InitKeyboardDeviceStruct(pDevice, &rmlvo, NULL,
+				(KbdCtrlProcPtr)NoopDDA);
+			break;
+		}
+		case DEVICE_ON:
+			pDevice->public_.on = TRUE;
+			break;
+		case DEVICE_OFF:
+			pDevice->public_.on = FALSE;
+			break;
+		case DEVICE_CLOSE:
+			break;
+	}
+	return Success;
+}
+
+
+static int
+vPointerProc(DeviceIntPtr pDevice, int onoff)
+{
+#define NBUTTONS 7
+#define NAXES 4
+
+	switch (onoff) {
+		case DEVICE_INIT:
+		{
+			BYTE map[NBUTTONS + 1];
+			Atom btn_labels[NBUTTONS] = { 0 };
+			Atom axes_labels[NAXES] = { 0 };
+
+			// 4-7 are the wheel buttons.
+			for (int i = 1; i <= NBUTTONS; i++)
+				map[i] = i;
+
+			btn_labels[0] = XIGetKnownProperty(BTN_LABEL_PROP_BTN_LEFT);
+			btn_labels[1] = XIGetKnownProperty(BTN_LABEL_PROP_BTN_MIDDLE);
+			btn_labels[2] = XIGetKnownProperty(BTN_LABEL_PROP_BTN_RIGHT);
+			btn_labels[3] = XIGetKnownProperty(BTN_LABEL_PROP_BTN_WHEEL_UP);
+			btn_labels[4] = XIGetKnownProperty(BTN_LABEL_PROP_BTN_WHEEL_DOWN);
+			btn_labels[5] = XIGetKnownProperty(BTN_LABEL_PROP_BTN_HWHEEL_LEFT);
+			btn_labels[6] = XIGetKnownProperty(BTN_LABEL_PROP_BTN_HWHEEL_RIGHT);
+
+			axes_labels[0] = XIGetKnownProperty(AXIS_LABEL_PROP_ABS_X);
+			axes_labels[1] = XIGetKnownProperty(AXIS_LABEL_PROP_ABS_Y);
+			axes_labels[2] = XIGetKnownProperty(AXIS_LABEL_PROP_REL_VSCROLL);
+			axes_labels[3] = XIGetKnownProperty(AXIS_LABEL_PROP_REL_HSCROLL);
+
+			InitPointerDeviceStruct((DevicePtr)pDevice, map, NBUTTONS,
+				btn_labels, (PtrCtrlProcPtr)NoopDDA,
+				GetMotionHistorySize(), NAXES, axes_labels);
+
+			int maxX = gVScreen != NULL ? gVScreen->width - 1 : 16383;
+			int maxY = gVScreen != NULL ? gVScreen->height - 1 : 16383;
+			InitValuatorAxisStruct(pDevice, 0, axes_labels[0], 0, maxX,
+				0, 0, 0, Absolute);
+			InitValuatorAxisStruct(pDevice, 1, axes_labels[1], 0, maxY,
+				0, 0, 0, Absolute);
+			InitValuatorAxisStruct(pDevice, 2, axes_labels[2],
+				NO_AXIS_LIMITS, NO_AXIS_LIMITS, 1, 0, 1, Relative);
+			InitValuatorAxisStruct(pDevice, 3, axes_labels[3],
+				NO_AXIS_LIMITS, NO_AXIS_LIMITS, 1, 0, 1, Relative);
+			SetScrollValuator(pDevice, 2, SCROLL_TYPE_VERTICAL, 1.0,
+				SCROLL_FLAG_PREFERRED);
+			SetScrollValuator(pDevice, 3, SCROLL_TYPE_HORIZONTAL, 1.0,
+				SCROLL_FLAG_NONE);
+			break;
+		}
+		case DEVICE_ON:
+			pDevice->public_.on = TRUE;
+			break;
+		case DEVICE_OFF:
+			pDevice->public_.on = FALSE;
+			break;
+		case DEVICE_CLOSE:
+			break;
+	}
+	return Success;
+
+#undef NBUTTONS
+#undef NAXES
+}
+
+
+// V\OS input device ids and X device ids are separate spaces; slaves are
+// found through this table. Appended on the server thread only.
+struct VSlave {
+	int32			sourceId;
+	bool			pointer;
+	DeviceIntPtr	device;
+};
+static const int32 kMaxSlaves = 32;
+static VSlave sSlaves[kMaxSlaves];
+static int32 sSlaveCount = 0;
+
+
+// Recompiles the keymap from the current V\OS layout and applies it to
+// the master and every keyboard, so clients get a MappingNotify.
+void
+VReloadKeymap()
+{
+	if (inputInfo.keyboard == NULL)
+		return;
+
+	XkbRMLVOSet rmlvo;
+	memset(&rmlvo, 0, sizeof(rmlvo));
+	vFillRMLVO(&rmlvo);
+	XkbDescPtr desc = XkbCompileKeymap(inputInfo.keyboard, &rmlvo);
+	if (desc == NULL)
+		return;
+
+	XkbDeviceApplyKeymap(inputInfo.keyboard, desc);
+	int32 count = atomic_get(&sSlaveCount);
+	for (int32 i = 0; i < count; i++) {
+		if (!sSlaves[i].pointer && sSlaves[i].device != NULL)
+			XkbDeviceApplyKeymap(sSlaves[i].device, desc);
+	}
+	XkbFreeKeyboard(desc, XkbAllComponentsMask, TRUE);
+}
+
+
+static DeviceIntPtr
+vFindSlave(int32 sourceId, bool pointer)
+{
+	int32 count = atomic_get(&sSlaveCount);
+	for (int32 i = 0; i < count; i++) {
+		if (sSlaves[i].sourceId == sourceId && sSlaves[i].pointer == pointer)
+			return sSlaves[i].device;
+	}
+	return NULL;
+}
+
+
+static DeviceIntPtr
+vEnsureSlave(int32 deviceId, bool pointer, const char* name)
+{
+	// sPointerMaster/sKeyboardMaster are slaves themselves; new devices
+	// attach to the core masters.
+	DeviceIntPtr master = pointer ? inputInfo.pointer : inputInfo.keyboard;
+	if (master == NULL)
+		return NULL;
+
+	DeviceIntPtr existing = vFindSlave(deviceId, pointer);
+	if (existing != NULL)
+		return existing;
+	if (atomic_get(&sSlaveCount) >= kMaxSlaves)
+		return NULL;
+
+	DeviceIntPtr dev = AddInputDevice(serverClient,
+		pointer ? vPointerProc : vKeyboardProc, TRUE);
+	if (dev == NULL)
+		return NULL;
+
+	Atom type = MakeAtom(pointer ? XI_MOUSE : XI_KEYBOARD,
+		strlen(pointer ? XI_MOUSE : XI_KEYBOARD), TRUE);
+	char label[64];
+	snprintf(label, sizeof(label), "%s %d",
+		pointer ? "Vitruvian pointer" : "Vitruvian keyboard",
+		(int)deviceId);
+	AssignTypeAndName(dev, type, label);
+
+	// Devices added after startup are not enabled for us.
+	if (ActivateDevice(dev, TRUE) != Success || !EnableDevice(dev, TRUE))
+		return NULL;
+
+	AttachDevice(serverClient, dev, master);
+
+	int32 index = atomic_get(&sSlaveCount);
+	sSlaves[index].sourceId = deviceId;
+	sSlaves[index].pointer = pointer;
+	sSlaves[index].device = dev;
+	atomic_add(&sSlaveCount, 1);
+	return dev;
+}
+
+
+static void
+vQueueDevice(int32 deviceId, bool pointer, const char* name)
+{
+	if (sPendingLock < B_OK)
+		return;
+	if (acquire_sem(sPendingLock) != B_OK)
+		return;
+
+	// Already present?
+	for (VInputDevice* entry = sPendingDevices; entry != NULL;
+			entry = entry->next) {
+		if (entry->id == deviceId && entry->pointer == pointer) {
+			release_sem(sPendingLock);
+			return;
+		}
+	}
+
+	VInputDevice* entry = new(std::nothrow) VInputDevice;
+	if (entry == NULL) {
+		release_sem(sPendingLock);
+		return;
+	}
+	entry->id = deviceId;
+	entry->pointer = pointer;
+	snprintf(entry->name, sizeof(entry->name), "%s",
+		name != NULL ? name : "Vitruvian input");
+	entry->next = sPendingDevices;
+	sPendingDevices = entry;
+	release_sem(sPendingLock);
+
+	// VDrainInputPort runs on the server thread and creates the device.
+	VWakeServer();
+}
+
+
+//	#pragma mark - event conversion
+
+
+static int32
+vXButton(int32 legacyBit)
+{
+	switch (legacyBit) {
+		case 0x1:
+			return 1;
+		case 0x2:
+			return 3;
+		case 0x4:
+			return 2;
+		default:
+			// Extra buttons follow the wheel range: bit 3 is button 8.
+			return (int32)__builtin_ctz((uint32)legacyBit) + 5;
+	}
+}
+
+
+// Reverse of the hybrid contract for synthetic releases that arrive
+// without be:evdev_code; covers the well-known legacy codes only.
+static uint32
+vLegacyToEvdev(uint32 legacy)
+{
+	static const struct {
+		uint32	legacy;
+		uint32	evdev;
+	} kMap[] = {
+		{ 0x01, 0x01 }, { 0x02, 0x3b }, { 0x03, 0x3c }, { 0x04, 0x3d },
+		{ 0x05, 0x3e }, { 0x06, 0x3f }, { 0x07, 0x40 }, { 0x08, 0x41 },
+		{ 0x09, 0x42 }, { 0x0a, 0x43 }, { 0x0b, 0x44 }, { 0x0c, 0x57 },
+		{ 0x0d, 0x58 }, { 0x0e, 0x63 }, { 0x0f, 0x46 }, { 0x10, 0x77 },
+		{ 0x11, 0x29 }, { 0x1e, 0x0e }, { 0x1f, 0x6e }, { 0x20, 0x66 },
+		{ 0x21, 0x68 }, { 0x22, 0x45 }, { 0x26, 0x0f }, { 0x34, 0x6f },
+		{ 0x35, 0x6b }, { 0x36, 0x6d }, { 0x3b, 0x3a }, { 0x47, 0x1c },
+		{ 0x4b, 0x2a }, { 0x56, 0x36 }, { 0x57, 0x67 }, { 0x5b, 0x60 },
+		{ 0x5c, 0x1d }, { 0x5d, 0x38 }, { 0x5e, 0x39 }, { 0x5f, 0x64 },
+		{ 0x60, 0x61 }, { 0x61, 0x69 }, { 0x62, 0x6c }, { 0x63, 0x6a },
+		{ 0x66, 0x7d }, { 0x67, 0x7e },
+	};
+
+	for (size_t i = 0; i < sizeof(kMap) / sizeof(kMap[0]); i++) {
+		if (kMap[i].legacy == legacy)
+			return kMap[i].evdev;
+	}
+	return 0;
+}
+
+
+static DeviceIntPtr
+vSourceDevice(const BMessage& msg, bool pointer)
+{
+	DeviceIntPtr dev = pointer ? sPointerMaster : sKeyboardMaster;
+	int32 sourceId = -1;
+	if (msg.FindInt32("be:device_id", &sourceId) != B_OK || sourceId < 0)
+		return dev;
+
+	const char* name = NULL;
+	msg.FindString("be:device_name", &name);
+	DeviceIntPtr slave = vFindSlave(sourceId, pointer);
+	if (slave != NULL)
+		return slave;
+
+	// Created on the server thread; the master carries events until then.
+	vQueueDevice(sourceId, pointer, name);
+	return dev;
+}
+
+
+static void
+vHandleKey(const BMessage& msg)
+{
+	if (sKeyboardMaster == NULL)
+		return;
+
+	int32 evdevCode = -1;
+	if (msg.FindInt32("be:evdev_code", &evdevCode) != B_OK) {
+		int32 hybrid = 0;
+		if (msg.FindInt32("key", &hybrid) != B_OK)
+			return;
+		if (hybrid >= 0x80)
+			evdevCode = hybrid;
+		else
+			evdevCode = (int32)vLegacyToEvdev((uint32)hybrid);
+	}
+	if (evdevCode <= 0)
+		return;
+
+	// X keycodes are the xkb space: evdev code + 8, the same rule
+	// input_server's xkbcommon state uses.
+	int32 keycode = evdevCode + 8;
+
+	DeviceIntPtr dev = vSourceDevice(msg, false);
+
+	int type = 0;
+	switch (msg.what) {
+		case B_KEY_DOWN:
+		case B_UNMAPPED_KEY_DOWN:
+			type = KeyPress;
+			break;
+		case B_KEY_UP:
+		case B_UNMAPPED_KEY_UP:
+			type = KeyRelease;
+			break;
+		default:
+			return;
+	}
+
+	input_lock();
+	QueueKeyboardEvents(dev, type, keycode);
+	input_unlock();
+	vPokeEQ();
+}
+
+
+static void
+vHandlePointer(const BMessage& msg)
+{
+	if (sPointerMaster == NULL)
+		return;
+
+	DeviceIntPtr dev = vSourceDevice(msg, true);
+
+	// Window messages carry the seat position as screen_where.
+	BPoint where;
+	bool hasWhere = msg.FindPoint("screen_where", &where) == B_OK
+		|| msg.FindPoint("where", &where) == B_OK;
+
+	switch (msg.what) {
+		case B_MOUSE_MOVED:
+		{
+			// Every surface listens to all pointer motion; send each
+			// position once.
+			if (!hasWhere || where == sLastWhere)
+				return;
+			sLastWhere = where;
+
+			ValuatorMask mask;
+			valuator_mask_zero(&mask);
+			valuator_mask_set_double(&mask, 0, where.x);
+			valuator_mask_set_double(&mask, 1, where.y);
+
+			input_lock();
+			QueuePointerEvents(dev, MotionNotify, 0,
+				POINTER_ABSOLUTE
+					| (atomic_get(&sTapRaw) != 0 ? POINTER_NORAW : 0), &mask);
+			input_unlock();
+			vPokeEQ();
+			break;
+		}
+		case B_MOUSE_DOWN:
+		case B_MOUSE_UP:
+		{
+			int32 buttons = 0;
+			msg.FindInt32("buttons", &buttons);
+			// Listener copies reach every surface; only the surface under
+			// the pointer (it carries _view_token) starts a press, so a click
+			// on a native window above never reaches X. Releases always pass.
+			if (msg.what == B_MOUSE_DOWN && sLastButtons == 0
+				&& !msg.HasInt32("_view_token")) {
+				return;
+			}
+			uint32 changed = (uint32)buttons ^ sLastButtons;
+			sLastButtons = (uint32)buttons;
+
+			input_lock();
+			for (int32 bit = 0; bit < 8; bit++) {
+				if ((changed & (1 << bit)) == 0)
+					continue;
+				int type = (buttons & (1 << bit)) != 0
+					? ButtonPress : ButtonRelease;
+				QueuePointerEvents(dev, type, vXButton(1 << bit), 0,
+					NULL);
+			}
+			input_unlock();
+			vPokeEQ();
+			break;
+		}
+		case B_MOUSE_WHEEL_CHANGED:
+		{
+			float wheelX = 0;
+			float wheelY = 0;
+			msg.FindFloat("be:wheel_delta_x", &wheelX);
+			msg.FindFloat("be:wheel_delta_y", &wheelY);
+
+			input_lock();
+			if (wheelY > 0) {
+				QueuePointerEvents(dev, ButtonPress, 5, 0, NULL);
+				QueuePointerEvents(dev, ButtonRelease, 5, 0, NULL);
+			} else if (wheelY < 0) {
+				QueuePointerEvents(dev, ButtonPress, 4, 0, NULL);
+				QueuePointerEvents(dev, ButtonRelease, 4, 0, NULL);
+			}
+			if (wheelX > 0) {
+				QueuePointerEvents(dev, ButtonPress, 7, 0, NULL);
+				QueuePointerEvents(dev, ButtonRelease, 7, 0, NULL);
+			} else if (wheelX < 0) {
+				QueuePointerEvents(dev, ButtonPress, 6, 0, NULL);
+				QueuePointerEvents(dev, ButtonRelease, 6, 0, NULL);
+			}
+			input_unlock();
+			vPokeEQ();
+			break;
+		}
+		default:
+			break;
+	}
+}
+
+
+// XI2 raw motion: the pre-acceleration deltas the device add-ons attach
+// and the tap forwards; games and canvas apps read the raw event.
+static void
+vHandleRawMotion(const BMessage& msg)
+{
+	if (msg.what != B_MOUSE_MOVED || sPointerMaster == NULL)
+		return;
+
+	float rawX = 0;
+	float rawY = 0;
+	if (msg.FindFloat("be:raw_delta_x", &rawX) != B_OK
+		&& msg.FindFloat("be:raw_delta_y", &rawY) != B_OK) {
+		return;
+	}
+
+	atomic_set(&sTapRaw, 1);
+	// This runs on the tap thread; slave devices belong to the server
+	// thread, the master pointer is always there.
+	DeviceIntPtr dev = sPointerMaster;
+
+	RawDeviceEvent raw;
+	memset(&raw, 0, sizeof(raw));
+	raw.header = ET_Internal;
+	raw.type = ET_RawMotion;
+	raw.length = sizeof(raw);
+	raw.time = GetTimeInMillis();
+	raw.deviceid = dev->id;
+	raw.sourceid = dev->id;
+	raw.valuators.mask[0] |= 1 << 0;
+	raw.valuators.mask[1] |= 1 << 1;
+	raw.valuators.data[0] = rawX;
+	raw.valuators.data[1] = rawY;
+	raw.valuators.data_raw[0] = rawX;
+	raw.valuators.data_raw[1] = rawY;
+
+	input_lock();
+	mieqEnqueue(dev, (InternalEvent*)&raw);
+	input_unlock();
+	vPokeEQ();
+}
+
+
+static void
+vHandleEvent(const BMessage& msg)
+{
+	switch (msg.what) {
+		case B_KEY_DOWN:
+		case B_KEY_UP:
+		case B_UNMAPPED_KEY_DOWN:
+		case B_UNMAPPED_KEY_UP:
+			vHandleKey(msg);
+			break;
+		case B_MOUSE_MOVED:
+		case B_MOUSE_DOWN:
+		case B_MOUSE_UP:
+		case B_MOUSE_WHEEL_CHANGED:
+			vHandlePointer(msg);
+			break;
+		default:
+			break;
+	}
+}
+
+
+//	#pragma mark - server thread side
+
+
+// Called on the server thread from the surface notify fd; events still go
+// through the input lock and the event queue.
+void
+VHandleWindowInput(const BMessage& msg)
+{
+	vHandleEvent(msg);
+}
+
+
+void
+VDrainInputPort()
+{
+	// Pull pending XI2 slave devices on the server thread; the input
+	// thread only queues their identities.
+	if (sPendingLock < B_OK)
+		return;
+	if (acquire_sem(sPendingLock) != B_OK)
+		return;
+
+	VInputDevice* entry = sPendingDevices;
+	sPendingDevices = NULL;
+	release_sem(sPendingLock);
+
+	while (entry != NULL) {
+		VInputDevice* next = entry->next;
+		vEnsureSlave(entry->id, entry->pointer, entry->name);
+		delete entry;
+		entry = next;
+	}
+}
+
+
+// A popup's grab never sees clicks on app_server chrome or other V\OS
+// windows; synthesize the outside click toolkits close menus on.
+static void
+vBreakPopupGrabs()
+{
+	DeviceIntPtr pointer = inputInfo.pointer;
+	if (pointer != NULL && pointer->deviceGrab.grab != NULL) {
+		WindowPtr grabWin = pointer->deviceGrab.grab->window;
+		if (grabWin != NULL && grabWin->overrideRedirect) {
+			QueuePointerEvents(pointer, ButtonPress, 1, 0, NULL);
+			QueuePointerEvents(pointer, ButtonRelease, 1, 0, NULL);
+		}
+	}
+
+	DeviceIntPtr keyboard = inputInfo.keyboard;
+	if (keyboard != NULL && keyboard->deviceGrab.grab != NULL) {
+		WindowPtr grabWin = keyboard->deviceGrab.grab->window;
+		if (grabWin != NULL && grabWin->overrideRedirect)
+			(*keyboard->deviceGrab.DeactivateGrab)(keyboard);
+	}
+}
+
+
+void
+VSetWindowFocus(uint32 windowId, bool activated)
+{
+	ScreenPtr pScreen = gVScreen;
+	if (pScreen == NULL)
+		return;
+
+	vBreakPopupGrabs();
+
+	if (activated) {
+		WindowPtr pWin = VWindowForId(windowId);
+		if (pWin == NULL)
+			return;
+		SetInputFocus(serverClient, inputInfo.keyboard, pWin->drawable.id,
+			RevertToPointerRoot, currentTime.milliseconds, FALSE);
+		atomic_set(&gVFocusWindowId, (int32)windowId);
+	} else if ((uint32)atomic_get(&gVFocusWindowId) == windowId) {
+		SetInputFocus(serverClient, inputInfo.keyboard,
+			pScreen->root->drawable.id,
+			RevertToPointerRoot, currentTime.milliseconds, FALSE);
+		atomic_set(&gVFocusWindowId, 0);
+	}
+
+	VSetFocusViewCursor();
+}
+
+
+void
+VSetFocusViewCursor()
+{
+	// Cursor image translation is app_server's; X-side cursor shapes
+	// only restore or hide the seat cursor on the focused window until
+	// the image bridge lands with the input lane follow-up.
+	uint32 focusId = (uint32)atomic_get(&gVFocusWindowId);
+	if (focusId == 0)
+		return;
+
+	WindowPtr pWin = VWindowForId(focusId);
+	VWindowPriv* priv = VWindowPrivFor(pWin);
+	if (priv == NULL || priv->surface == NULL)
+		return;
+}
+
+
+//	#pragma mark - input thread
+
+
+static int32
+vInputThreadFunc(void* /*data*/)
+{
+	uint8 buffer[4096];
+
+	while (atomic_get(&sInputQuit) == 0) {
+		port_id port = gVInputPort;
+		if (port < B_OK) {
+			port = find_port(XVITRUVIAN_INPUT_PORT_NAME);
+			if (port < B_OK) {
+				snooze(50 * 1000);
+				continue;
+			}
+			gVInputPort = port;
+		}
+
+		int32 code = 0;
+		ssize_t size = read_port_etc(port, &code, buffer, sizeof(buffer),
+			B_RELATIVE_TIMEOUT, 100 * 1000);
+		if (size == B_BAD_PORT_ID || size == B_BAD_VALUE) {
+			// Stale id; look the port up again. The tap is optional.
+			gVInputPort = -1;
+			continue;
+		}
+		if (size <= 0)
+			continue;
+
+		BMessage msg;
+		if (msg.Unflatten((const char*)buffer) == B_OK)
+			vHandleRawMotion(msg);
+	}
+
+	return 0;
+}
+
+
+void
+VStartInputThread()
+{
+	if (sPendingLock < B_OK)
+		sPendingLock = create_sem(1, "xvitruvian input devices");
+
+	gVInputPort = create_port(256, XVITRUVIAN_INPUT_PORT_NAME);
+	if (gVInputPort < B_OK)
+		gVInputPort = -1;
+
+	if (sInputThread < B_OK) {
+		atomic_set(&sInputQuit, 0);
+		sInputThread = spawn_thread(vInputThreadFunc, "xv input",
+			B_URGENT_DISPLAY_PRIORITY, NULL);
+		if (sInputThread >= B_OK)
+			resume_thread(sInputThread);
+	}
+}
+
+
+void
+VStopInputThread()
+{
+	if (atomic_get_and_set(&sInputQuit, 1) == 0 && sInputThread >= B_OK) {
+		int32 status;
+		wait_for_thread(sInputThread, &status);
+	}
+	sInputThread = -1;
+}
+
+
+extern "C" void
+InitInput(int argc, char* argv[])
+{
+	VInitInputDevices(argc, argv);
+}
+
+
+extern "C" void
+CloseInput(void)
+{
+	VStopInputThread();
+	mieqFini();
+}
+
+
+extern "C" void
+ProcessInputEvents(void)
+{
+	mieqProcessInputEvents();
+}
+
+
+extern "C" void
+DDXRingBell(int /*volume*/, int /*pitch*/, int /*duration*/)
+{
+}
+
+
+void
+VInitInputDevices(int /*argc*/, char** /*argv*/)
+{
+	if (AllocDevicePair(serverClient, "Vitruvian", &sPointerMaster,
+			&sKeyboardMaster, vPointerProc, vKeyboardProc, FALSE)
+			!= Success) {
+		FatalError("XVitruvian: cannot allocate input devices\n");
+	}
+
+	mieqInit();
+	VStartInputThread();
+}
