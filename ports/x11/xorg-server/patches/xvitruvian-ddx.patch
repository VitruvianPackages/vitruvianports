+// -listenfd N: serve the already listening unix socket N (socket
+// activation); the server then creates no sockets or lock of its own.
+extern "C" int
+ddxProcessArgument(int argc, char** argv, int i)
+{
+	if (strcmp(argv[i], "-listenfd") == 0) {
+		if (i + 1 >= argc)
+			return 0;
+		sListenFd = atoi(argv[i + 1]);
+		NoListenAll = TRUE;
+		return 2;
+	}
+	return 0;
+}
