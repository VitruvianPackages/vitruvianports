+// MIT-SHM for the screen: segment put/get only. Shared pixmaps are left
+// out; clients that draw through them composite blank content.
+struct VShmFuncs {
+	PixmapPtr	(*CreatePixmap)(ScreenPtr, int, int, int, char*);
+	void		(*PutImage)(DrawablePtr, GCPtr, int, unsigned int, int, int,
+					int, int, int, int, int, int, char*);
+};
+
+extern "C" void ShmRegisterFuncs(ScreenPtr pScreen, void* funcs);
+
+static VShmFuncs sShmFuncs = { NULL, NULL };
