+
+static void
+vPublishActions(WindowPtr pWin, bool resizable)
+{
+	Atom actions[8];
+	int count = 0;
+	actions[count++] = vAtom("_NET_WM_ACTION_MOVE");
+	actions[count++] = vAtom("_NET_WM_ACTION_MINIMIZE");
+	actions[count++] = vAtom("_NET_WM_ACTION_CLOSE");
+	if (resizable) {
+		actions[count++] = vAtom("_NET_WM_ACTION_RESIZE");
+		actions[count++] = vAtom("_NET_WM_ACTION_MAXIMIZE_HORZ");
+		actions[count++] = vAtom("_NET_WM_ACTION_MAXIMIZE_VERT");
+		actions[count++] = vAtom("_NET_WM_ACTION_FULLSCREEN");
+	}
+	vSetAtomList(pWin, vAtom("_NET_WM_ALLOWED_ACTIONS"), actions, count);
+}
