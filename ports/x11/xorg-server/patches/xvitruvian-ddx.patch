+
+// Native density from the panel's physical size; 96 when it is unknown
+// or implausible (virtual displays report none).
+int
+VNativeDpi()
+{
+	BScreen screen(0);
+	monitor_info info;
+	if (!screen.IsValid() || screen.GetMonitorInfo(&info) != B_OK)
+		return 96;
+
+	BRect frame = screen.Frame();
+	float width = frame.Width() + 1;
+	if (info.width < 50 || info.width > 5000 || width < 1)
+		return 96;
+
+	int dpi = (int)(width * 25.4f / info.width + 0.5f);
+	return dpi < 48 || dpi > 480 ? 96 : dpi;
+}
+
+
+void
+VScreenMM(int width, int height, int* mmW, int* mmH)
+{
+	int dpi = VNativeDpi();
+	*mmW = (int)((int64_t)width * 254 / (dpi * 10));
+	*mmH = (int)((int64_t)height * 254 / (dpi * 10));
+}
