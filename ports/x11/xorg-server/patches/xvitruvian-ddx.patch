+
+//	#pragma mark - WM properties
+
+
+void
+VSyncWindowTitle(VWindowPriv* priv)
+{
+	if (priv == NULL || priv->surface == NULL)
+		return;
+
+	WindowPtr pWin = vLookupWindow(priv->xWindow);
+	if (pWin == NULL)
+		return;
+
+	Atom utf8Atom = vAtom("UTF8_STRING");
+	Atom netName = vAtom("_NET_WM_NAME");
+
+	// Property data carries no terminator.
+	BString title;
+	PropertyPtr prop = NULL;
+	if (dixLookupProperty(&prop, pWin, netName, serverClient,
+			DixReadAccess) == Success && prop != NULL
+		&& prop->format == 8 && prop->size > 0
+		&& (prop->type == utf8Atom || prop->type == XA_STRING)) {
+		title.SetTo((const char*)prop->data, prop->size);
+	}
+
+	if (title.IsEmpty() && dixLookupProperty(&prop, pWin, XA_WM_NAME,
+			serverClient, DixReadAccess) == Success && prop != NULL
+		&& prop->format == 8 && prop->size > 0) {
+		title.SetTo((const char*)prop->data, prop->size);
+	}
+
+	if (!title.IsEmpty())
+		priv->surface->SetTitle(title.String());
+}
+
+
+// Reads a 32-bit property of any type; returns the item count or -1.
+static int
+vReadCards(WindowPtr pWin, Atom property, CARD32* out, int maxItems)
+{
+	PropertyPtr prop = NULL;
+	if (dixLookupProperty(&prop, pWin, property, serverClient,
+			DixReadAccess) != Success || prop == NULL || prop->format != 32)
+		return -1;
+
+	int count = vMinI((int32)prop->size, maxItems);
+	memcpy(out, prop->data, (size_t)count * sizeof(CARD32));
+	return count;
+}
+
+
+static void
+vSetAtomList(WindowPtr pWin, Atom property, Atom* atoms, int count)
+{
+	dixChangeWindowProperty(serverClient, pWin, property, XA_ATOM, 32,
+		PropModeReplace, count, atoms, TRUE);
+}
+
+
+
+struct VStyle {
+	window_look	look;
+	window_feel	feel;
+	uint32		flags;
+	int32		extents[4];		// left, right, top, bottom
+	bool		resizable;
+	float		limits[4];		// min/max width, min/max height
+};
+
+
+// Decoration, feel and limits a window manager would pick from the
+// client's hints: window type, Motif/GTK decoration hints, transience,
+// size hints and the fullscreen state.
+static void
+vComputeStyle(WindowPtr pWin, VStyle* style)
+{
+	memset(style, 0, sizeof(*style));
+	style->look = B_TITLED_WINDOW_LOOK;
+	style->feel = B_NORMAL_WINDOW_FEEL;
+	style->resizable = true;
+	style->limits[0] = style->limits[2] = 1;
+	style->limits[1] = style->limits[3] = 32767;
+
+	if (pWin->overrideRedirect) {
+		style->look = B_NO_BORDER_WINDOW_LOOK;
+		style->feel = B_FLOATING_APP_WINDOW_FEEL;
+		style->flags = B_AVOID_FOCUS;
+		style->resizable = false;
+		return;
+	}
+
+	bool borderless = false;
+	Atom types[16];
+	int count = vReadAtomList(pWin, vAtom("_NET_WM_WINDOW_TYPE"), types, 16);
+	static const char* const kPopupTypes[] = { "MENU", "DROPDOWN_MENU",
+		"POPUP_MENU", "TOOLTIP", "COMBO", "DND", NULL };
+	bool done = false;
+	for (int i = 0; i < count && !done; i++) {
+		done = true;
+		if (types[i] == vAtom("_NET_WM_WINDOW_TYPE_UTILITY")
+			|| types[i] == vAtom("_NET_WM_WINDOW_TYPE_TOOLBAR")) {
+			style->look = B_FLOATING_WINDOW_LOOK;
+			style->feel = B_FLOATING_APP_WINDOW_FEEL;
+		} else if (types[i] == vAtom("_NET_WM_WINDOW_TYPE_SPLASH")) {
+			borderless = true;
+			style->flags |= B_AVOID_FOCUS;
+		} else if (types[i] == vAtom("_NET_WM_WINDOW_TYPE_NOTIFICATION")) {
+			borderless = true;
+			style->feel = B_FLOATING_ALL_WINDOW_FEEL;
+			style->flags |= B_AVOID_FOCUS;
+		} else if (types[i] == vAtom("_NET_WM_WINDOW_TYPE_DIALOG")
+			|| types[i] == vAtom("_NET_WM_WINDOW_TYPE_NORMAL")) {
+			// titled, normal
+		} else {
+			done = false;
+			for (int k = 0; kPopupTypes[k] != NULL; k++) {
+				char name[64];
+				snprintf(name, sizeof(name), "_NET_WM_WINDOW_TYPE_%s",
+					kPopupTypes[k]);
+				if (types[i] == vAtom(name)) {
+					borderless = true;
+					style->feel = B_FLOATING_APP_WINDOW_FEEL;
+					style->flags |= B_AVOID_FOCUS;
+					done = true;
+				}
+			}
+		}
+	}
+
+	// Modal state makes a transient dialog app-modal; there is no subset
+	// API on the surface.
+	PropertyPtr prop = NULL;
+	if (vWindowHasAtom(pWin, vAtom("_NET_WM_STATE"),
+			vAtom("_NET_WM_STATE_MODAL"))
+		&& dixLookupProperty(&prop, pWin, XA_WM_TRANSIENT_FOR, serverClient,
+			DixReadAccess) == Success && prop != NULL)
+		style->feel = B_MODAL_APP_WINDOW_FEEL;
+
+	// Motif: flags bit 1 selects decorations, 0 means none. Windows that
+	// draw their own title (client-side decorations) keep a thin native
+	// border so they stay movable and resizable from the edge.
+	bool clientDecorated = false;
+	CARD32 cards[16];
+	count = vReadCards(pWin, vAtom("_MOTIF_WM_HINTS"), cards, 16);
+	if (count >= 3 && (cards[0] & (1 << 1)) != 0 && cards[2] == 0)
+		clientDecorated = true;
+	// Border without title (MWM_DECOR_BORDER only): the client draws its
+	// own buttons, the tab keeps just the title.
+	bool ownButtons = count >= 3 && (cards[0] & (1 << 1)) != 0
+		&& cards[2] != 0 && (cards[2] & ((1 << 0) | (1 << 3))) == 0;
+
+	if (vReadCards(pWin, vAtom("_GTK_FRAME_EXTENTS"), cards, 16) >= 4)
+		clientDecorated = true;
+
+	bool fullscreen = vWindowHasAtom(pWin, vAtom("_NET_WM_STATE"),
+		vAtom("_NET_WM_STATE_FULLSCREEN"));
+
+	// WM_NORMAL_HINTS: PMinSize 1<<4, PMaxSize 1<<5.
+	count = vReadCards(pWin, XA_WM_NORMAL_HINTS, cards, 16);
+	if (count >= 9) {
+		if ((cards[0] & (1 << 4)) != 0) {
+			style->limits[0] = vMaxI(1, (int32)cards[5] - 1);
+			style->limits[2] = vMaxI(1, (int32)cards[6] - 1);
+		}
+		if ((cards[0] & (1 << 5)) != 0 && cards[7] > 0 && cards[8] > 0) {
+			style->limits[1] = vMaxI((int32)style->limits[0],
+				(int32)cards[7] - 1);
+			style->limits[3] = vMaxI((int32)style->limits[2],
+				(int32)cards[8] - 1);
+		}
+	}
+	if (style->limits[0] >= style->limits[1]
+		&& style->limits[2] >= style->limits[3]) {
+		style->resizable = false;
+		style->flags |= B_NOT_RESIZABLE | B_NOT_ZOOMABLE;
+	}
+
+	if (borderless || fullscreen)
+		style->look = B_NO_BORDER_WINDOW_LOOK;
+	else if (clientDecorated && style->look == B_TITLED_WINDOW_LOOK)
+		style->look = B_BORDERED_WINDOW_LOOK;
+	else if (ownButtons && style->look == B_TITLED_WINDOW_LOOK)
+		style->flags |= B_NOT_CLOSABLE | B_NOT_ZOOMABLE;
+
+	// Tab and border sizes of the native decorations.
+	if (style->look == B_BORDERED_WINDOW_LOOK) {
+		style->extents[0] = style->extents[1] = style->extents[2]
+			= style->extents[3] = 1;
+	}
+	if (style->look == B_TITLED_WINDOW_LOOK
+		|| style->look == B_FLOATING_WINDOW_LOOK) {
+		style->extents[0] = style->extents[1] = style->extents[3] = 5;
+		style->extents[2] = 27;
+	}
+}
