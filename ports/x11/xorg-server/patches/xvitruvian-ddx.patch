+
+static Bool
+vRandRInit(ScreenPtr pScreen)
+{
+	rrScrPrivPtr pScrPriv;
+	RRModePtr mode;
+	RRCrtcPtr crtc;
+	RROutputPtr output;
+	xRRModeInfo modeInfo;
+	char name[64];
+
+	if (!RRScreenInit(pScreen))
+		return FALSE;
+
+	pScrPriv = rrGetScrPriv(pScreen);
+	pScrPriv->rrGetInfo = NULL;
+	pScrPriv->rrCrtcSet = NULL;
+	pScrPriv->rrScreenSetSize = NULL;
+	pScrPriv->rrOutputValidateMode = NULL;
+	pScrPriv->rrModeDestroy = NULL;
+
+	RRScreenSetSizeRange(pScreen, 1, 1, 16384, 16384);
+
+	snprintf(name, sizeof(name), "%dx%d", pScreen->width, pScreen->height);
+	memset(&modeInfo, 0, sizeof(modeInfo));
+	modeInfo.width = pScreen->width;
+	modeInfo.height = pScreen->height;
+	modeInfo.nameLength = strlen(name);
+
+	mode = RRModeGet(&modeInfo, name);
+	if (mode == NULL)
+		return FALSE;
+
+	crtc = RRCrtcCreate(pScreen, NULL);
+	if (crtc == NULL)
+		return FALSE;
+	RRCrtcGammaSetSize(crtc, 256);
+
+	output = RROutputCreate(pScreen, "vitruvian", strlen("vitruvian"),
+		NULL);
+	if (output == NULL)
+		return FALSE;
+	if (!RROutputSetClones(output, NULL, 0))
+		return FALSE;
+	if (!RROutputSetModes(output, &mode, 1, 0))
+		return FALSE;
+	if (!RROutputSetCrtcs(output, &crtc, 1))
+		return FALSE;
+	if (!RROutputSetConnection(output, RR_Connected))
+		return FALSE;
+	RRCrtcNotify(crtc, mode, 0, 0, RR_Rotate_0, NULL, 1, &output);
+
+	return TRUE;
+}
+
+
+static int32
+vAppThread(void* data)
+{
+	XVApp* app = static_cast<XVApp*>(data);
+	app->LockLooper();
+	app->Run();
+	return 0;
+}
+
+
+extern "C" void
+InitOutput(ScreenInfo* screen_info, int argc, char** argv)
+{
+	static const PixmapFormatRec kFormats[] = {
+		{ 1, 1, BITMAP_SCANLINE_PAD },
+		{ 8, 8, BITMAP_SCANLINE_PAD },
+		{ 16, 16, BITMAP_SCANLINE_PAD },
+		{ 24, 32, BITMAP_SCANLINE_PAD },
+		{ 32, 32, BITMAP_SCANLINE_PAD }
+	};
+	// Software GLX through Mesa's swrast, as Xvfb does.
+	xorgGlxCreateVendor();
+
+	screen_info->imageByteOrder = IMAGE_BYTE_ORDER;
+	screen_info->bitmapScanlineUnit = BITMAP_SCANLINE_UNIT;
+	screen_info->bitmapScanlinePad = BITMAP_SCANLINE_PAD;
+	screen_info->bitmapBitOrder = BITMAP_BIT_ORDER;
+	screen_info->numPixmapFormats = sizeof(kFormats) / sizeof(kFormats[0]);
+	for (int i = 0; i < screen_info->numPixmapFormats; i++)
+		screen_info->formats[i] = kFormats[i];
+
+	if (gVApp == NULL) {
+		gVApp = new(std::nothrow) XVApp();
+		if (gVApp == NULL)
+			FatalError("XVitruvian: cannot create the application\n");
+		// Run() loops on the calling thread; X owns this one.
+		gVApp->Unlock();
+		thread_id thread = spawn_thread(vAppThread, "xv app",
+			B_DISPLAY_PRIORITY, gVApp);
+		if (thread < B_OK || resume_thread(thread) != B_OK)
+			FatalError("XVitruvian: cannot start the application\n");
+	}
+
+	if (gVWakeRead < 0) {
+		int fds[2];
+		if (pipe(fds) == 0) {
+			gVWakeRead = fds[0];
+			gVWakeWrite = fds[1];
+			fcntl(gVWakeRead, F_SETFL, O_NONBLOCK);
+			// A full pipe already holds a pending wakeup; window threads
+			// must never block here while holding their window lock.
+			fcntl(gVWakeWrite, F_SETFL, O_NONBLOCK);
+			SetNotifyFd(gVWakeRead, vNotifyRead, X_NOTIFY_READ, NULL);
+		}
+	}
+
+	if (sOpLock < B_OK)
+		sOpLock = create_sem(1, "xvitruvian ops");
+	if (sOps == NULL) {
+		sOpCapacity = 256;
+		sOps = (VOp*)calloc(sOpCapacity, sizeof(VOp));
+	}
+
+	if (-1 == AddScreen(vScreenInit, argc, argv))
+		FatalError("XVitruvian: cannot add screen\n");
+
+	gVScreen = screenInfo.screens[0];
+
+	if (!vRandRInit(gVScreen))
+		ErrorF("XVitruvian: RandR init failed\n");
+
+	if (!dixRegisterPrivateKey(gVWindowPrivateKey, PRIVATE_WINDOW, 0))
+		FatalError("XVitruvian: cannot register window private\n");
+
+	AddCallback(&PropertyStateCallback, vPropertyCallback, NULL);
+	AddCallback(&ClientStateCallback, vClientCallback, NULL);
+
+	if (sListenFd >= 0) {
+		ListenOnOpenFD(sListenFd, 0);
+		// Covers a connection that never completes setup.
+		sIdleTimer = TimerSet(sIdleTimer, 0, kIdleExitMs, vIdleExit, NULL);
+	}
+
+	char envBuffer[32];
+	snprintf(envBuffer, sizeof(envBuffer), "%d", 96);
+	setenv("Xft.dpi", envBuffer, 0);
+
+	ErrorF("XVitruvian: screen %dx%d on V\\OS app_server\n",
+		gVScreen->width, gVScreen->height);
+}
