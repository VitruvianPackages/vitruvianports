+
+static bool
+vReadSysfs(const char* path, char* value, size_t size)
+{
+	FILE* file = fopen(path, "r");
+	if (file == NULL)
+		return false;
+	bool ok = fgets(value, size, file) != NULL;
+	fclose(file);
+	return ok;
+}
+
+
+// Card of the first lit connector, else -1.
+static int
+vDisplayCard()
+{
+	DIR* dir = opendir("/sys/class/drm");
+	if (dir == NULL)
+		return -1;
+	int card = -1;
+	struct dirent* entry;
+	while (card < 0 && (entry = readdir(dir)) != NULL) {
+		int index;
+		if (sscanf(entry->d_name, "card%d-", &index) != 1)
+			continue;
+		char path[300];
+		char value[16];
+		snprintf(path, sizeof(path), "/sys/class/drm/%s/enabled",
+			entry->d_name);
+		if (vReadSysfs(path, value, sizeof(value))
+			&& strncmp(value, "enabled", 7) == 0)
+			card = index;
+	}
+	closedir(dir);
+	return card;
+}
+
+
+static bool
+vCardIsBootVga(int card)
+{
+	char path[64];
+	char value[8];
+	snprintf(path, sizeof(path), "/sys/class/drm/card%d/device/boot_vga",
+		card);
+	return vReadSysfs(path, value, sizeof(value)) && value[0] == '1';
+}
+
+
+static int
+vOpenRenderOf(int card)
+{
+	if (card < 0)
+		return -1;
+	char path[300];
+	snprintf(path, sizeof(path), "/sys/class/drm/card%d/device/drm", card);
+	DIR* dir = opendir(path);
+	if (dir == NULL)
+		return -1;
+	int fd = -1;
+	struct dirent* entry;
+	while (fd < 0 && (entry = readdir(dir)) != NULL) {
+		if (strncmp(entry->d_name, "renderD", 7) != 0)
+			continue;
+		snprintf(path, sizeof(path), "/dev/dri/%s", entry->d_name);
+		fd = open(path, O_RDWR | O_CLOEXEC);
+	}
+	closedir(dir);
+	return fd;
+}
+
+
+// The render node of the GPU that drives the display, so clients on that
+// GPU render in place and any other GPU is a cross-GPU (linear) client.
+static int
+vOpenRenderNode()
+{
+	int fd = vOpenRenderOf(vDisplayCard());
+	for (int card = 0; fd < 0 && card < 8; card++) {
+		if (vCardIsBootVga(card))
+			fd = vOpenRenderOf(card);
+	}
+	for (int card = 0; fd < 0 && card < 8; card++)
+		fd = vOpenRenderOf(card);
+	return fd;
+}
+
+
+// Kernel driver of an open render node.
+static void
+vNodeDriver(int fd, char* name, size_t size)
+{
+	name[0] = '\0';
+	struct stat st;
+	if (fstat(fd, &st) < 0)
+		return;
+	char path[128];
+	char link[128];
+	snprintf(path, sizeof(path), "/sys/dev/char/%u:%u/device/driver",
+		major(st.st_rdev), minor(st.st_rdev));
+	ssize_t length = readlink(path, link, sizeof(link) - 1);
+	if (length <= 0)
+		return;
+	link[length] = '\0';
+	const char* base = strrchr(link, '/');
+	snprintf(name, size, "%s", base != NULL ? base + 1 : link);
+}
+
+
+// Whether this kernel passes descriptors through ports.
+static bool
+vPortsCarryFds()
+{
+	port_id port = create_port(1, "xvitr fd probe");
+	if (port < 0)
+		return false;
+
+	int fd = open("/dev/null", O_RDONLY | O_CLOEXEC);
+	int32 code = 1;
+	bool ok = fd >= 0 && write_port_fds(port, 1, &code, sizeof(code), &fd, 1,
+		B_RELATIVE_TIMEOUT, 0) == B_OK;
+	if (ok) {
+		int received[PORT_MAX_FDS];
+		int32 count = PORT_MAX_FDS;
+		ok = read_port_fds(port, &code, &code, sizeof(code), received, &count,
+			B_RELATIVE_TIMEOUT, 0) >= 0 && count == 1;
+		if (ok)
+			close(received[0]);
+	}
+	if (fd >= 0)
+		close(fd);
+	delete_port(port);
+	return ok;
+}
+
+
+static dri3_screen_info_rec sDri3Info;
+
+static void
+vInitDri3(ScreenPtr screen)
+{
+	sRenderFd = vOpenRenderNode();
+	if (sRenderFd < 0) {
+		LogMessage(X_INFO, "vitruvian: no render node, DRI3 disabled\n");
+		return;
+	}
+
+	if (!dixRegisterPrivateKey(&sDmabufKey, PRIVATE_PIXMAP, sizeof(VDmabuf))
+		|| !RegisterBlockAndWakeupHandlers(vDmabufBlock, vDmabufWakeup,
+			NULL)) {
+		close(sRenderFd);
+		sRenderFd = -1;
+		return;
+	}
+
+	vNodeDriver(sRenderFd, sRenderDriver, sizeof(sRenderDriver));
+	const char* noFlip = getenv("XVITR_NO_FLIP");
+	sFlipEnabled = (noFlip == NULL || atoi(noFlip) == 0) && vPortsCarryFds();
+
+	// FenceFromFD needs the shm fence screen funcs, else BadMatch.
+	if (!miSyncShmScreenInit(screen)) {
+		close(sRenderFd);
+		sRenderFd = -1;
+		return;
+	}
+
+	sDri3Info.version = DRI3_SCREEN_INFO_VERSION;
+	sDri3Info.open = vOpen;
+	sDri3Info.open_client = vOpenClient;
+	sDri3Info.pixmap_from_fds = vPixmapFromFds;
+	sDri3Info.fds_from_pixmap = vFdsFromPixmap;
+	sDri3Info.get_formats = vGetFormats;
+	sDri3Info.get_modifiers = vGetModifiers;
+	sDri3Info.get_drawable_modifiers = vGetDrawableModifiers;
+
+	if (!dri3_screen_init(screen, &sDri3Info)) {
+		close(sRenderFd);
+		sRenderFd = -1;
+		return;
+	}
+
+	sDestroyPixmap = screen->DestroyPixmap;
+	screen->DestroyPixmap = vDestroyPixmap;
+}
+
+#endif	// DRI3
+
+
+void
+VInitDri3Present(ScreenPtr screen)
+{
+#ifdef DRI3
+	vInitDri3(screen);
+#endif
+#ifdef PRESENT
+	if (!present_screen_init(screen, NULL))
+		LogMessage(X_WARNING, "vitruvian: Present init failed\n");
+#ifdef DRI3
+	else if (sRenderFd >= 0 && sFlipEnabled)
+		present_register_window_flip(vWindowFlip);
+#endif
+#endif
+}
