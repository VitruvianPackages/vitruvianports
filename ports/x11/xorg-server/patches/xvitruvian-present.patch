Description: Present: let the DDX show a pixmap on a window without the copy.
Author: Numerio <b.vitruvio@gmail.com>
Forwarded: not-needed
---
diff --git a/present/present.h b/present/present.h
index d41b360..73ef6dd 100644
--- a/present/present.h
+++ b/present/present.h
@@ -159,6 +159,27 @@ typedef void (*present_complete_notify_proc)(WindowPtr window,
 extern _X_EXPORT void
 present_register_complete_notify(present_complete_notify_proc proc);
 
+struct present_fence;
+
+/* Lets the DDX show 'pixmap' on 'window' without the copy. When it returns
+ * TRUE it owns the pixmap reference and the idle fence until it calls
+ * present_window_flip_done().
+ */
+typedef Bool (*present_window_flip_proc)(WindowPtr window, PixmapPtr pixmap,
+                                         RegionPtr update, int16_t x_off,
+                                         int16_t y_off, CARD32 serial,
+                                         struct present_fence *idle_fence);
+
+extern _X_EXPORT void
+present_register_window_flip(present_window_flip_proc proc);
+
+/* The pixmap is no longer in use: tells the client and drops the references
+ * taken for present_window_flip_proc. 'window' may be NULL.
+ */
+extern _X_EXPORT void
+present_window_flip_done(PixmapPtr pixmap, WindowPtr window, CARD32 serial,
+                         struct present_fence *idle_fence);
+
 extern _X_EXPORT Bool
 present_can_window_flip(WindowPtr window);
 
diff --git a/present/present_execute.c b/present/present_execute.c
index 68a5878..34c2f78 100644
--- a/present/present_execute.c
+++ b/present/present_execute.c
@@ -61,6 +61,23 @@ present_execute_wait(present_vblank_ptr vblank, uint64_t crtc_msc)
     return FALSE;
 }
 
+static present_window_flip_proc window_flip;
+
+void
+present_register_window_flip(present_window_flip_proc proc)
+{
+    window_flip = proc;
+}
+
+void
+present_window_flip_done(PixmapPtr pixmap, WindowPtr window, CARD32 serial,
+                         struct present_fence *idle_fence)
+{
+    present_pixmap_idle(pixmap, window, serial, idle_fence);
+    present_fence_destroy(idle_fence);
+    dixDestroyPixmap(pixmap, pixmap->drawable.id);
+}
+
 void
 present_execute_copy(present_vblank_ptr vblank, uint64_t crtc_msc)
 {
@@ -79,6 +96,15 @@ present_execute_copy(present_vblank_ptr vblank, uint64_t crtc_msc)
         return;
     }
 
+    if (window_flip && vblank->pixmap &&
+        window_flip(window, vblank->pixmap, vblank->update, vblank->x_off,
+                    vblank->y_off, vblank->serial, vblank->idle_fence)) {
+        /* The DDX idles the pixmap and drops our references later. */
+        vblank->pixmap->refcnt++;
+        vblank->idle_fence = NULL;
+        return;
+    }
+
     present_copy_region(&window->drawable, vblank->pixmap, vblank->update, vblank->x_off, vblank->y_off);
 
     /* present_copy_region sticks the region into a scratch GC,
