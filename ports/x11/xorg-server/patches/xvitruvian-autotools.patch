Description: XVitruvian: autotools build hooks (--enable-vitruvian).
Author: Numerio <b.vitruvio@gmail.com>
Forwarded: not-needed
---
diff --git a/configure.ac b/configure.ac
index 109fdec..ca69a21 100644
--- a/configure.ac
+++ b/configure.ac
@@ -73,6 +73,7 @@ AC_CONFIG_HEADERS(include/version-config.h)
 
 AM_PROG_AS
 AC_PROG_LN_S
+AC_PROG_CXX
 LT_PREREQ([2.2])
 LT_INIT([disable-static win32-dll])
 PKG_PROG_PKG_CONFIG
@@ -580,6 +581,7 @@ AC_ARG_ENABLE(suid-wrapper, AS_HELP_STRING([--enable-suid-wrapper], [Build suid-
 dnl DDXes.
 AC_ARG_ENABLE(xorg,    	      AS_HELP_STRING([--enable-xorg], [Build Xorg server (default: auto)]), [XORG=$enableval], [XORG=auto])
 AC_ARG_ENABLE(xvfb,    	      AS_HELP_STRING([--enable-xvfb], [Build Xvfb server (default: yes)]), [XVFB=$enableval], [XVFB=yes])
+AC_ARG_ENABLE(vitruvian,       AS_HELP_STRING([--enable-vitruvian], [Build XVitruvian rootless server for V\\OS (default: no)]), [VITRUVIAN=$enableval], [VITRUVIAN=no])
 AC_ARG_ENABLE(xnest,   	      AS_HELP_STRING([--enable-xnest], [Build Xnest server (default: auto)]), [XNEST=$enableval], [XNEST=auto])
 AC_ARG_ENABLE(xquartz,        AS_HELP_STRING([--enable-xquartz], [Build Xquartz server for OS-X (default: auto)]), [XQUARTZ=$enableval], [XQUARTZ=auto])
 AC_ARG_ENABLE(standalone-xpbproxy, AS_HELP_STRING([--enable-standalone-xpbproxy], [Build a standalone xpbproxy (in addition to the one integrated into Xquartz as a separate thread) (default: no)]), [STANDALONE_XPBPROXY=$enableval], [STANDALONE_XPBPROXY=no])
@@ -1731,6 +1733,20 @@ dnl ---------------------------------------------------------------------------
 dnl DDX section.
 dnl ---------------------------------------------------------------------------
 
+dnl XVitruvian DDX
+
+AC_MSG_CHECKING([whether to build XVitruvian DDX])
+AC_MSG_RESULT([$VITRUVIAN])
+AM_CONDITIONAL(VITRUVIAN, [test "x$VITRUVIAN" = xyes])
+
+if test "x$VITRUVIAN" = xyes; then
+	PKG_CHECK_MODULES([VITRUVIAN], [vos])
+	XVITR_LIBS="$FB_LIB $FIXES_LIB $XEXT_LIB $DBE_LIB $RECORD_LIB $GLX_LIBS $RANDR_LIB $RENDER_LIB $DAMAGE_LIB $DRI3_LIB $PRESENT_LIB $MIEXT_SYNC_LIB $MIEXT_DAMAGE_LIB $MIEXT_SHADOW_LIB $XI_LIB $XKB_LIB $XKB_STUB_LIB $COMPOSITE_LIB"
+	XVITR_SYS_LIBS="$GLX_SYS_LIBS"
+	AC_SUBST([XVITR_LIBS])
+	AC_SUBST([XVITR_SYS_LIBS])
+fi
+
 dnl Xvfb DDX
 
 AC_MSG_CHECKING([whether to build Xvfb DDX])
@@ -2369,6 +2385,7 @@ hw/xfree86/utils/Makefile
 hw/xfree86/utils/man/Makefile
 hw/xfree86/utils/gtf/Makefile
 hw/vfb/Makefile
+hw/vitruvian/Makefile
 hw/vfb/man/Makefile
 hw/xnest/Makefile
 hw/xnest/man/Makefile
diff --git a/hw/Makefile.am b/hw/Makefile.am
index 1749018..06c1766 100644
--- a/hw/Makefile.am
+++ b/hw/Makefile.am
@@ -6,6 +6,10 @@ if XVFB
 XVFB_SUBDIRS = vfb
 endif
 
+if VITRUVIAN
+VITRUVIAN_SUBDIRS = vitruvian
+endif
+
 if XNEST
 XNEST_SUBDIRS = xnest
 endif
@@ -26,11 +30,12 @@ SUBDIRS =			\
 	$(XORG_SUBDIRS)		\
 	$(XWIN_SUBDIRS)		\
 	$(XVFB_SUBDIRS)		\
+	$(VITRUVIAN_SUBDIRS)	\
 	$(XNEST_SUBDIRS)	\
 	$(KDRIVE_SUBDIRS)	\
 	$(XQUARTZ_SUBDIRS)
 
-DIST_SUBDIRS = xfree86 vfb xnest xwin xquartz kdrive
+DIST_SUBDIRS = xfree86 vfb vitruvian xnest xwin xquartz kdrive
 
 relink:
 	$(AM_V_at)for i in $(SUBDIRS) ; do $(MAKE) -C $$i relink || exit 1 ; done
diff --git a/hw/vitruvian/Makefile.am b/hw/vitruvian/Makefile.am
new file mode 100644
index 0000000..14c2656
--- /dev/null
+++ b/hw/vitruvian/Makefile.am
@@ -0,0 +1,46 @@
+bin_PROGRAMS = Xvitr
+
+dist_bin_SCRIPTS = xvitruvian-session.sh
+
+# The X.Org headers use and/xor as parameter names, which C++ alternative
+# operator tokens would reject.
+AM_CPPFLAGS = -DHAVE_DIX_CONFIG_H \
+	-I$(top_srcdir)/composite \
+	-I/system/develop/headers/private \
+	-I/system/develop/headers/private/app \
+	-I/system/develop/headers/private/input \
+	-I/system/develop/headers/private/interface \
+	-I/system/develop/headers/private/shared \
+	-I/system/develop/headers/private/storage \
+	-I/system/develop/headers/private/system
+
+AM_CFLAGS = $(DIX_CFLAGS)
+
+AM_CXXFLAGS = $(DIX_CFLAGS) $(VITRUVIAN_CFLAGS) -fno-operator-names
+
+Xvitr_SOURCES = \
+	vClipboard.cpp \
+	vDnd.cpp \
+	vInit.cpp \
+	vInput.cpp \
+	vSettings.cpp \
+	vPriv.h \
+	vWindow.cpp \
+	$(top_srcdir)/mi/miinitext.c \
+	$(top_srcdir)/mi/miinitext.h
+
+XVITR_DEPS = \
+	@XVITR_LIBS@ \
+	$(MAIN_LIB) \
+	$(XSERVER_LIBS) \
+	$(top_builddir)/Xi/libXistubs.la
+
+Xvitr_LDADD = $(XVITR_DEPS) @XVITR_SYS_LIBS@ $(XSERVER_SYS_LIBS) $(VITRUVIAN_LIBS) \
+	-loutputaddon
+Xvitr_DEPENDENCIES = $(XVITR_DEPS)
+Xvitr_LDFLAGS = $(LD_EXPORT_SYMBOLS_FLAG)
+
+relink:
+	$(AM_V_at)rm -f Xvitr$(EXEEXT) && $(MAKE) Xvitr$(EXEEXT)
+
+EXTRA_DIST = meson.build
