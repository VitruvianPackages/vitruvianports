diff -urN a/debian/xvitruvian-launcher.postinst b/debian/xvitruvian-launcher.postinst
--- a/debian/xvitruvian-launcher.postinst
+++ b/debian/xvitruvian-launcher.postinst
@@ -0,0 +1,20 @@
+#!/bin/sh
+set -e
+
+#DEBHELPER#
+
+case "$1" in
+configure)
+	# The sockets.target.wants link only takes effect at the next login: start the
+	# socket for sessions that are already running, so a freshly installed X app
+	# can connect right away. Best effort, there may be no user manager (chroot, image build).
+	if [ -d /run/systemd/system ] && command -v loginctl >/dev/null 2>&1; then
+		for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
+			systemctl --user -M "$uid@" daemon-reload >/dev/null 2>&1 || true
+			systemctl --user -M "$uid@" start xvitruvian.socket >/dev/null 2>&1 || true
+		done
+	fi
+	;;
+esac
+
+exit 0
diff -urN a/debian/xvitruvian.service b/debian/xvitruvian.service
--- a/debian/xvitruvian.service
+++ b/debian/xvitruvian.service
@@ -0,0 +1,9 @@
+[Unit]
+Description=Xvitr X server for display :0
+Requires=xvitruvian.socket
+After=xvitruvian.socket
+
+[Service]
+# Exits on its own after a minute with no clients; the socket restarts it.
+ExecStart=/usr/bin/Xvitr :0 -listenfd 3 -nolisten tcp -noreset
+Restart=no
diff -urN a/debian/xvitruvian.socket b/debian/xvitruvian.socket
--- a/debian/xvitruvian.socket
+++ b/debian/xvitruvian.socket
@@ -0,0 +1,9 @@
+[Unit]
+Description=X display :0 (Xvitr, started on demand)
+
+[Socket]
+ListenStream=/tmp/.X11-unix/X0
+SocketMode=0600
+
+[Install]
+WantedBy=sockets.target
